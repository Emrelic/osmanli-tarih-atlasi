+    print(f"  🧩 KOMŞU-KUR-BÖL: AÇIK · kip {_kkb_kip} · pay {_kkb_pay:.2f}° · "
+          f"{len(_KKB_NOKTA_GUN)} nokta · {_kkb_cift} (nokta, gün) erişim çifti · "
+          f"{time.time() - _t_kkb:.1f} sn")
