+def _ince_merkez():
+    """etiket (tohum sırası) → tohum hücresi (j, i) — oy eşitliğini bozmak için."""
+    global _INCE_MERKEZ
+    if _INCE_MERKEZ is None:
+        _INCE_MERKEZ = {ix: divmod(h, _kvnx) for h, idxs in _kvtohum.items() for ix in idxs}
+    return _INCE_MERKEZ
+
+
+def _ince_kor():
+    """Tohum hücreleri (asla değişmez) — bir kez kurulur."""
+    global _INCE_KOR
+    if _INCE_KOR is None:
+        _k = _np.zeros((_kvny, _kvnx), dtype=bool)
+        _k.flat[_np.array(sorted(_kvtohum), dtype=_np.int64)] = True
+        _INCE_KOR = _k
+    return _INCE_KOR
+
+
+def _ince_epok(D, yeni):
+    """Epok onarımının sonucu üzerinde kırpma — yalnız ölü tohum hücreleri (D) değişir."""
+    _nyy, _nxx = _YR_SAHIP.shape
+    g = INCE_CIKINTI + 4
+    _ri, _ci = D // _nxx, D % _nxx
