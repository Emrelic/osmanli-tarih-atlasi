+def _yaka_kilidi_kenar(tohum, yerler, parcalar, siniflar, gecitler, tablo, bedel):
+    """(A) Tohum hücresinden çıkan adımların nehir geçişini TOHUMUN GERÇEK
+    KOORDİNATINDAN yeniden ölçer. Döner {anahtar: km-eşdeğeri} — yalnız geçiş
+    hükmü (var/yok) merkez ölçüsünden FARKLI olan kenarlar; 0.0 = bedel kalkar.
+    `bedel`i DEĞİŞTİRMEZ. Kaydırılmış tohum (deniz hücresinden en yakın karaya)
+    kilide girmez: gerçek koordinatı hücresinin içinde değildir."""
+    import numpy as _npy
+    _hatlar, _hs = [], []
+    for g, s in zip(parcalar, siniflar):
+        for ln in shapely.get_parts(g):
+            if ln.geom_type in ("LineString", "LinearRing") and not ln.is_empty:
+                _hatlar.append(ln); _hs.append(s)
+    _anah, _segP, _segC = [], [], []
+    for h in sorted(tohum):
+        y = yerler[tohum[h][0]]
+        j, i = divmod(h, _kvnx)
+        if (int((y["lon"] - _kvx0) / KV_ADIM) != i
+                or int((y["lat"] - _kvy0) / KV_ADIM) != j):
+            continue
+        _YAKA_SAYAC["tohum_hucre"] += 1
+        cx = _kvx0 + (i + 0.5) * KV_ADIM
+        cy = _kvy0 + (j + 0.5) * KV_ADIM
+        for yi, (di, dj) in enumerate(_KV_YON):
+            a, b = i + di, j + dj
+            if not (0 <= a < _kvnx and 0 <= b < _kvny) or not _kvkara[b * _kvnx + a]:
+                continue
+            if YURUYUS_16 and not _kv_ara_kara(i, j, di, dj):
+                continue
+            _anah.append(h * _KV_YS + yi)
+            _segP.append(((y["lon"], y["lat"]), (cx + di * KV_ADIM, cy + dj * KV_ADIM)))
+            _segC.append(((cx, cy), (cx + di * KV_ADIM, cy + dj * KV_ADIM)))
+    _YAKA_SAYAC["aday_kenar"] = len(_anah)
+    out = {}
+    if not _anah or not _hatlar:
+        return out
+    _ag = STRtree(_hatlar)
+    _kesP, _kesC = {}, set()
+    _si, _hi = _ag.query(shapely.linestrings(_npy.array(_segP, dtype=float)),
+                         predicate="intersects")
+    for s_, h_ in zip(_si.tolist(), _hi.tolist()):
+        _kesP[s_] = min(_hs[h_], _kesP.get(s_, 9))
+    _si, _ = _ag.query(shapely.linestrings(_npy.array(_segC, dtype=float)),
+                       predicate="intersects")
+    _kesC = set(_si.tolist())
+    _gag = (STRtree(shapely.points([g[0] for g in gecitler], [g[1] for g in gecitler]))
+            if gecitler else None)
+    for s_, k in enumerate(_anah):
+        p_kes, c_kes = s_ in _kesP, s_ in _kesC
+        if p_kes == c_kes:
+            continue                    # yaka hükmü aynı ⇒ eski bedel KALIR
+        if not p_kes:
+            out[k] = 0.0                # tohum bu kenarın yakasında: geçiş YOK
+            continue
+        saat = tablo["gecitsiz"][_kesP[s_]]
+        if _gag is not None:
+            (x0, y0), (x1, y1) = _segP[s_]
+            mx, my = (x0 + x1) / 2.0, (y0 + y1) / 2.0
+            for g_ in _gag.query(shapely.points(mx, my), predicate="dwithin",
+                                 distance=0.5).tolist():
+                glo, gla, tur, etki, _ = gecitler[g_]
+                tb = tablo.get(tur)
+                if tb is not None and tb < saat and girdi.km(my, mx, gla, glo) <= etki:
+                    saat = tb
+        out[k] = saat * NEHIR_KM_SAAT if saat > 0.0 else 0.0
+    return out
+
