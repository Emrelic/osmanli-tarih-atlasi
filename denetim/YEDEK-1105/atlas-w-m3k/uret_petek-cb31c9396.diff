+    c0, c1 = max(0, int(_ci.min()) - g), min(_nxx, int(_ci.max()) + g + 1)
+    W = _YR_SAHIP[r0:r1, c0:c1].copy()
+    W[_ri - r0, _ci - c0] = yeni
+    deg = _np.zeros(W.shape, dtype=bool)
+    deg[_ri - r0, _ci - c0] = yeni >= 0
+    W2, _ = _ince_cikinti_kirp(W, deg, _ince_kor()[r0:r1, c0:c1], INCE_CIKINTI,
+                               _ince_engel, ofs=(r0, c0),
+                               etiketler=set(yeni[yeni >= 0].tolist()), merkez=_ince_merkez())
+    return W2[_ri - r0, _ci - c0].astype(_np.int32)
+
