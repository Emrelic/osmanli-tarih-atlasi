+def _ince_engel(jc, ic_, jn, in_):
+    """n=(jn,in_) komşusundan c=(jc,ic_) hücresine devir: aradaki adım (iki yönden
+    biri) nehir bedelli ya da boğaz yasaklıysa YASAK."""
+    di, dj = ic_ - in_, jc - jn
+    if (di, dj) not in _KV_YON or (-di, -dj) not in _KV_YON:
+        return False
+    hn, hc = jn * _kvnx + in_, jc * _kvnx + ic_
+    for kk in (hn * _KV_YS + _KV_YON.index((di, dj)), hc * _KV_YS + _KV_YON.index((-di, -dj))):
+        if kk in _KVSU:
+            return True
+        if _KVNEHIR is not None and _KVNEHIR[0].get(kk, 0.0) > 0.0:
+            return True
+    return False
+
