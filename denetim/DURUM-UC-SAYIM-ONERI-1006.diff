+# W41 (D265 kural 3): sayacın HESAPLADIĞI her sayı alanı satırda BASILIR.
+#   Sayaç alanları: tamsayı olanlar, `dosya` hariç (dosya sayısı tutarlılık
+#   denetimidir, tablo hücresi değil). Alan adı eklenirse bu soru öter.
+_basilan = {"madde": "**%d** madde", "alt_adim": "(alt adım: %d)",
+            "duygu": "%d duygu", "yer_id": "%d `yer_id`",
+            "yer_id_bos": "(boş yer_id: %d)", "vefat_id": "%d `vefat_id`"}
+_hesap = {a for a, v in T.items() if isinstance(v, int) and a != "dosya"}
+sina("W41 hesaplanan alan kümesi = basılan alan kümesi",
