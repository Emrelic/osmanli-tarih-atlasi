+# -*- coding: utf-8 -*-
+"""SAHİPLİK HÜKÜM LİSTESİ — TEK OKUYUCU (SAHIPLIK-KAPSAM-1010 · ⓑ/ⓐ).
+
+`denetim/SAHIPLIK-HUKUM-LISTESI.json` — `_sahiplik_uygula.py`nin KASITLI (hükümlü) atlamaları.
+İki tüketici AYNI okuyucuyu kullanır (bir bilgi iki yerde ayrıştırılınca ayrışır, §11):
+  · `arac/_sahiplik_uygula.py` — atlamayı `hukumlu:<kova>` yapar; ÖLÜ satırı GERÇEK koşuyla ölçer
+  · `arac/denetle.py`          — yalnız DOSYAYI denetler (dayanak · dayanaksız · ucuz ölü), araç KOŞMAZ
+
+Satır: {"yama": "yer_yama_x.js", "ad": "Kayıt", "kova": "kapsam-daraldi",
+        "dayanak": "<SHA> · <yol>[:<bölüm>]", "gerekce": "kısa"}
+DAYANAK dilbilgisi: ` · ` ile ayrılmış parçalar. Bir parça ya bir COMMIT SHA'sıdır (7-40 onaltılık,
+  `git cat-file -e <sha>^{commit}` çözülmeli) ya da `denetim|dersler|oturumlar|arac|data/…` ile başlayan
+  bir YOL (dosya VAR olmalı; `:bölüm` verildiyse bölüm metni dosyada GEÇMELİ). Başka parça (düz metin)
+  sayılmaz. Geçerli satır: en az BİR parça çözülür, HİÇBİR SHA/yol parçası çözülmeden kalmaz.
+  ⇒ "koordinatör hükmü bekleniyor" gibi bir dayanak REDDEDİLİR — dayanaksız istisna, istisna değildir.
+"""
+import io
+import json
+import os
+import re
+import subprocess
+
+VARSAYILAN = os.path.join("denetim", "SAHIPLIK-HUKUM-LISTESI.json")
+ALANLAR = ("yama", "ad", "kova", "dayanak", "gerekce")
+_SHA_RX = re.compile(r"^[0-9a-f]{7,40}$")
+_YOL_RX = re.compile(r"^((?:denetim|dersler|oturumlar|arac|data)/[^:]+?)(?::(.+))?$")
+
+
+def dayanak_coz(dayanak, kok):
+    """([çözülen parça], [çözülmeyen parça + sebep])."""
+    tamam, bozuk = [], []
+    for p in [x.strip() for x in (dayanak or "").split("·")]:
+        if not p:
+            continue
+        if _SHA_RX.match(p):
+            q = subprocess.run(["git", "-C", kok, "cat-file", "-e", "%s^{commit}" % p], capture_output=True)
+            (tamam if q.returncode == 0 else bozuk).append(p if q.returncode == 0 else "%s (commit YOK)" % p)
+            continue
+        m = _YOL_RX.match(p)
+        if not m:
+            continue                                   # düz metin: dayanak SAYILMAZ
+        yol, bolum = m.group(1).strip(), (m.group(2) or "").strip()
+        tam = os.path.join(kok, yol)
+        if not os.path.isfile(tam):
+            bozuk.append("%s (dosya YOK)" % yol)
+        elif bolum and bolum not in io.open(tam, encoding="utf-8", errors="replace").read():
+            bozuk.append("%s:%s (bölüm dosyada GEÇMİYOR)" % (yol, bolum))
+        else:
+            tamam.append(p)
+    return tamam, bozuk
+
+
+def oku(yol, kok):
+    """None (dosya YOK) ya da (geçerli_satırlar, reddedilen[(etiket, sebep)]). Satıra `_no` eklenir."""
+    if not os.path.exists(yol):
+        return None
+    red, gecerli = [], []
+    try:
+        j = json.load(io.open(yol, encoding="utf-8"))
+        liste = j.get("hukumler") if isinstance(j, dict) else None
+        if not isinstance(liste, list):
+            raise ValueError("`hukumler` listesi yok")
+    except ValueError as e:
+        return [], [("<dosya>", "hüküm listesi OKUNAMADI: %s" % e)]
+    for n, h in enumerate(liste, 1):
+        if not isinstance(h, dict):
+            red.append(("#%d" % n, "satır bir nesne değil"))
+            continue
+        eksik = [k for k in ALANLAR if not (isinstance(h.get(k), str) and h[k].strip())]
+        if eksik:
+            red.append(("#%d %s" % (n, h.get("ad", "?")), "alan EKSİK/BOŞ: %s" % ", ".join(eksik)))
+            continue
+        ok, boz = dayanak_coz(h["dayanak"], kok)
+        if boz or not ok:
+            red.append(("#%d %s" % (n, h["ad"]), "DAYANAK %s: %r" % (
+                "çözülmüyor — " + "; ".join(boz) if boz else "YOK (çözülen SHA ya da dosya yok)", h["dayanak"])))
+            continue
+        gecerli.append(dict(h, _no=n))
+    return gecerli, red
+
+
+_NODE = r"""
+global.window = {};
+const fs = require('fs');
+eval(fs.readFileSync(process.argv[1], 'utf8'));
+const out = [];
+for (const k of Object.keys(window)) for (const r of (Array.isArray(window[k]) ? window[k] : []))
+  if (r && r.ad !== undefined) out.push(r);
+process.stdout.write(JSON.stringify(out));
+"""
+UZERINE_YAZAN = ("d", "s", "v", "isg", "m")
+
+
+def _kanon(v):
+    return json.dumps(v, sort_keys=True, ensure_ascii=False, separators=(",", ":"))
+
+
+def olu_ucuz(satirlar, veri_dizini, bugun):
+    """UCUZ ölü-satır ölçümü (denetle.py için — `_sahiplik_uygula` KOŞMAZ).
+
+    `bugun`: {ad: kayıt} (motorun okuduğu hâl). Döner: [(satır, sebep)] ölü · [(satır, sebep)] ölçülemedi.
+    Ölçüt: ① yama dosyası YOK · ② kayıt yamada YOK · ③ yama İNMİŞ = yamanın üzerine yazan her alanı
+    (d·s·v·isg·m) bugünkü kayıtla BİREBİR aynı (yazacak bir şeyi kalmamış ⇒ atlanamaz ⇒ satır ölü).
+    ⚠️ "o kova ile hâlâ atlanıyor mu" sorusunun TAMAMI pahalıdır (aracın kendisi); burada yalnız bu üçü."""
+    olu, olcmedi, onbellek = [], [], {}
+    for h in satirlar:
+        yol = os.path.join(veri_dizini, h["yama"])
+        if not os.path.isfile(yol):
+            olu.append((h, "yama dosyası data/'da YOK"))
+            continue
+        if yol not in onbellek:
+            p = subprocess.run(["node", "-e", _NODE, yol], capture_output=True)
+            onbellek[yol] = json.loads(p.stdout.decode("utf-8")) if p.returncode == 0 else None
+        kayitlar = onbellek[yol]
+        if kayitlar is None:
+            olcmedi.append((h, "yama dosyası node ile okunamadı"))
+            continue
+        r = [x for x in kayitlar if x.get("ad") == h["ad"]]
+        if not r:
+            olu.append((h, "kayıt yamada YOK"))
+            continue
+        b = bugun.get(h["ad"])
+        if b is None:
+            continue                                     # veride yok: inmiş olamaz (atlanma sebebi başka)
+        alanlar = [a for a in UZERINE_YAZAN if any(a in x for x in r)]
+        if alanlar and all(_kanon(x[a]) == _kanon(b.get(a)) for x in r for a in alanlar if a in x):
+            olu.append((h, "yama İNMİŞ — üzerine yazan alanları (%s) bugünkü kayıtla birebir aynı"
+                        % ",".join(alanlar)))
+    return olu, olcmedi
