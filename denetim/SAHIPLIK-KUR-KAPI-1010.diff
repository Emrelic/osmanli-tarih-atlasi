+# -*- coding: utf-8 -*-
+"""ARAC-SAHIPLIK-KUR-KAPI-SINAV-1010 — `_sahiplik_uygula.py` KUR KAPISI, İKİ YÖNDE.
+
+    py denetim/ARAC-SAHIPLIK-KUR-KAPI-SINAV-1010.py [--gercek-yok]
+
+Gerçek ağaçta HİÇBİR ŞEY yazmaz. Sentetik kollar geçici `git init` deposunda, `--yaz` YALNIZ orada.
+"ESKİ" = origin/main'deki araç (kur kapısı yok). Kapı: yazılacak (bugün AYNEN durmayan) d·s·v·isg dönemi
+`gun.gun(f) < gun.gun(kur)` ⇒ kayıt YAZILMAZ, kova `kur-oncesi`, çıkış 2; ayrıştırılamazsa `kur-olculemedi`, 3;
+`devir_beyani` muafiyeti `denetle.degismez5`in KENDİSİNDEN.
+
+SENTETİK                                                         beklenen
+  U1  Mergen eşi, yama {d,f,t}: qing 1636 < kur 1686               2 · KUR-ONCESI · dosya aynı (--yaz)
+  U2  aynı yama {f,t,d}                                           2 · aynı (sıradan BAĞIMSIZ)
+  U3  kur -2999 / f -3100                                         2 (yazmaz)
+  U4  kur -3100 / f -2999 (genişletme)                           0 · YAZILDI
+  U5  kur 0000 / f -0001                                          2 (yazmaz)
+  U6  f == kur                                                    0 · YAZILDI
+  U7  devir_beyani + kur öncesi dönemlerde kaynak YOK (iki kilit) 0 · YAZILDI · "KUR MUAF" satırı
+  U8  devir_beyani AMA kur öncesi bir dönem kaynaklı (kilit b)    2 (muafiyet YOK)
+  U9  bozuk kur (1686-13-01)                                      3 · KUR-OLCULEMEDI
+  U10 bozuk f (yeni dönemde 1700-02-30)                           3 · KUR-OLCULEMEDI
+  U11 D5 tolerans bandı (kur 1593, yeni f 1592-06-01)             2 · "Değişmez 5 bu farkta karar VERMİYOR"
+  U12 bugün AYNEN duran erken dönem + yeni geç dönem              0 (yazıcı doğurmuyor, sorulmaz)
+  U13 yama BOŞ kur'u dolduruyor, mevcut dönem ondan erken         2 (kur değişince bütün dönemler)
+  U14 hızlı kip JSON: kur-oncesi `listesiz_atlama`da, bozuk kur `listesiz_atlama`da (kod 3 kovası)
+GERÇEK (yalnız KURU, hızlı kip):
+  G1  denetle evreni (yer_yama* − Z5 karantinası): kur-oncesi ADIYLA basılır (ölçüm, sayı bilgi)
+  G2  Z5 v4 (+SESSIZ-7 v2) varsa: kur-oncesi 0, çıkış 0 (v4'ü durdurmuyor)
+SON  C:\\atlas ve C:\\atlas-umit `git status --short` sınavdan önce ve sonra AYNI.
+Çıkış: 0 hepsi geçti · 1 en az biri kaldı.
+"""
+import hashlib
+import io
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+
+if hasattr(sys.stdout, "reconfigure"):
+    sys.stdout.reconfigure(encoding="utf-8", errors="replace", line_buffering=True)
+
+KOK = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+ARAC = ["_sahiplik_uygula.py", "_bayat_yama_kapi.py", "girdi.py", "girdi_listesi.py", "_hukum_listesi.py",
+        "gun.py", "denetle.py", "uret_petek.py"]
+IZLENEN = [r"C:\atlas", r"C:\atlas-umit"]
+GERCEK = "--gercek-yok" not in sys.argv
+sys.path.insert(0, os.path.join(KOK, "arac"))
+import girdi_listesi  # noqa: E402
+
+HEDEF = os.path.basename(girdi_listesi.GIRDI_DOSYALARI[0])
+sonuc = []
+
+
+def sina(ad, kosul, ayrinti=""):
+    sonuc.append((ad, bool(kosul)))
+    print("%s %s %s" % ("✓" if kosul else "✗ BAŞARISIZ", ad, ayrinti))
+
+
+def git(d, *a):
+    return subprocess.run(["git", "-c", "user.name=sinav", "-c", "user.email=s@s", "-c", "core.autocrlf=false"]
+                          + list(a), cwd=d, capture_output=True)
+
+
+def durum():
+    return {k: git(k, "status", "--short").stdout for k in IZLENEN if os.path.isdir(k)}
+
+
+def yaz(d, yol, metin):
+    io.open(os.path.join(d, yol), "w", encoding="utf-8", newline="\n").write(metin)
+
+
+def ozet(d):
+    return hashlib.sha256(open(os.path.join(d, "data", HEDEF), "rb").read()).hexdigest()
+
+
+def kos(d, *arg, arac=None):
+    p = subprocess.run([sys.executable, arac or "arac/_sahiplik_uygula.py"] + list(arg), cwd=d,
+                       capture_output=True, env=dict(os.environ, PYTHONIOENCODING="utf-8"))
+    return p.returncode, (p.stdout.decode("utf-8", "replace") + p.stderr.decode("utf-8", "replace")).replace("\r\n", "\n")
+
+
+def adlar(out, onek):
+    return {m.group(1) for m in re.finditer(r"^  %s  (.+?)  \[" % re.escape(onek), out, re.M)}
+
+
+def _js(v, sira):
+    if isinstance(v, list):
+        return "[" + ",".join(_js(x, sira) for x in v) + "]"
+    if isinstance(v, dict):
+        ks = [k for k in sira if k in v] + [k for k in v if k not in sira]
+        return "{" + ",".join("%s:%s" % (k, _js(v[k], sira)) for k in ks) + "}"
+    return json.dumps(v, ensure_ascii=False)
+
+
+def P(f, t, d, kaynak=None):
+    p = {"f": f, "t": t, "d": d}
+    if kaynak:
+        p["kaynak"] = kaynak
+    return p
+
+
+def kur_repo(bugun, yama, sira=("f", "t", "d")):
+    """bugun: kayıt dict (ad dahil) · yama: kayıt dict (taban otomatik = bugünkü s)."""
+    d = tempfile.mkdtemp(prefix="kur_sinav_")
+    os.makedirs(os.path.join(d, "arac"))
+    os.makedirs(os.path.join(d, "data"))
+    for f in ARAC:
+        shutil.copy(os.path.join(KOK, "arac", f), os.path.join(d, "arac", f))
+    k = dict(bugun)
+    ad = k.pop("ad")
+    yaz(d, "data/" + HEDEF, "window.YERLESIMLER = [\n{ ad:%s, tur:\"sehir\", lat:40.0, lon:30.0, %s },\n];\n"
+        % (json.dumps(ad, ensure_ascii=False), ", ".join("%s:%s" % (a, _js(v, ("f", "t", "d"))) for a, v in k.items())))
+    y = dict(yama)
+    y.setdefault("taban", {a: bugun.get(a) for a in ("d", "s", "v", "isg") if a in yama})
+    yaz(d, "data/yer_yama_sinav.js", "window.YER_YAMA_SINAV = [\n{ad:%s, %s}\n];\n"
+        % (json.dumps(ad, ensure_ascii=False), ", ".join("%s:%s" % (a, _js(v, sira)) for a, v in y.items() if a != "ad")))
+    git(d, "init", "-q"); git(d, "add", "-A"); git(d, "commit", "-q", "-m", "1")
+    return d
+
+
+MERGEN = {"ad": "Sinavmergen", "kur": "1686-01-01",
+          "s": [P("1686-01-01", "1912-02-12", "qing-hanedani"), P("1912-02-12", "1923-10-29", "cin-cumhuriyeti")]}
+MERGEN_Y = {"s": [P("1636-05-15", "1912-02-12", "qing-hanedani"), P("1912-02-12", "1923-10-29", "cin-cumhuriyeti")]}
+
+
+def mo(kur, f_eski, f_yeni):
+    """Bugün: kur + dönem [f_eski → 1500]; yama: dönemi f_yeni'den başlatır."""
+    return ({"ad": "Sinavmo", "kur": kur, "s": [P(f_eski, "1500-01-01", "a-devlet")]},
+            {"s": [P(f_yeni, "1500-01-01", "a-devlet")]})
+
+
+def sentetik(eski):
+    print("\n=== SENTETİK ===")
+    d_ler = []
+    try:
+        def vaka(ad_, bugun, yama, bek, sira=("f", "t", "d"), yazilmali=None, ek=None):
+            d = kur_repo(bugun, yama, sira); d_ler.append(d)
+            once = ozet(d)
+            kod, out = kos(d, "--yaz")
+            yazildi = ozet(d) != once
+            ok = kod == bek and (yazilmali is None or yazildi == yazilmali) and (ek is None or ek(out))
+            sina("%s → çıkış %d%s" % (ad_, bek, "" if yazilmali is None else (" · YAZILDI" if yazilmali else " · dosya aynı")),
+                 ok, "çıkış %d · yazıldı %s" % (kod, yazildi))
+            return d, kod, out
+
+        for u, sira in (("U1", ("d", "f", "t")), ("U2", ("f", "t", "d"))):
+            d, kod, out = vaka("%s Mergen eşi yama {%s}: qing 1636 < kur 1686" % (u, ",".join(sira)), MERGEN, MERGEN_Y, 2,
+                               sira, False, lambda o: adlar(o, "KUR-ONCESI") == {"Sinavmergen"})
+            if eski:
+                kod_e, out_e = kos(d, "--yaz", arac=eski)
+                print("    (bilgi) %s ESKİ (origin/main, kur kapısı YOK) → çıkış %d · %s" % (
+                    u, kod_e, "YAZDI (qing 1636)" if "1636-05-15" in io.open(os.path.join(d, "data", HEDEF),
+                                                                              encoding="utf-8").read() else "yazmadı"))
+        vaka("U3 kur -2999 / f -3100", *mo("-2999-01-01", "-2999-01-01", "-3100-01-01"), 2, yazilmali=False)
+        vaka("U4 kur -3100 / f -2999 (yama dönemi -2000'den -2999'a GENİŞLETİYOR)", *mo("-3100-01-01", "-2000-01-01", "-2999-01-01"), 0, yazilmali=True)
+        vaka("U5 kur 0000 / f -0001", *mo("0000-01-01", "0000-01-01", "-0001-01-01"), 2, yazilmali=False)
+        vaka("U6 f == kur", *mo("1500-01-01", "1450-06-01" if False else "1500-01-01", "1500-01-01"), 0,
+             ek=lambda o: not adlar(o, "KUR-ONCESI"))
+        # U6'nın yazım yönü: bugün f 1600 (kur 1500'den sonra), yama f'yi tam kur'a çekiyor
+        vaka("U6b f == kur (yama dönemi kur gününe çekiyor)",
+             {"ad": "Sinavmo", "kur": "1500-01-01", "s": [P("1600-01-01", "1700-01-01", "a-devlet")]},
+             {"s": [P("1500-01-01", "1700-01-01", "a-devlet")]}, 0, yazilmali=True)
+        beyan = "TDV murad-ii: Ergene Köprüsü 1443'te tamamlandı, kasaba o gün doğdu"
+        db = {"ad": "Sinavkopru", "kur": "1443-01-01", "devir_beyani": beyan,
+              "s": [P("1281-01-01", "1371-01-01", "bizans"), P("1371-01-01", "1923-10-29", "osmanli")]}
+        vaka("U7 devir_beyani + kur öncesi dönemlerde kaynak YOK → MUAF",
+             db, {"s": [P("1281-01-01", "1371-01-01", "bizans"), P("1371-01-01", "1500-01-01", "osmanli"),
+                        P("1500-01-01", "1923-10-29", "osmanli")]}, 0, yazilmali=True,
+             ek=lambda o: "KUR MUAF" in o and "Sinavkopru" in o)
+        vaka("U8 devir_beyani AMA kur öncesi dönem KAYNAKLI (kilit b) → muafiyet YOK",
+             db, {"s": [P("1281-01-01", "1371-01-01", "bizans", "TDV bizans: kasaba vardı"),
+                        P("1371-01-01", "1923-10-29", "osmanli")]}, 2, yazilmali=False,
+             ek=lambda o: adlar(o, "KUR-ONCESI") == {"Sinavkopru"})
+        vaka("U9 bozuk kur (1686-13-01)", dict(MERGEN, kur="1686-13-01"), MERGEN_Y, 3, yazilmali=False,
+             ek=lambda o: adlar(o, "KUR-OLCULEMEDI") == {"Sinavmergen"})
+        vaka("U10 bozuk f (yeni dönem 1700-02-30)", MERGEN,
+             {"s": [P("1686-01-01", "1700-02-30", "qing-hanedani"), P("1700-02-30", "1923-10-29", "cin-cumhuriyeti")]},
+             3, yazilmali=False, ek=lambda o: adlar(o, "KUR-OLCULEMEDI") == {"Sinavmergen"})
+        vaka("U11 D5 tolerans bandı (kur 1593 · yeni f 1592-06-01) → yine 2, 'karar VERMİYOR' notu",
+             {"ad": "Sinavberezov", "kur": "1593-01-01", "s": [P("1593-01-01", "1923-10-29", "rusya")]},
+             {"s": [P("1592-06-01", "1923-10-29", "rusya")]}, 2, yazilmali=False,
+             ek=lambda o: "karar VERMİYOR" in o)
+        vaka("U12 bugün AYNEN duran erken dönem + yeni geç dönem → sorulmaz, 0",
+             {"ad": "Sinavyakutsk", "kur": "1632-10-05", "s": [P("1632-01-01", "1923-10-29", "rusya")]},
+             {"s": [P("1632-01-01", "1923-10-29", "rusya"), P("1923-10-29", "1945-01-01", "sovyet")]}, 0,
+             yazilmali=True)
+        vaka("U13 yama BOŞ kur'u dolduruyor, mevcut dönem ondan erken → 2",
+             {"ad": "Sinavyenikur", "s": [P("1500-01-01", "1923-10-29", "a-devlet")]},
+             {"kur": "1600-01-01", "s": [P("1500-01-01", "1923-10-29", "a-devlet"), P("1923-10-29", "1945-01-01", "b")]},
+             2, yazilmali=False, ek=lambda o: adlar(o, "KUR-ONCESI") == {"Sinavyenikur"})
+        # U14 — hızlı kip JSON
+        d = kur_repo(MERGEN, MERGEN_Y); d_ler.append(d)
+        jy = os.path.join(d, "k.json")
+        kod, out = kos(d, "--atlama-yalniz", "--json", jy)
+        J = json.load(io.open(jy, encoding="utf-8"))
+        sina("U14 hızlı kip: çıkış 2 · JSON listesiz_atlama'da Sinavmergen [kur-oncesi]",
+             kod == 2 and [(o["ad"], o["kova"]) for o in J["listesiz_atlama"]] == [("Sinavmergen", "kur-oncesi")],
+             "çıkış %d" % kod)
+    finally:
+        for d in d_ler:
+            shutil.rmtree(d, ignore_errors=True)
+
+
+def gercek():
+    print("\n=== GERÇEK (yalnız KURU, hızlı kip) ===")
+    tmp = tempfile.mkdtemp(prefix="kur_gercek_")
+    W = os.path.join(tmp, "w")
+    try:
+        # çalışma ağacının satır sonu kuralıyla (autocrlf) — kopyalanan araç dosyalarına diff uygulanabilsin
+        subprocess.run(["git", "worktree", "add", "--detach", W, "HEAD"], cwd=KOK, capture_output=True)
+        for f in ARAC:
+            shutil.copy(os.path.join(KOK, "arac", f), os.path.join(W, "arac", f))
+        for f in ("SAHIPLIK-HUKUM-LISTESI.json",):
+            if os.path.exists(os.path.join(KOK, "denetim", f)):
+                shutil.copy(os.path.join(KOK, "denetim", f), os.path.join(W, "denetim", f))
+        jy = os.path.join(tmp, "g1.json")
+        kod, out = kos(W, "--atlama-yalniz", "--yama-glob", r"^(?!(?:yer_yama_1923_1945\.js)$)yer_yama.*\.js$",
+                       "--json", jy)
+        J = json.load(io.open(jy, encoding="utf-8"))
+        ko = [(o["ad"], o["yama"]) for o in J["listesiz_atlama"] if o["kova"] == "kur-oncesi"]
+        print("    G1 kur-oncesi %d kayıt (denetle evreni):" % len(ko))
+        for a, y in ko:
+            print("      %s  [%s]" % (a, y))
+        sina("G1 kur-oncesi ADIYLA basıldı (KUR-ONCESI satırları = JSON kovası)",
+             adlar(out, "KUR-ONCESI") == {a for a, _ in ko}, "%d" % len(ko))
+        v = [p for p in (os.path.join(KOK, "denetim", "YER-YAMA-SESSIZ-7-1010-KOORD-v2.diff"),
+                         os.path.join(KOK, "denetim", "ZAMAN-Z5-1009-KOORD-v4.diff"),
+                         r"C:\atlas-umit\denetim\YER-YAMA-SESSIZ-7-1010-KOORD-v2.diff",
+                         r"C:\atlas-umit\denetim\ZAMAN-Z5-1009-KOORD-v4.diff") if os.path.exists(p)]
+        ses = next((p for p in v if "SESSIZ" in p), None)
+        v4 = next((p for p in v if "v4" in p), None)
+        def ap(x):
+            return subprocess.run(["git", "apply", x], cwd=W, capture_output=True).returncode == 0
+        if ses and v4 and ap(ses) and ap(v4):
+            kod, out = kos(W, "--atlama-yalniz", "--yama-glob", r"^yer_yama_1923_1945\.js$")
+            sina("G2 Z5 v4 (+SESSIZ-7 v2): kur-oncesi 0 · çıkış 0", kod == 0 and not adlar(out, "KUR-ONCESI"),
+                 "çıkış %d · %s" % (kod, sorted(adlar(out, "KUR-ONCESI"))))
+        else:
+            print("    (G2 atlandı: SESSIZ-7 v2 / v4 diff'i bulunamadı ya da uygulanamadı)")
+    finally:
+        git(KOK, "worktree", "remove", "--force", W)
+        shutil.rmtree(tmp, ignore_errors=True)
+
+
+def main():
+    bas = durum()
+    tmp = tempfile.mkdtemp(prefix="kur_eski_")
+    eski = os.path.join(tmp, "_sahiplik_uygula_ESKI.py")
+    p = subprocess.run(["git", "show", "origin/main:arac/_sahiplik_uygula.py"], cwd=KOK, capture_output=True)
+    if p.returncode != 0 or b"SAHIPLIK-KUR-KAPI-1010" in p.stdout:
+        eski = None
+    else:
+        open(eski, "wb").write(p.stdout)
+    try:
+        sentetik(eski)
+        if GERCEK:
+            gercek()
+    finally:
+        shutil.rmtree(tmp, ignore_errors=True)
+    sina("SON C:\\atlas ve C:\\atlas-umit git status önce/sonra AYNI", durum() == bas)
+    kalan = [a for a, k in sonuc if not k]
+    print("\nSINAV: %d/%d geçti" % (len(sonuc) - len(kalan), len(sonuc)))
+    for a in kalan:
+        print("  ✗ " + a)
+    return 1 if kalan else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
