+                continue
+            f = p.get("f") if isinstance(p, dict) else None
+            try:
+                gf = _GUN.gun(f)
+            except Exception as e:  # noqa: BLE001
+                return "olculemedi", "%s dönemi f=%r ayrıştırılamadı (%s)" % (a, f, e)
