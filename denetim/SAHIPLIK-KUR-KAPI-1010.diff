+    not_ = "" if any(c[0] == ad for c in _cel) else \
+        " (Değişmez 5 bu farkta karar VERMİYOR — tolerans altı; muafiyet kilitleri sorulmadı)"
+    return "oncesi", (kur, erken, not_)
 
 
