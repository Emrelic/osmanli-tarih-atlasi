+def kur_kapisi(ad, r, eski_obj, yeni_obj):
+    """→ ("gecer"|"muaf"|"oncesi"|"olculemedi", ayrıntı)."""
+    kur = yeni_obj.get("kur")
+    if kur is None or (isinstance(kur, str) and not kur.strip()):
+        return "gecer", None
+    try:
