+    alanlar = KUR_ALANLARI if yeni_obj.get("kur") != eski_obj.get("kur") else \
+        [a for a in KUR_ALANLARI if a in r]
+    kur_degisti = yeni_obj.get("kur") != eski_obj.get("kur")
+    erken = []
+    for a in alanlar:
+        v = yeni_obj.get(a)
