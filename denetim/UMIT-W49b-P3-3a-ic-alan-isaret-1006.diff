 // ── 8 · LONDRA ANTLAŞMASI ───────────────────────────────────────────────────
 { id:"p76f-londra-antlasmasi", tur:"tartisma",
@@ -90,7 +90,7 @@ window.EKOKUMA_P76F = [
   metin:"I. Balkan Savaşı'nı bitiren 30 Mayıs 1913 tarihli Londra Antlaşması'nın tek bir maddesi, haritanın tamamını yeniden çizdi: Midye-Enez hattı Osmanlı-Bulgar sınırı olarak kabul edildi. Bu hat, Karadeniz'deki Midye ile Ege'deki Enez'i birleştiren ve İstanbul'un hemen batısından geçen bir çizgidir.\n\nPaylaşım şöyle yapıldı: Edirne ve Trakya Bulgaristan'a, Selânik ile güney Makedonya Yunanistan'a, kuzey Makedonya Sırbistan'a, Silistre Romanya'ya bırakıldı.\n\nBu antlaşmanın iki özelliği onu Osmanlı tarihindeki öteki toprak kayıplarından ayırır. Birincisi hızıdır: kaybedilen topraklar yüzyıllar içinde değil, sekiz ay içinde elden çıktı. İkincisi niteliğidir: buralar uzak sömürge değil, devletin kuruluş coğrafyası, ordusunun ve idarî kadrosunun beslendiği çekirdek bölgelerdi.\n\nAntlaşmanın ömrü kısa oldu. Paylaşımdan memnun kalmayan müttefiklerin birbirine düşmesiyle aynı yaz ikinci bir savaş çıktı ve Osmanlı Devleti bu hattın doğusunda kalmaya razı olduğu toprağın bir bölümünü — Edirne dâhil — geri aldı.",
   kesinlik:"kesin",
   olay:["1913-05-30|Londra"],
-  kaynak:"TDV İslâm Ansiklopedisi — «Balkan Savaşı» maddesi (gövdesi okundu): 30 Mayıs 1913 Londra Antlaşması, AYNEN «Midye-Enez hattı Osmanlı-Bulgar sınırı olarak kabul edildi»; Edirne ve Trakya'nın Bulgaristan'a, Selânik ve güney Makedonya'nın Yunanistan'a, kuzey Makedonya'nın Sırbistan'a, Silistre'nin Romanya'ya bırakılması." },
+  kaynak:"TDV İslâm Ansiklopedisi — «Balkan Savaşı» maddesi (gövdesi okundu): 30 Mayıs 1913 Londra Antlaşması, AYNEN «Midye-Enez hattı Osmanlı-Bulgar sınırı olarak kabul edildi» [TDV: balkan-savasi]; Edirne ve Trakya'nın Bulgaristan'a, Selânik ve güney Makedonya'nın Yunanistan'a, kuzey Makedonya'nın Sırbistan'a, Silistre'nin Romanya'ya bırakılması." },
 
 // ── 9 · MAHMUD ŞEVKET PAŞA ──────────────────────────────────────────────────
 { id:"p76f-mahmud-sevket-pasa", tur:"tartisma",
@@ -108,7 +108,7 @@ window.EKOKUMA_P76F = [
   metin:"İkinci Balkan Savaşı'nda müttefiklerin birbirine düşmesi, Osmanlı Devleti'ne Londra Antlaşması'yla çizilmiş hattın ötesine geçme fırsatı verdi. Bu fiilî durumu hukuka çeviren metin, Bulgaristan'la imzalanan 29 Eylül 1913 tarihli İstanbul Antlaşması'dır.\n\nYirmi maddelik antlaşma Edirne'yi Osmanlı denetimine geri verdi; şehrin çevresinde çapı 30 km. tutan yarım daire şeklinde bir toprak parçası da bu düzenlemeye dâhil edildi. Sınır Meriç nehri olarak belirlendi.\n\nAntlaşmanın önemi toprağın büyüklüğünde değil yönündedir. Balkan savaşları boyunca bütün hareket tek yöndeydi — kayıp. Bu metin, o yönün tersine çevrilebildiği tek noktadır ve bugünkü Türkiye'nin Trakya sınırının temelini oluşturur.\n\nAntlaşma toprakla da sınırlı kalmadı: iki ülke arasında karşılıklı nüfus düzenlemeleri ve Bulgaristan'da kalan müslümanların hakları da metne bağlandı. Kavala ve Dedeağaç ise Bulgaristan'da bırakıldı — yani Ege'ye çıkış geri alınamadı.",
   kesinlik:"kesin",
   olay:["1913-09-29|İstanbul Antlaşması"],
-  kaynak:"TDV İslâm Ansiklopedisi — «Balkan Savaşı» maddesi (gövdesi okundu): 29 Eylül 1913 tarihli yirmi maddelik antlaşmanın Edirne'yi geri vermesi, AYNEN «çapı 30 km. tutan yarım daire şeklinde bir toprak parçası» ve Meriç nehrinin sınır olması." },
+  kaynak:"TDV İslâm Ansiklopedisi — «Balkan Savaşı» maddesi (gövdesi okundu): 29 Eylül 1913 tarihli yirmi maddelik antlaşmanın Edirne'yi geri vermesi, AYNEN «çapı 30 km. tutan yarım daire şeklinde bir toprak parçası» [TDV: balkan-savasi] ve Meriç nehrinin sınır olması." },
 
 // ── 11 · OSMANLI-ALMAN İTTİFAKI ─────────────────────────────────────────────
 { id:"p76f-osmanli-alman-ittifak", tur:"tartisma",
@@ -117,7 +117,7 @@ window.EKOKUMA_P76F = [
   metin:"2 Ağustos 1914'te, İstanbul'da Osmanlı Devleti ile Almanya arasında gizli bir ittifak antlaşması imzalanmıştı. Tarih tesadüfî değildir: Almanya'nın Rusya'ya savaş ilân etmesinin hemen ertesidir.\n\nOsmanlı hükümetinin başlangıçtaki niyeti tarafsızlıktı. Bu niyeti bozan şey imzanın kendisinden çok, sonrasında gelen fiilî durumdur: İngiliz donanmasından kaçan iki Alman savaş gemisi 10 Ağustos 1914'te Çanakkale Boğazı'ndan içeri alındı. Tarafsızlık hukuku bu gemilere el konulmasını gerektiriyordu; bunun yerine gemiler satın alınmış gösterildi, Yavuz ve Midilli adlarıyla Osmanlı donanmasına katıldı ve Alman amiral Souchon'un komutası altında kaldı.\n\n'Niçin İngiltere ya da Fransa ile ittifak kurulmadı?' sorusu, cevabı Osmanlı'nın tercihinde aramaya alışmıştır; oysa ittifak iki taraflıdır. Rusya ile aynı blokta bulunan bir İngiltere ve Fransa için Osmanlı ile bağlayıcı bir ittifak, Rusya'nın Boğazlar ve doğu Anadolu üzerindeki beklentileriyle doğrudan çelişiyordu. Kaynaklar bu dönemde İtilâf devletleriyle sonuçlanmış bir ittifak antlaşması kaydetmez.\n\nİttifakın gizliliği de kayda değer: antlaşma kabineden bile saklandı ve yalnız birkaç kişi tarafından biliniyordu. Yani savaşa girişi hazırlayan belge, onu uygulayacak hükümetin çoğunluğundan gizlenmişti.",
   kesinlik:"tartismali",
   olay:["1914-08-02|gizli ittifak"],
-  kaynak:"TDV İslâm Ansiklopedisi — «Birinci Dünya Savaşı» maddesi (gövdesi okundu), AYNEN: «2 Ağustos 1914'te, İstanbul'da Osmanlı Devleti ile Almanya arasında gizli bir ittifak antlaşması imzalanmıştı»; gemilerin 10 Ağustos 1914'te Boğaz'a girişi, satın alınmış gösterilmesi, Yavuz ve Midilli adları ve Souchon'un komutası. İtilâf devletleriyle ittifak görüşmelerinin ayrıntısı bu maddede yer almaz — bulunamadı." },
+  kaynak:"TDV İslâm Ansiklopedisi — «Birinci Dünya Savaşı» maddesi (gövdesi okundu), AYNEN: «2 Ağustos 1914'te, İstanbul'da Osmanlı Devleti ile Almanya arasında gizli bir ittifak antlaşması imzalanmıştı» [TDV: birinci-dunya-savasi]; gemilerin 10 Ağustos 1914'te Boğaz'a girişi, satın alınmış gösterilmesi, Yavuz ve Midilli adları ve Souchon'un komutası. İtilâf devletleriyle ittifak görüşmelerinin ayrıntısı bu maddede yer almaz — bulunamadı." },
 
 // ── 12 · KAPİTÜLASYONLAR ────────────────────────────────────────────────────
 { id:"p76f-kapitulasyon-ilga", tur:"tartisma",
@@ -144,7 +144,7 @@ window.EKOKUMA_P76F = [
   metin:"Amiral Souchon komutasındaki donanmanın 29 Ekim 1914'te Sivastopol ve Novorossiysk limanlarını topa tutması, Rusya'nın 2 Kasım 1914'te Osmanlı Devleti'ne savaş ilân etmesine sebep oldu. Öteki İtilâf devletlerinin ilânları da günler içinde geldi.\n\nHarekâtın askerî mantığını savunmak zordur. Karadeniz'de Rus donanmasını etkisiz kılacak bir kuvvet üstünlüğü yoktu; limanların bombalanması bir çıkarma, bir kuşatma ya da bir kara harekâtının önünü açmıyordu. Elde edilen şey, savunulabilir bir askerî mevzi değil, bir siyasî sonuçtu.\n\nBu yüzden harekât genellikle askerî değil siyasî bir hamle olarak okunur: üç ay önce imzalanmış gizli ittifakın gereğini yerine getirmek, tarafsızlığı sürdürmek isteyen kabine kanadını oldubittiyle etkisiz kılmak ve savaşa girişi tartışılamaz hâle getirmek. Kararın kabinenin bütününden gizlenerek verildiği yolundaki yaygın kanaat de bu okumayı destekler; ancak bu, üzerinde tam görüş birliği bulunan bir nokta değildir ve dönemin iç yazışmalarına dayanan ayrı bir inceleme ister.\n\n'Osmanlı ne yaptığını biliyor muydu?' sorusunun en dürüst cevabı ikiye ayrılır: harekâtı emredenler sonucunu — savaş — büyük ihtimalle biliyor ve istiyordu; devletin geri kalanı ise bu sonuca hazırlıklı değildi. Beş ayrı cephede sürecek dört yıllık bir savaş, iki günlük bir deniz harekâtının ardından başladı.",
   kesinlik:"tartismali",
   olay:["1914-10-29|Karadeniz Baskını"],
