@@ -72,7 +72,7 @@ window.EKOKUMA_P76F = [
   metin:"Balkan devletlerinin 1912 boyunca birbirleriyle ittifak antlaşmaları imzaladığı bir yılda, Bâbıâli bu hazırlığı zamanında okuyamadı. Dahası, savaş ihtimalinin uzak olduğu yolundaki telkinlere güvenilerek Rumeli'deki yüz yirmi tâlimli tabur terhis edildi. Savaş, ordunun en zayıf olduğu anda başladı.\n\nİkinci sebep ordunun içindeydi: savaş sırasında ordu içindeki siyasî görüş ayrılıkları yenilgide büyük rol oynadı. Subay kadrosu siyasî saflara bölünmüş bir ordu, cephede emir-komuta birliğini de kaybeder.\n\nÜçüncüsü coğrafyadır: Rumeli uzun, dar ve çok cepheli bir alandır; dört devlet aynı anda farklı yönlerden yüklendiğinde ihtiyat kuvvetlerini bir cepheden ötekine yetiştirmek mümkün olmadı.\n\nSelânik'in teslimi bu tablonun en çarpıcı sahnesidir. Şehir 23-24 Ekim 1912'de ciddi bir direnişle karşılaşmadan düştü; Tahsin Paşa 35.000 kişilik ordusu ile Selânik'te Yunanlılar'a teslim oldu. Bir ordunun bir şehri değil, bir şehrin bir orduyu teslim aldığı bu an, çağdaşlarınca da uzun süre tartışıldı.\n\nTeçhizat, para ve yetişmiş subay eksikliği de sayılır; ancak yukarıdaki üç unsur olmadan bunlar tek başına dört devlete karşı bu hızda bir çöküşü açıklamaz.",
   kesinlik:"kesin",
   olay:["1912-10-08|Balkan"],
-  kaynak:"TDV İslâm Ansiklopedisi — «Balkan Savaşı» maddesi (gövdesi okundu): AYNEN «Savaş sırasında ordu içindeki siyasî görüş ayrılıkları yenilgide büyük rol oynadı»; yüz yirmi tâlimli taburun terhisi; ittifaklardan habersizlik; Selânik'in 23-24 Ekim 1912'de düşüşü ve AYNEN «35.000 kişilik ordusu ile Selânik'te Yunanlılar'a teslim oldu»." },
+  kaynak:"TDV İslâm Ansiklopedisi — «Balkan Savaşı» maddesi (gövdesi okundu): AYNEN «Savaş sırasında ordu içindeki siyasî görüş ayrılıkları yenilgide büyük rol oynadı» [TDV: balkan-savasi]; yüz yirmi tâlimli taburun terhisi; ittifaklardan habersizlik; Selânik'in 23-24 Ekim 1912'de düşüşü ve AYNEN «35.000 kişilik ordusu ile Selânik'te Yunanlılar'a teslim oldu»." },
 
 // ── 7 · ARNAVUTLUK SAVAŞMADAN MI BAĞIMSIZ OLDU ──────────────────────────────
 { id:"p76f-arnavutluk-istiklal", tur:"tartisma",
@@ -81,7 +81,7 @@ window.EKOKUMA_P76F = [
   metin:"28 Kasım 1912'de İsmâil Kemali, Avlonya'da Arnavutluk'un istiklâlini ilân etti. Bu ilân, Balkan savaşının ortasında, Osmanlı ordusunun Rumeli'de çözüldüğü haftalarda yapıldı.\n\n'Savaşmadan bağımsız oldular' izlenimi bir bakımdan doğrudur: Arnavutların Osmanlı'ya karşı yürütülmüş, bağımsızlıkla biten bir kurtuluş savaşı yoktur; bağımsızlık askerî bir zaferin değil diplomatik tanınmanın ürünüdür.\n\nAma tabloyu böyle bırakmak yanıltır. İlânın yapıldığı sırada Arnavutların yaşadığı topraklar üç komşu ordunun harekât alanıydı; Sırp, Karadağ ve Yunan kuvvetleri kuzeyden, doğudan ve güneyden ilerliyordu. Yeni devletin asıl mücadelesi Osmanlı'ya karşı değil, bu paylaşıma karşı ve büyük devletlerin masasında verildi. İstiklâl, ordusu olmayan bir hareketin dış dengeleri kullanarak toprağını kurtarma çabasıydı.\n\nBu yüzden 1912 ilânı ile sınırların çizilmesi aynı şey değildir: ilân bir gün meselesi, sınır ise yıllar süren bir pazarlık oldu ve Arnavutların yaşadığı toprakların önemli bir kısmı yeni devletin dışında kaldı.",
   kesinlik:"tartismali",
   olay:["1912-11-28|Arnavutluk"],
-  kaynak:"TDV İslâm Ansiklopedisi — «Arnavutluk» maddesi (gövdesi okundu), AYNEN: «28 Kasım 1912'de İsmâil Kemali, Avlonya'da Arnavutluk'un istiklâlini ilân etti»; madde bağımsızlığın savaşla değil tanınma yoluyla geldiğini belirtir. Sınır pazarlıklarının ayrıntısı bu maddede verilmez." },
