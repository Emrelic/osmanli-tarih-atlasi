 { t:"1402-12-14", k:"savas", etiket:["savas","toprak-kazanc","konu-askeri"], b:"Timur İzmir'i Saint Jean şövalyelerinden aldı", gun:"Aralık 1402", yer:"İzmir", yer_id:"İzmir", kisiler:"Timur, Saint Jean şövalyeleri", d:"Kütahya, Denizli, Aydın, Ayasuluk ve Tire üzerinden batıya inen Timur, 1344'ten beri Hıristiyanların elinde bulunan sahil İzmir'i kuşatarak aldı. Yıldırım Bayezid'in yıllarca alamadığı bu kaleyi kısa sürede zapteden Timur, çevredeki kaleleri de ele geçirdikten sonra Aydın ilini eski sahiplerine bırakarak doğuya döndü. Şehir bundan sonra Aydınoğlu Cüneyd Bey'in idaresine girdi.", kaynak:"izmir", duygu:["⚔️"] },
 { t:"1402-12-20", k:"siyaset", etiket:["siyaset","toprak-kazanc","konu-askeri","konu-siyasi","konu-kisiler"], b:"Îsâ Çelebi Bursa'yı ele geçirdi — Anadolu payı doğdu", gun:"1402 sonu", yer:"Bursa, Balıkesir (Karesi)", yer_id:"Bursa", kisiler:"Îsâ Çelebi", d:"Ankara bozgunundan sonra Karesi taraflarına çekilen Îsâ Çelebi, Timur İzmir'deyken Bursa'yı ele geçirdi. Timur'un askerlerince yağmalanıp yakılmış eski başkentte hükümdarlığını ilân etti ve kendi adına sikke kestirdi; Ocak 1403'te Anadolu'da 'Türkler'in hükümdarı' sıfatıyla tanınıyordu. Haritada Marmara'nın Asya kıyısı boyunca uzanan bu pay, Îsâ Çelebi'nin kendi rengiyle görünür.", kaynak:"isa-celebi", duygu:["🏛","😔"] },
 { t:"1403-03-15", k:"siyaset", etiket:["siyaset","konu-siyasi"], b:"Timur'un Anadolu'dan çekilmesi", gun:"Mart 1403 sonrası", yer:"Akşehir – Doğu Anadolu", yer_id:"Akşehir", kisiler:"Timur", d:"Yıldırım Bayezid'in Akşehir'de vefat ettiği haberini alan Timur, Anadolu'daki işini bitmiş sayarak doğuya yöneldi. Geride kendisine bağlılık bildiren beylikler ile birbirine düşmüş Osmanlı şehzadeleri kaldı; Sivas gibi bazı şehirler Timur'a tâbi Mezid Bey benzeri emîrlerin elinde bırakıldı. Timur bir daha Anadolu'ya dönmedi, ancak kurduğu bu parçalı düzen on yıl sürdü.", kaynak:"timur", duygu:["🏛"] },
-{ t:"1404-03-01", k:"savas", etiket:["savas","toprak-kazanc","konu-askeri"], b:"Emîr Süleyman Anadolu'ya geçti: Bursa ve Ankara onun eline geçti", gun:"Mart 1404", yer:"Bursa, Ankara, Karadeniz Ereğlisi", yer_id:"Bursa", kisiler:"Emîr Süleyman Çelebi, Çandarlı Ali Paşa, Çelebi Mehmed", d:"Îsâ Çelebi'nin yenilgisini duyan Emîr Süleyman, Çandarlı Ali Paşa ile birlikte güçlü bir orduyla Anadolu'ya geçerek Bursa'yı, ardından Ankara'yı ele geçirdi; Mart 1404 kayıtları Karadeniz Ereğlisi'nin de onun yönetiminde olduğunu gösterir. Kısa sürede hem Rumeli'ye hem Anadolu'nun büyük bölümüne hâkim olan Süleyman karşısında Çelebi Mehmed direnemedi. Haritada bu tarihten 1411'e kadar iki yaka tek renkte, Emîr Süleyman'ın payında görünür.", kaynak:"suleyman-celebi-emir", duygu:["⚔️"] },
+{ t:"1404-03-01", k:"savas", etiket:["savas","toprak-kazanc","konu-askeri"], b:"Emîr Süleyman Anadolu'ya geçti: Bursa onun eline geçti", gun:"Mart 1404", yer:"Bursa, Karadeniz Ereğlisi", yer_id:"Bursa", kisiler:"Emîr Süleyman Çelebi, Çandarlı Ali Paşa, Çelebi Mehmed", d:"Îsâ Çelebi'nin yenilgisini duyan Emîr Süleyman, Çandarlı Ali Paşa ile birlikte güçlü bir orduyla Anadolu'ya geçerek Bursa'yı ele geçirdi; Mart 1404 kayıtları Karadeniz Ereğlisi'nin de onun yönetiminde olduğunu gösterir. Kısa sürede hem Rumeli'ye hem Anadolu'nun büyük bölümüne hâkim olan Süleyman karşısında Çelebi Mehmed direnemedi. Haritada bu tarihten 1411'e kadar iki yaka tek renkte, Emîr Süleyman'ın payında görünür.", kaynak:"suleyman-celebi-emir", ic_not:"ANKARA-1406 (koordinatör hükmü, 9 Ekim 2026): Ankara bu maddeden ÇIKARILDI — TDV ankara Ankara'nın Süleyman'a 1406'da geçtiğini açıkça yazar; TDV suleyman-celebi-emir'in Mart 1404 bağlamındaki \"Ankara'nın onun kontrolü altında bulunduğu … anlaşılır\" ifadesi çıkarımdır. Ankara'nın geçişi ayrı madde (1406).", duygu:["⚔️"] },
 { t:"1405-01-01", k:"savas", etiket:["savas","toprak-kayip","konu-askeri"], b:"Yenişehir Ovası savaşı — Çelebi Mehmed Amasya'ya çekildi", gun:"1404-1405", yer:"Yenişehir Ovası, Bursa", yer_id:"Yenişehir (Bursa)", kisiler:"Emîr Süleyman Çelebi, Çelebi Mehmed", d:"Bursa ve Ankara'yı kaybeden Çelebi Mehmed, Yenişehir ovasında Emîr Süleyman'a yenilerek Batı Anadolu'daki bütün kazanımlarını yitirdi ve Tokat-Amasya üssüne çekildi. Bu yenilgiden sonra doğrudan çatışmadan kaçınıp Anadolu'nun içlerinde otoritesini pekiştirmeye yöneldi. Fetret'in en uzun sessiz safhası böyle başladı.", kaynak:"mehmed-i", duygu:["⚔️"] },
+{ t:"1406-01-01", k:"fetih", etiket:["savas","toprak-kazanc","konu-askeri"], b:"Emîr Süleyman Ankara'yı Çelebi Mehmed'den aldı", gun:"1406 (TDV yıl verir; gün bilinmiyor)", yer:"Ankara", yer_id:"Ankara", kisiler:"Emîr Süleyman Çelebi, Çandarlı Ali Paşa, Yâkub Bey, Çelebi Mehmed", d:"Timur'un Anadolu'dan çekilmesinden sonra Çelebi Mehmed'in elinde kalan Ankara'yı 1406'da Emîr Süleyman kuşattı. Kale muhafızı Yâkub Bey bir süre dayandı, ancak Vezîriâzam Çandarlı Ali Paşa'nın bir hilesiyle kaleyi Süleyman'a teslim etti. Bunun üzerine Çelebi Mehmed Karamanoğlu Mehmed Bey'le anlaşarak Süleyman'a karşı harekete geçti.", kaynak:"TDV: ankara — \"1406’da Süleyman Çelebi Ankara önlerine gelerek kaleyi muhasara altına aldı. Kale muhafızı Yâkub Bey bir müddet dayandı, ancak Vezîriâzam Çandarlı Ali Paşa’nın bir hilesi sonucu kaleyi Süleyman Çelebi’ye teslim etti.\"", ic_not_t:"YIL hassasiyeti: TDV ankara yalnız 1406 der; t 1406-01-01 yıl temsilidir (D210). Çelişki beyanı: TDV suleyman-celebi-emir 1404'ü çıkarımla ima eder. Alıntı tek okuma — GET teyidi KASA kalemi. ANKARA-1406 (koordinatör hükmü, BEYANLI).", duygu:["⚔️"] },
 { t:"1408-06-01", k:"fetih", etiket:["savas","toprak-kazanc","konu-askeri"], b:"Çelebi Mehmed Sivas'ı Timurlu Mezid Bey'den geri aldı", gun:"810 (1407-1408)", yer:"Sivas", yer_id:"Sivas", kisiler:"Çelebi Mehmed, Bayezid Paşa, Mezid Bey", d:"Timur istilasından sonra Sivas'ın idaresi Timur'a tâbi Mezid Bey'e bırakılmıştı. Amasya'daki Çelebi Mehmed, kumandanı Bayezid Paşa'yı şehri almak üzere gönderdi ve şiddetli bir direnişin ardından Sivas ikinci kez Osmanlı hânedanının eline geçti. Böylece Mehmed'in payı, Ankara Savaşı'ndan altı yıl sonra doğuda eski sınırına ulaştı.", kaynak:"sivas", duygu:["🎉"] },
 { t:"1410-02-13", k:"savas", etiket:["savas","toprak-kazanc","konu-askeri"], b:"Yanbolu Savaşı — Mûsâ Çelebi Edirne'ye girdi", gun:"8 Şevval 812 / 13 Şubat 1410", yer:"Yanbolu (Yambol), Trakya", kisiler:"Mûsâ Çelebi, Emîr Süleyman Çelebi, Eflak Voyvodası Mircea", d:"Eflak üzerinden Rumeli'ye geçen Mûsâ Çelebi, Eflak ve Sırp desteğiyle Yanbolu'da Emîr Süleyman'ın kuvvetlerini bozguna uğrattı ve Edirne'ye girdi. Fetret Devri'nde Rumeli ilk kez Emîr Süleyman'ın elinden çıkmış oldu. Ancak hâkimiyeti kalıcı olmadı; dört ay sonra Kosmidion'da yenilerek Balkan içlerine çekilecekti.", kaynak:"musa-celebi", duygu:["⚔️"], yer_kon:[42.4833,26.5] },
 { t:"1412-10-01", k:"savas", etiket:["savas","konu-askeri"], b:"İnceğiz Savaşı — Çelebi Mehmed'in ilk Rumeli yenilgisi", gun:"Ekim 1412", yer:"İnceğiz, Trakya", kisiler:"Çelebi Mehmed, Mûsâ Çelebi", d:"Bizans'ın gemileriyle Rumeli'ye geçen Çelebi Mehmed, İnceğiz'de Mûsâ Çelebi ile savaşa girişti; Mûsâ emrindeki yedi bin yeniçeriyle Mehmed'i mağlup etti ve Mehmed Anadolu'ya dönmek zorunda kaldı. Bu yenilgi Mehmed'i doğrudan savaş yerine Rumeli uç beylerini ve Sırp despotluğunu kendi tarafına çekme stratejisine yöneltti. Dokuz ay sonraki Çamurlu zaferinin zemini bu diplomasiyle hazırlandı.", kaynak:"fetret-devri", duygu:["⚔️","😔"], yer_kon:[41.22,28.42] },
