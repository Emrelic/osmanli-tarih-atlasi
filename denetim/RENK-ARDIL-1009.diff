+    `zaman_cizgisi()`nde ardışık iki FARKLI sahip, aralarındaki sahipsiz
+    boşluk ≤ `tavan` gün ise ardıldır. Sınav `ARAC-RENK-ARDIL-SINAV-1009.py`."""
+    out = collections.defaultdict(list)
+    for y in Y:
+        zc = zaman_cizgisi(y, cozum)
+        for (a, _fa, ta), (b, fb, _tb) in zip(zc, zc[1:]):
+            if a == b or a in ARDIL_MUAF or b in ARDIL_MUAF:
+                continue
+            if a in (OSM_DOGRUDAN, OSM_TABI) and b in (OSM_DOGRUDAN, OSM_TABI):
+                continue
+            ga, gb = _gun(ta), _gun(fb)
+            bos = (gb - ga) if (ga is not None and gb is not None) else None
+            if bos is None or bos > tavan:
