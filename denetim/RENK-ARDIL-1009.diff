+def _gun(s):
+    """'YYYY-MM-DD' → gün sayısı (fark için). MÖ/5 haneli yıl yaklaşık."""
+    m = re.match(r"^(-?)(\d+)-(\d+)-(\d+)", s or "")
+    if not m:
+        return None
+    y, a, g = int(m.group(2)) * (-1 if m.group(1) else 1), int(m.group(3)), int(m.group(4))
+    if 1 <= y <= 9999:
+        import datetime
+        try:
+            return datetime.date(y, a, g).toordinal()
+        except ValueError:
+            pass
+    return int(y * 365.2425 + (a - 1) * 30.44 + g)
