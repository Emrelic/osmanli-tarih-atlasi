+        d: açık → OSMANLI doğrudan
+        yoksa s: → d: kimliği (cozum ile boya anahtarı)
+    isg: OKUNMAZ. 🔴 Dönemleri f'ye göre SIRALAYIP komşusunu eşlemek YANLIŞ:
+    iç içe dönemde (Kütahya: d: 1300-1920 içinde v: 1832-1833) 'v → tbmm'
+    diye 87 yıllık hayalî ardıllık üretiyordu (ölçüldü, ilk sürüm)."""
+    S = [(p["f"], p["t"], cozum(p["d"])) for p in (y.get("s") or [])
+         if p.get("d") and p.get("f") and p.get("t")]
+    D = [(p["f"], p["t"]) for p in (y.get("d") or []) if p.get("f") and p.get("t")]
+    V = [(p["f"], p["t"], cozum(p["kid"]) if p.get("himaye") is True and p.get("kid")
+          else OSM_TABI) for p in (y.get("v") or []) if p.get("f") and p.get("t")]
+    sinir = sorted({x for f, t, *_ in S + V for x in (f, t)} | {x for f, t in D for x in (f, t)})
+    out = []
+    for a, b in zip(sinir, sinir[1:]):
+        sh = next((an for f, t, an in V if f <= a < t), None)
+        if sh is None and any(f <= a < t for f, t in D):
+            sh = OSM_DOGRUDAN
+        if sh is None:
+            sh = next((d for f, t, d in S if f <= a < t), None)
+        if sh is None:
+            continue                                     # sahipsiz dilim
+        if out and out[-1][0] == sh and out[-1][2] == a:
+            out[-1] = (sh, out[-1][1], b)
+        else:
+            out.append((sh, a, b))
+    return out
+
