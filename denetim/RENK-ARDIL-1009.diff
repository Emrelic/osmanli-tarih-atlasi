+    kaynak = re.sub(r"^sys\.stdout = io\.TextIOWrapper\(.*$", "pass", kaynak,
+                    count=1, flags=re.M)
+    exec(compile(kaynak, m.__file__, "exec"), m.__dict__)
+    return m
