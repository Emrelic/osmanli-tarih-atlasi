+def zaman_cizgisi(y, cozum=lambda x: x):
+    """yerleşimin TABAN RENGİ zaman çizgisi: [(sahip, f, t)], ardışık eşitler
+    birleşik, sahipsiz dilim YOK (atlanır). Her an TEK sahip, MOTORUN
+    önceliğiyle (`uret_petek.py` `_osm_aktif` + :6353):
