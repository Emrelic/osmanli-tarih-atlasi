+
+def dogrula_cikti(M, satirlar):
+    fd, yol = tempfile.mkstemp(suffix=".txt")
+    with os.fdopen(fd, "w", encoding="utf-8") as f:
+        f.write("".join(f"{a} {h}\n" for a, h in satirlar))
+    try:
+        _kod, out = sessiz(M.dogrula, yol)
+    finally:
+        os.remove(yol)
+    return out
+
+
+def oner_cikti(M):
+    """--oner resuli,tahiri — ikisi de paletten ÇIKARILIR ('yeni' kimlik)."""
+    eski = {x: B.pop(x, None) for x in ("resuli", "tahiri")}
+    _, out = sessiz(M.oner, ["resuli", "tahiri"])
+    for x, v in eski.items():
+        if v is not None:
+            B[x] = v
+    m = re.search(r"artefakt: (\S+)", out)
+    if m and os.path.exists(m.group(1)):
+        os.remove(m.group(1))          # sınav artefakt BIRAKMAZ
+    hx = dict(re.findall(r"^\s+(resuli|tahiri)\s+(#[0-9a-f]{6})", out, re.M))
+    if len(hx) < 2:
+        return None, hx
+    return R.dE(R.lab(R.bind(R.h2r(hx["resuli"]))),
+                R.lab(R.bind(R.h2r(hx["tahiri"])))), hx
+
+
