+
+B = renkler.BOYALAR                     # iki modülün de BOYALAR'ı BU nesne
+_yedek = {x: B.get(x) for x in ("resuli", "tahiri")}
+B["resuli"] = ("Resûlîler", "#6cd824")
+B["tahiri"] = ("Tâhirîler (Yemen)", "#72d824")    # ΔE ≈ 1 — vakanın hâli
+
+with contextlib.redirect_stdout(io.StringIO()):
+    k, _ = R.komsuluk()
+ak, kanit = R.ardil()
+sor("B1a önkoşul: veride resuli→tahiri ardıllığı VAR",
+    ("resuli", "tahiri") in kanit, str(kanit.get(("resuli", "tahiri"))))
+sor("B1b önkoşul: Voronoi komşusu DEĞİLLER (eşzamanlı değil)",
+    "tahiri" not in k.get("resuli", ()))
+_de = R.dE(R.gorunen("resuli"), R.gorunen("tahiri"))
+if U is not None:
+    _ue = U.engel_kumesi("resuli", k=k)
+    sor("B1c YAMASIZ: tahiri resuli'nin engeli DEĞİL (kör nokta yeniden üretildi)",
+        "tahiri" not in _ue and not hasattr(U, "ardil"), f"ΔE {_de:.2f}")
+_ri = R.ardil_denetle(k)[0]
+_hit = [x for x in _ri if (x[1], x[2]) == ("resuli", "tahiri")]
+sor("B1d YAMALI: resuli↔tahiri ARDIL ÇAKIŞMASI", bool(_hit) and _hit[0][0] < R.DE_KOMSU,
+    f"ΔE {_hit[0][0]:.2f}" if _hit else "listede yok")
+sor("B1e YAMALI: tahiri resuli'nin engeli (oner/dogrula aynı evreni görür)",
+    "tahiri" in R.engel_kumesi("resuli", k=k))
+
+B["tahiri"] = ("Tâhirîler (Yemen)", "#9c24d8")    # BOYA-BORC-1009 önerisi
+_i, _s, _o, _b = R.ardil_denetle(k)
+_c = [x for x in _i + _s if (x[1], x[2]) == ("resuli", "tahiri")]
+sor("B2 BOYA-BORC renkleriyle (#6cd824/#9c24d8) TEMİZ", not _c,
+    f"ΔE {R.dE(R.gorunen('resuli'), R.gorunen('tahiri')):.1f}")
+
+# B3 — ardışık OLMAYAN uzak devlet, resuli ile AYNI hex
+_uzak = next((x for x in ("inka", "aztek", "joseon", "ming-hanedani", "ingiltere")
+              if x in B and x not in ak.get("resuli", ()) and x not in k.get("resuli", ())),
+             None)
+if _uzak is None:
+    sor("B3 önkoşul: uzak aday bulundu", False)
+else:
+    _eski = B[_uzak]
+    B[_uzak] = (_eski[0], "#6cd824")
+    _i, _s, _o, _b = R.ardil_denetle(k)
+    _yanlis = [x for x in _i + _s if "resuli" in (x[1], x[2]) and _uzak in (x[1], x[2])]
+    sor(f"B3 ardışık olmayan uzak devlet ({_uzak}, aynı hex) çakışma SAYILMAZ",
+        not _yanlis and _uzak not in ak.get("resuli", ()))
+    B[_uzak] = _eski
+
+
+# B4 — --oner resuli,tahiri (ikisi de paletten ÇIKARILIR: "yeni" kimlik)
+def _oner(M):
+    for x in ("resuli", "tahiri"):
+        B.pop(x, None)
+    tam = io.StringIO()
+    with contextlib.redirect_stdout(tam):
+        M.oner(["resuli", "tahiri"])
+    out = tam.getvalue()
+    m = re.search(r"artefakt: (\S+)", out)
+    if m and os.path.exists(m.group(1)):
+        os.remove(m.group(1))          # sınav artefakt BIRAKMAZ
+    hx = dict(re.findall(r"^\s+(resuli|tahiri)\s+(#[0-9a-f]{6})", out, re.M))
+    if len(hx) < 2:
+        return None, hx
+    return R.dE(R.lab(R.bind(R.h2r(hx["resuli"]))),
+                R.lab(R.bind(R.h2r(hx["tahiri"])))), hx
+
+
+if "--hizli" in sys.argv:
+    print("  i B4 atlandı (--hizli)")
+else:
+    if U is not None:
+        d, hx = _oner(U)
+        sor("B4a YAMASIZ --oner: resuli/tahiri eşik ALTINDA (vaka yeniden üretildi)",
+            d is not None and d < R.DE_KOMSU, f"{hx} ΔE {d if d is None else round(d, 2)}")
+    d, hx = _oner(R)
+    sor("B4b YAMALI --oner: resuli/tahiri ΔE ≥ 12", d is not None and d >= R.DE_KOMSU,
+        f"{hx} ΔE {d if d is None else round(d, 2)}")
+
+for x, v in _yedek.items():            # BOYALAR'ı eski hâline döndür
+    if v is None:
+        B.pop(x, None)
+    else:
+        B[x] = v
+
+print("\n" + ("✓ HEPSİ GEÇTİ" if not _kalan else f"🔴 {len(_kalan)} soru KALDI: "
+                                                  + " · ".join(_kalan)))
+sys.exit(1 if _kalan else 0)
