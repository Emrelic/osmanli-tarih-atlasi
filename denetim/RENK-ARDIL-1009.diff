+    sys.path dosya yolundan türüyor; sahte yol ölçümü bozar)."""
+    spec = importlib.util.spec_from_loader(ad, loader=None)
+    m = importlib.util.module_from_spec(spec)
+    m.__file__ = os.path.join(AR, "renk_olc.py")
+    # modül import anında stdout'u YENİDEN sarıyor; iki kez yüklenince eski
+    # sarmalayıcı çöpe giderken ortak tamponu KAPATIYOR (ölçüldü) ⇒ o satır
