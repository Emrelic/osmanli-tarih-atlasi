+# 🔴 KRONO-NEG-1010: eski desen `\d{4}` negatif (MÖ) `t:`yi HİÇ okumuyordu. Desen
+#   yalnız ADAY bulur; gün olup olmadığına `gun.gun` karar verir (tek otorite).
+#   İki desen ESKİSİNİN BİREBİR bağlamıyla (yalnız yıl kısmı değişti).
+_T_GUN = (re.compile(r't:"([+-]?\d{1,6}-\d{2}-\d{2})"'),
+          re.compile(r'"t":\s*"([+-]?\d{1,6}-\d{2}-\d{2})"'))
+
+
+def _kron_gunleri(s):
+    out = set()
+    for g in [g for rx in _T_GUN for g in rx.findall(s)]:
+        try:
+            gun.gun(g)
+        except (TypeError, ValueError):
+            continue
+        out.add(g)
+    return out
+
+
