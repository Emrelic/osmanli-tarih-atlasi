+# -*- coding: utf-8 -*-
+"""ACİLİYET TESPİTİ — tahta YAZICISI ile tahta BEKÇİSİNİN ortak, TEK kararı.
+
+🔴 VAKA (YORUM-KONTROL-TARAMA-1010, 10 Ekim 2026; TAHTA-ACIL-I-1010 ölçtü):
+   aynı soruya iki ayrı cevap veren iki kod vardı.
+     tahta.py       `_t(aciliyet).upper() in ("ACIL", "DURDURUCU")`
+                    ⇒ `--aciliyet ACİL` (noktalı İ) → "ACİL" ≠ "ACIL"
+                    ⇒ NORMAL sayılıyor ⇒ `--dayanak` İSTENMİYOR, KÜTÜK diye geçiyor
+     tahta_bekci.py `_sade(aciliyet) in ("ACIL", "DURDURUCU")`  (İ→I düzlüyor)
+                    ⇒ aynı kayıt ACIL ⇒ HERKES yayını BÜTÜN bekçileri UYANDIRIYOR
+   Sonuç: CLAUDE.md §7.2 ③'ün "dayanaksız uyandırma yok" sözleşmesi Türkçe
+   yazımın EN DOĞAL biçiminde (ACİL) deliniyordu. Kusur iki kodun her birinde
+   değil, İKİSİNİN AYRIŞMASINDAYDI — bu yüzden çare bir tarafı düzeltmek
+   değil, iki tarafı TEK işleve bağlamaktır.
+
+📌 Normalleştirici `denetim/ARAC-NORMAL-0903.py`deki `norm()`dur, BURAYA
+   TAŞINDI (arac/ araçları denetim/ dosyasına çalışma anında bağlanmasın diye).
+   Davranış eşdeğerliği `denetim/ARAC-TAHTA-ACIL-I-SINAV-1010.py` E1'de
+   iki işlev aynı derlem üzerinde koşturularak sınanır. Biri değişirse sınav öter.
+   Tuzak (§4): "İ".lower() iki kod noktası verir, casefold() da çözmez.
+
+🔴 KELİME SINIRI KARARI: eşleşme TAM SÖZCÜKTÜR, alt dizgi DEĞİL.
+   "ACİLEN" · "aciliyet" · "acilci" → ACİL SAYILMAZ (NORMAL).
+   Gerekçe: `--aciliyet` bir ANAHTAR alanıdır, serbest metin değil; alt dizgi
+   eşleşmesi "aciliyet: düşük" gibi bir değeri ALARMA çevirir. Asıl güvence
+   kelime sınırı değil TUTARLILIKTIR: hangi karar verilirse verilsin yazıcı
+   ve bekçi AYNI kararı verir — "dayanak istenmedi ama uyandırdı" hâli
+   artık yapısal olarak İMKÂNSIZ.
+   ⚠️ Bilinen yanlış pozitif (bilerek kabul): "ACİL DEĞİL" → ACİL sayılır ve
+   dayanak ister. Güvenli yöne düşer (RED, açık mesajla), sessizce geçmez.
+"""
+import re
+import unicodedata as _u
+
+ACIL = "ACIL"
+DURDURUCU = "DURDURUCU"
+
+# ── denetim/ARAC-NORMAL-0903.py `norm()` — BİREBİR ────────────────────────
+_ESLEME = str.maketrans({
+    "İ": "i", "I": "i", "ı": "i",
+    "Ş": "s", "ş": "s", "Ğ": "g", "ğ": "g",
+    "Ü": "u", "ü": "u", "Ö": "o", "ö": "o", "Ç": "c", "ç": "c",
+    "Â": "a", "â": "a", "Î": "i", "î": "i", "Û": "u", "û": "u",
+    "’": "'", "‘": "'", "”": '"', "“": '"', "–": "-", "—": "-",
+})
+
+
+def norm(s):
+    """Ad karsilastirmasi icin TEK normallestirici (ARAC-NORMAL-0903)."""
+    if not s:
+        return ""
+    s = s.translate(_ESLEME)
+    s = _u.normalize("NFKD", s)
+    s = "".join(c for c in s if not _u.combining(c))
+    return s.lower().strip()
+# ──────────────────────────────────────────────────────────────────────────
+
+
+def sinif(s):
+    """'DURDURUCU' · 'ACIL' · '' (uyandırmaz). Tam sözcük, Türkçe düzlenmiş."""
+    kelimeler = set(re.findall(r"[a-z0-9]+", norm(s)))
+    if "durdurucu" in kelimeler:
+        return DURDURUCU
+    if "acil" in kelimeler:
+        return ACIL
+    return ""
+
+
+def uyandirir_mi(s):
+    """HERKES yayınında bu aciliyet BÜTÜN bekçileri uyandırır mı?
+    Yazıcının `--dayanak` şartı da TAM BU soruya bağlıdır."""
+    return bool(sinif(s))
+
+
+def kanonik(s):
+    """Kayda yazılacak değer: tanınan sınıf kanonik adıyla, öteki düzlenmiş."""
+    k = sinif(s)
+    if k:
+        return k
+    return norm(" ".join((s or "").split())).upper() or "NORMAL"
