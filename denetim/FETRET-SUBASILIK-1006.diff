-{ t:"1423-01-01", k:"fetih", etiket:["toprak-kazanc","savas","konu-askeri"], b:"Tekeoğulları'nın kesin tasfiyesi: Antalya'nın alınışı", gun:"Ocak 1423", yer:"Antalya, Teke ili", yer_id:"Antalya", kisiler:"II. Murad, Hamza Bey, Osman Çelebi", d:"Ankara Savaşı'ndan sonra Timur'un diriltmesiyle yeniden kurulan Tekeoğulları Beyliği, Hamza Bey kumandasındaki Osmanlı kuvvetlerinin Antalya'yı kuşatmasıyla son buldu; beyliğin son önemli adamı Osman Çelebi ortadan kaldırıldı. Böylece Akdeniz kıyısındaki Teke ili yirmi bir yıllık ayrılıktan sonra kesin olarak Osmanlı'ya katıldı. Beylik, Hamîdoğulları'ndan ayrılan kol olarak 1321'den beri Antalya'da hüküm sürüyordu.", kaynak:"tekeogullari", duygu:["🎉"] },
+{ t:"1423-01-01", k:"fetih", etiket:["toprak-kazanc","savas","konu-askeri"], b:"Tekeoğulları'nın kesin tasfiyesi: Osman Çelebi öldürüldü, Karaman'ın Antalya kuşatması çöktü", gun:"Ocak 1423", yer:"Antalya, İstanoz, Teke ili", yer_id:"Antalya", kisiler:"II. Murad, Hamza Bey, Osman Çelebi, Karamanoğlu II. Mehmed Bey", d:"Ankara Savaşı'ndan sonra Antalya'yı geri almak isteyen eski Antalya hâkiminin oğlu Osman Çelebi, Karamanlıların desteğiyle İstanoz'da beklerken Osmanlıların Antalya subaşısı Hamza Bey'in gece baskınında öldürüldü. Ardından Antalya'yı kuşatan Karamanoğlu II. Mehmed Bey kaleden atılan bir top güllesiyle ölünce kuşatma dağıldı; Hamza Bey Teke-ili sancak beyliğine getirildi ve Antalya ile Teke-ili'nde Osmanlı hâkimiyeti kesin olarak sağlandı. Antalya Fetret boyunca Osmanlı subaşılarının elinde kalmıştı; Teke-ili'nin içerisi ise 1402-1415 arasında Karamanoğlu'nun hâkimiyetindeydi.", ic_not_d:"FETRET-SUBASILIK-1006: eski metin 'Timur'un diriltmesiyle yeniden kurulan Tekeoğulları' ve 'Hamza Bey kumandasındaki Osmanlı kuvvetlerinin Antalya'yı kuşatması' diyordu; TDV tekeogullari ve antalya ikisini de desteklemiyor (Antalya Osmanlı subaşısındaydı, kuşatan Karaman'dı). 'Yirmi bir yıllık ayrılık' cümlesi kaldırıldı.", kaynak:"tekeogullari · antalya", duygu:["🎉"] },
 { t:"1424-01-01", k:"fetih", etiket:["toprak-kazanc","diplomasi","konu-askeri","konu-diplomasi"], b:"Aynaroz (Athos) manastırlarının Osmanlı himayesine girişi", gun:"1424", yer:"Aynaroz (Athos) yarımadası", yer_id:"Aynaroz (Athos)", kisiler:"II. Murad", d:"Selanik'in kuşatma altına alındığı yıllarda, Halkidiki'nin doğu parmağındaki Aynaroz manastır cumhuriyeti II. Murad'a başvurarak himaye istedi ve Osmanlı hâkimiyetini kabul etti. Keşişlerin mülkiyet ve ibadet hakları güvence altına alındı; manastırlar vergi karşılığında iç işlerinde serbest bırakıldı. Bu düzen, Osmanlı'nın Ortodoks kurumlarıyla kurduğu himaye ilişkisinin en uzun ömürlü örneği oldu ve beş asır sürdü.", kaynak:"aynaroz", duygu:["🎉"] },
 { t:"1427-01-01", k:"fetih", etiket:["toprak-kazanc","siyaset","konu-askeri","konu-siyasi"], b:"Tâceddinoğulları Beyliği'nin ilhakı: Niksar", gun:"830 (1427)", yer:"Niksar, Canik", yer_id:"Niksar", kisiler:"II. Murad, Yörgüç Paşa, Hüsâmeddin Hasan Bey", d:"Amasya beylerbeyi Yörgüç Paşa'nın baskısı üzerine Tâceddinoğlu Hüsâmeddin Hasan Bey, merkezi Niksar olan ülkesinin anahtarlarını 830 (1427) yılında teslim etti; kendisine Rumeli'de bir sancak verildi. XIV. yüzyılın ikinci yarısında kurulan ve sınırları zaman zaman Kelkit, Amasya, Samsun, Ordu ve Giresun'a kadar uzanan beylik böylece sona erdi. Aynı yıl Hacıemiroğulları'na ait topraklar da tahrir edilerek Canik sancağına bağlandı; Orta Karadeniz'deki beylikler dönemi kapandı.", kaynak:"taceddinogullari", duygu:["🎉"] },
 { t:"1449-01-01", k:"fetih", etiket:["toprak-kazanc","konu-askeri"], b:"Epir kıyısının katılışı: Arta ve Preveze", gun:"1449", yer:"Arta, Preveze, Epir", yer_id:"Arta", kisiler:"II. Murad", d:"Yanya'nın 1430'da teslim olmasından on dokuz yıl sonra, Epir despotluğunun kıyı kesimindeki Arta ve Preveze de Osmanlı idaresine girdi. Böylece İyon Denizi'ne açılan Ambrakia körfezi denetim altına alındı ve Yanya'nın deniz bağlantısı tamamlandı. Preveze, doksan yıl sonra Barbaros'un tarihe geçecek zaferine adını verecek olan koyun kilit noktasıdır.", kaynak:"osmanlilar", duygu:["🎉"] },
