+def dikis_olc(Y, ufuk_bas=None, eski=None):
+    """ESKI_UFUKLAR ∪ {VERI_UFKU[0]} günlerindeki geçişler.
+    Döner: {kaynaksiz, kaynakli, kirpma, olu_ufuk} → sıralı liste. Anahtar `dosya|ad|f|d`.
+    kirpma = önünde dönem olmayan (s[0] konumundaki) halka (BİLGİ) · olu_ufuk = hiçbir dönemin
+    başlamadığı ESKI_UFUKLAR girdisi (listeden düşmeli)."""
+    # 🔴 Kıyas DİZGİYLE DEĞİL `gun.gun()` ile (arac/gun.py, TEK otorite): "-3100-01-01" > "-2999-01-01"
+    #   dizgi olarak — MÖ paketinin önüne eklediği halka "önce" görünmezdi (sınavda ölçüldü, vaka 8).
+    import gun as _gunmod
+
+    def _gn(s):
+        try:
+            return _gunmod.gun(s)
+        except (TypeError, ValueError):
+            return None
+    gunler = set(ESKI_UFUKLAR if eski is None else eski) | {ufuk_bas or VERI_UFKU[0]}
+    K = {"kaynaksiz": [], "kaynakli": [], "kirpma": [], "olu_ufuk": []}
+    gorulen = set()
+    for y in Y:
+        S = [p for p in (y.get("s") or []) if isinstance(p, dict)]
+        for p in S:
+            g = p.get("f")
+            if g not in gunler:
+                continue
+            gorulen.add(g)
+            a = "%s|%s|%s|%s" % (y.get("_kaynak"), y.get("ad"), p.get("f"), p.get("d"))
+            gs = _gn(g)
+            if not any(_gn(q.get("f")) is not None and _gn(q.get("f")) < gs for q in S if q is not p):
+                K["kirpma"].append(a)
+            elif _kaynak_dolu(p.get("kaynak")):
+                K["kaynakli"].append(a)
+            else:
+                K["kaynaksiz"].append(a)
+    K["olu_ufuk"] = [g for g in (ESKI_UFUKLAR if eski is None else eski) if g not in gorulen]
+    return {k: sorted(v) for k, v in K.items()}
+
