+    p = os.path.join(tempfile.mkdtemp(prefix="isirma_diff_"), ad)
+    open(p, "wb").write(out)
+    return p
+
+
+def kos(d, *arg):
+    p = subprocess.run([sys.executable, os.path.join(d, "arac", "sinav_isirma.py")] + list(arg), cwd=d,
+                       capture_output=True, env=dict(os.environ, PYTHONIOENCODING="utf-8"))
+    return p.returncode, (p.stdout.decode("utf-8", "replace") + p.stderr.decode("utf-8", "replace")).replace("\r\n", "\n")
+
+
+def kova(out, ad):
+    m = re.search(r"^  %s \(\d+\).*\n    adlar: (.*)$" % re.escape(ad), out, re.M)
+    return None if m is None else ([] if m.group(1).strip() == "—" else m.group(1).split())
+
+
+def artik_yok(d):
+    kalan = glob.glob(d + "-isirma-*")
+    wl = git(d, "worktree", "list").stdout.decode("utf-8", "replace").strip().splitlines()
+    return not kalan and len(wl) == 1
+
+
+def sinav_yol(d, metin, ad="mini_sinav.py"):
+    p = os.path.join(tempfile.mkdtemp(prefix="isirma_s_"), ad)
+    io.open(p, "w", encoding="utf-8").write(metin)
+    return p
