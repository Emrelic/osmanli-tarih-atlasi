@@ -0,0 +1,319 @@
+# -*- coding: utf-8 -*-
+"""sinav_isirma.py — bir sınavın sorusu GERÇEKTEN ISIRIYOR mu? Aynı sınav, iki ağaçta.
+
+Bir sorunun GEÇMESİ üç ayrı şey olabilir: ① doğru cevap · ② tesadüf (yamasız kod da
+"doğru" sonucu yanlış sebeple verir) · ③ soru hiç sorulmuyor (yamasız kod o yola girmez,
+soru boş geçer). Üçü de ekranda ✓ yazar. Tek ayırt edici: aynı sınavı YAMASIZ ağaçta da
+koşturmak. Bu araç bunu elle yapılmaktan çıkarır.
+
+    py arac/sinav_isirma.py --taban origin/main --diff A.diff [B.diff ...] --sinav <yol>
+                            [--ek <yardımcı dosya> ...] [--ham <dizin>] [--json <yol>]
+                            [-- <sınav argümanları; {KOK} = koşulan ağacın kökü>]
+
+  A = taban (tek kullanımlık worktree, detached) · B = taban + diff'ler (her diff önce
+  `git apply --check`; ÇAKIŞIRSA `--reverse --check` ile "zaten uygulanmış mı" ayrılır).
+  Sınav İKİ ağaçta da AYNI BAYTLARLA koşar:
+    • --sinav göreli yolsa önce B'de (diff'ten sonra) aranır — diff'in getirdiği sınav;
+      bulunursa o baytlar A'ya da aynı yola konur.
+    • değilse (ağaç dışı dosya) iki ağaca da `denetim/<adı>` olarak kopyalanır — böylece
+      kökünü kendi yolundan türeten sınav (`os.path.dirname(__file__)/..`) koşulan ağacı ölçer,
+      kopyalandığı depoyu değil. `--ek` dosyaları sınavın yanına kopyalanır.
+  Soru satırı (sınavların ortak biçimi, 10 Ekim 2026'da okundu):
+      ✓ <ID> …   ·   ✗ <ID> …   ·   ✗ BAŞARISIZ <ID> …   ·   GEÇTİ <ID> …   ·   KALDI <ID> …
+  Özet satırı: `SONUÇ: g/n geçti` · `SINAV: g/n geçti` · `SONUÇ: n soru · g geçti`.
+  Özetten SONRAKİ satırlar okunmaz (kalanların tekrar listesi). SAYAN = BASAN: ayrıştırılan soru
+  sayısı ve geçen sayısı özetle, kalan varlığı sınavın çıkış koduyla (0/1) birebir tutmalı;
+  tutmazsa o taraf ÖLÇÜLEMEDİ — sessizce 0 sayılmaz.
+  Eşleştirme anahtarı: (ID, ID dahil ilk 5 sözcük, sıra) — ID'si tekrar eden sınavlarda (K1 ×7)
+  bir dalın yalnız bir tarafta basılması sonraki soruları kaydırmaz; eşi olmayan soru
+  EŞLEŞMEDİ kovasına ADIYLA düşer ve ÖLÇÜLEMEDİ sayılır.
+
+KOVALAR
+  ISIRIYOR                  yalnız yamalıda geçti — soru yamayı ölçüyor
+  TESADÜF-YA-DA-SORULMAMIŞ  ikisinde de geçti — ELLE İNCELENMELİ (② ya da ③; ya da yamanın dokunmadığı
+                            bir korumanın SÜREKLİLİK sorusu — üçünü araç AYIRAMAZ, yalnız ADLANDIRIR)
+  İKİSİNDE-KALAN            ikisinde de kaldı
+  GERİLEME                  yalnız yamasızda geçti
+  EŞLEŞMEDİ                 yalnız bir tarafta basıldı
+
+Çıkış: 0 rapor üretildi · 1 GERİLEME var · 2 kullanım hatası · 3 ÖLÇÜLEMEDİ.
+GERİLEME varsa hüküm 1'dir ama ölçülemeyenler YİNE basılır (biri ötekini gizlemez).
+Worktree'ler (`<depo>-isirma-<pid>-A/B`) her durumda kaldırılır; kaldırılamazsa basılır.
+"""
+import argparse
+import hashlib
+import io
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import time
+
+if hasattr(sys.stdout, "reconfigure"):
+    sys.stdout.reconfigure(encoding="utf-8", errors="replace", line_buffering=True)
+
+SORU = re.compile(r"^\s*(✓|✗(?:\s+BAŞARISIZ)?|GEÇTİ|KALDI)\s+(\S.*)$")
+OZET = re.compile(r"^\s*(?:SONUÇ|SINAV):\s*(?:(\d+)\s*/\s*(\d+)\s+geçti|(\d+)\s+soru\s*·\s*(\d+)\s+geçti)")
+KOVALAR = ("ISIRIYOR", "TESADÜF-YA-DA-SORULMAMIŞ", "İKİSİNDE-KALAN", "GERİLEME", "EŞLEŞMEDİ")
+
+
+class Kullanim(Exception):
+    pass
+
+
+def git(*a, cwd=None):
+    p = subprocess.run(["git"] + list(a), cwd=cwd, capture_output=True)
+    return p.returncode, p.stdout.decode("utf-8", "replace").strip(), p.stderr.decode("utf-8", "replace").strip()
+
+
+def sha(yol):
+    return hashlib.sha256(open(yol, "rb").read()).hexdigest()
+
+
+def ayristir(metin):
+    """→ (sorular [(anahtar, geçti, satır)], özet (geçen, toplam) | None)"""
+    sorular, ozet, say = [], None, {}
+    for satir in metin.splitlines():
+        m = OZET.match(satir)
+        if m:
+            ozet = (int(m.group(1)), int(m.group(2))) if m.group(1) else (int(m.group(4)), int(m.group(3)))
+            break
+        m = SORU.match(satir)
+        if not m:
+            continue
+        sozcuk = m.group(2).split()
+        etiket = " ".join(sozcuk[:5])
+        k = (sozcuk[0], etiket)
+        say[k] = say.get(k, 0) + 1
+        sorular.append(((sozcuk[0], etiket, say[k]), m.group(1) in ("✓", "GEÇTİ"), satir.strip()))
+    return sorular, ozet
+
+
+def dogrula(taraf, kod, sorular, ozet, ozetsiz):
+    """Sayan = basan. Dönüş: ölçülemedi sebepleri (boş = taraf ölçüldü)."""
+    s = []
+    if kod not in (0, 1):
+        s.append("%s: sınav çıkış kodu %s (0/1 değil — sınav çöktü ya da zaman aşımı)" % (taraf, kod))
+    if not sorular:
+        s.append("%s: hiçbir soru satırı ayrıştırılamadı (biçim tanınmadı)" % taraf)
+        return s
+    gecen = sum(1 for _, ok, _ in sorular if ok)
+    if ozet is None:
+        if not ozetsiz:
+            s.append("%s: özet satırı (SONUÇ:/SINAV:) yok — sayım doğrulanamadı (--ozetsiz ile kabul edilir)" % taraf)
+    elif ozet != (gecen, len(sorular)):
+        s.append("%s: SAYAN ≠ BASAN — özet %d/%d, ayrıştırılan %d/%d" % (taraf, ozet[0], ozet[1], gecen, len(sorular)))
+    if kod in (0, 1) and (kod == 1) != (gecen < len(sorular)):
+        s.append("%s: çıkış kodu %d ile sonuç çelişiyor (%d/%d geçti)" % (taraf, kod, gecen, len(sorular)))
+    return s
+
+
+def kovala(A, B):
+    a = {k: (ok, st) for k, ok, st in A}
+    b = {k: (ok, st) for k, ok, st in B}
+    kova = {k: [] for k in KOVALAR}
+    for k, ok, st in B:
+        if k not in a:
+            kova["EŞLEŞMEDİ"].append(("yalnız yamalıda", k, st))
+        elif ok and not a[k][0]:
+            kova["ISIRIYOR"].append(("", k, st))
+        elif ok:
+            kova["TESADÜF-YA-DA-SORULMAMIŞ"].append(("", k, st))
+        elif a[k][0]:
+            kova["GERİLEME"].append(("", k, a[k][1] + "   →   " + st))
+        else:
+            kova["İKİSİNDE-KALAN"].append(("", k, st))
+    for k, ok, st in A:
+        if k not in b:
+            kova["EŞLEŞMEDİ"].append(("yalnız yamasızda", k, st))
+    return kova
+
+
+def ad(k):
+    return k[0] if k[2] == 1 else "%s#%d" % (k[0], k[2])
+
+
+def worktree_kaldir(depo, yol):
+    if not os.path.exists(yol):
+        return True
+    git("worktree", "remove", "--force", yol, cwd=depo)
+    if os.path.exists(yol):
+        shutil.rmtree(yol, ignore_errors=True)
+    git("worktree", "prune", cwd=depo)
+    return not os.path.exists(yol)
+
+
+def kos(agac, rel, sinav_arg, zaman):
+    yol = os.path.join(agac, rel)
+    yorumlayici = ["node"] if rel.lower().endswith(".js") else [sys.executable]
+    arg = [x.replace("{KOK}", agac) for x in sinav_arg]
+    env = dict(os.environ, PYTHONIOENCODING="utf-8", PYTHONDONTWRITEBYTECODE="1")
+    t0 = time.time()
+    try:
+        p = subprocess.run(yorumlayici + [yol] + arg, cwd=agac, capture_output=True, env=env, timeout=zaman)
+        kod, out, err = p.returncode, p.stdout.decode("utf-8", "replace"), p.stderr.decode("utf-8", "replace")
+    except subprocess.TimeoutExpired as e:
+        kod, out, err = "ZAMAN-AŞIMI", (e.stdout or b"").decode("utf-8", "replace"), ""
+    return kod, out.replace("\r\n", "\n"), err.replace("\r\n", "\n"), time.time() - t0
+
+
+def main(argv):
+    if "--" in argv:
+        i = argv.index("--")
+        argv, sinav_arg = argv[:i], argv[i + 1:]
+    else:
+        sinav_arg = []
+    ap = argparse.ArgumentParser(description="Sınav ısırma ölçümü: aynı sınav yamasız ve yamalı ağaçta.")
+    ap.add_argument("--taban", help="taban ref — ZORUNLU, öntanımsız YOK (örn. origin/main)")
+    ap.add_argument("--diff", nargs="+", action="extend", default=[], help="sırayla uygulanacak diff'ler")
+    ap.add_argument("--sinav", help="sınav betiği (.py / .js)")
+    ap.add_argument("--ek", nargs="+", action="extend", default=[], help="sınavın yanına kopyalanacak yardımcı dosyalar")
+    ap.add_argument("--depo", help="git deposu (varsayılan: bu aracın deposu)")
+    ap.add_argument("--zaman", type=int, default=3600, help="taraf başına zaman aşımı, sn (3600)")
+    ap.add_argument("--ozetsiz", action="store_true", help="özet satırı olmayan sınavı kabul et (sayım doğrulanmaz)")
+    ap.add_argument("--ham", help="iki tarafın ham çıktısını bu dizine yaz (A.txt, B.txt)")
+    ap.add_argument("--json", help="kovaları JSON olarak yaz")
+    ar = ap.parse_args(argv)
+    if not ar.taban:
+        raise Kullanim("--taban verilmedi — öntanımsız taban YOK; bilerek ver (örn. --taban origin/main)")
+    if not ar.diff:
+        raise Kullanim("--diff verilmedi — yamasız ve yamalı ağaç aynı olur, ölçüm anlamsız")
+    if not ar.sinav:
+        raise Kullanim("--sinav verilmedi")
+    cwd = os.getcwd()
+    diffler = [os.path.abspath(d) for d in ar.diff]
+    for d in diffler:
+        if not os.path.isfile(d):
+            raise Kullanim("diff yok: %s" % d)
+    ekler = [os.path.abspath(e) for e in ar.ek]
+    for e in ekler:
+        if not os.path.isfile(e):
+            raise Kullanim("--ek dosyası yok: %s" % e)
+
+    depo = ar.depo or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+    k, ortak, err = git("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=depo)
+    if k:
+        raise Kullanim("git deposu bulunamadı (%s): %s" % (depo, err))
+    ana = os.path.dirname(os.path.normpath(ortak))
+    k, taban, err = git("rev-parse", "--verify", ar.taban + "^{commit}", cwd=ana)
+    if k:
+        raise Kullanim("taban çözülemedi: %s — %s" % (ar.taban, err))
+
+    print("SINAV-ISIRMA · depo %s" % ana)
+    print("  taban    %s → %s" % (ar.taban, taban))
+    k, geri, _ = git("rev-list", "--count", "%s..origin/main" % taban, cwd=ana)
+    if not k:
+        print("  origin/main'e göre GERİDE: %s commit%s" % (geri, "" if geri == "0" else
+              "  ⚠️ taban bayat olabilir (fetch yapıldı mı?) — ölçüm BU tabanındır"))
+    for d in diffler:
+        print("  diff     %s  sha256 %s" % (d, sha(d)[:16]))
+
+    ad_kok = "%s-isirma-%d" % (ana.rstrip("\\/"), os.getpid())
+    A, B = ad_kok + "-A", ad_kok + "-B"
+    olculemedi, kova, sonuc_kodu = [], None, 3
+    try:
+        for yol in (A, B):
+            k, _, err = git("worktree", "add", "--detach", yol, taban, cwd=ana)
+            if k:
+                olculemedi.append("worktree açılamadı: %s — %s" % (yol, err))
+                raise StopIteration
+        for d in diffler:
+            k, _, err = git("apply", "--check", d, cwd=B)
+            if k:
+                kr, _, _ = git("apply", "--reverse", "--check", d, cwd=B)
+                teshis = ("ZATEN UYGULANMIŞ görünüyor (--reverse --check temiz) — tabana inmiş olabilir"
+                          if not kr else "gerçek çakışma (ileri de geri de uygulanmıyor)")
+                olculemedi.append("diff uygulanamadı: %s — %s · %s" % (os.path.basename(d), teshis, err[:300]))
+                raise StopIteration
+            k, _, err = git("apply", d, cwd=B)
+            if k:
+                olculemedi.append("diff --check geçti ama apply başarısız: %s — %s" % (os.path.basename(d), err[:300]))
+                raise StopIteration
+
+        # Sınavı yerleştir: iki ağaçta AYNI baytlar
+        if not os.path.isabs(ar.sinav) and os.path.isfile(os.path.join(B, ar.sinav)):
+            rel = os.path.normpath(ar.sinav)
+            kaynak, nereden = os.path.join(B, rel), "B ağacından (diff sonrası)"
+        else:
+            kaynak = os.path.abspath(os.path.join(cwd, ar.sinav))
+            if not os.path.isfile(kaynak):
+                raise Kullanim("sınav yok: %s (B ağacında da yok)" % ar.sinav)
+            rel, nereden = os.path.join("denetim", os.path.basename(kaynak)), "ağaç dışından"
+        bayt = open(kaynak, "rb").read()
+        yerlestirilen = [rel]
+        for agac in (A, B):
+            hedef = os.path.join(agac, rel)
+            if os.path.isfile(hedef) and open(hedef, "rb").read() != bayt:
+                print("  ⚠️ %s ağacında %s VARDI ve FARKLIYDI — üzerine sınavın baytları yazıldı"
+                      % ("A" if agac == A else "B", rel))
+            os.makedirs(os.path.dirname(hedef), exist_ok=True)
+            if os.path.abspath(hedef) != os.path.abspath(kaynak):
+                open(hedef, "wb").write(bayt)
+            for e in ekler:
+                eh = os.path.join(os.path.dirname(hedef), os.path.basename(e))
+                shutil.copyfile(e, eh)
+        for e in ekler:
+            yerlestirilen.append(os.path.join(os.path.dirname(rel), os.path.basename(e)))
+        print("  sınav    %s  (%s) sha256 %s → iki ağaçta %s" % (kaynak, nereden, hashlib.sha256(bayt).hexdigest()[:16], rel))
+        if ekler:
+            print("  ek       %s" % ", ".join(yerlestirilen[1:]))
+        print("  argüman  %s" % (" ".join(sinav_arg) or "—"))
+
+        sonuc = {}
+        for taraf, agac in (("A (yamasız)", A), ("B (yamalı)", B)):
+            kod, out, err, sure = kos(agac, rel, sinav_arg, ar.zaman)
+            sorular, ozet = ayristir(out)
+            sebep = dogrula(taraf, kod, sorular, ozet, ar.ozetsiz)
+            olculemedi += sebep
+            g = sum(1 for _, ok, _ in sorular if ok)
+            print("  %-12s çıkış %s · %d/%d geçti · özet %s · %.0f sn%s" % (
+                taraf, kod, g, len(sorular), ("%d/%d" % ozet) if ozet else "YOK", sure,
+                "  · stderr %d satır" % len(err.splitlines()) if err.strip() else ""))
+            if sebep and err.strip():
+                print("    stderr (son 5): " + " | ".join(err.strip().splitlines()[-5:]))
+            sonuc[taraf] = sorular
+            if ar.ham:
+                os.makedirs(ar.ham, exist_ok=True)
+                io.open(os.path.join(ar.ham, taraf[0] + ".txt"), "w", encoding="utf-8").write(
+                    "çıkış %s\n--- stdout\n%s\n--- stderr\n%s" % (kod, out, err))
+
+        A_s, B_s = sonuc["A (yamasız)"], sonuc["B (yamalı)"]
+        if A_s and B_s:
+            kova = kovala(A_s, B_s)
+            if kova["EŞLEŞMEDİ"]:
+                olculemedi.append("%d soru yalnız bir tarafta basıldı (EŞLEŞMEDİ kovası)" % len(kova["EŞLEŞMEDİ"]))
+            print("\nKOVALAR  (ISIRIYOR %d · TESADÜF-YA-DA-SORULMAMIŞ %d · İKİSİNDE-KALAN %d · GERİLEME %d · EŞLEŞMEDİ %d)"
+                  % tuple(len(kova[x]) for x in KOVALAR))
+            for x in KOVALAR:
+                print("\n  %s (%d)%s" % (x, len(kova[x]), "  — ELLE İNCELENMELİ" if x == "TESADÜF-YA-DA-SORULMAMIŞ" and kova[x] else ""))
+                print("    adlar: %s" % (" ".join(ad(k) for _, k, _ in kova[x]) or "—"))
+                for not_, k, st in kova[x]:
+                    print("    %-8s %s%s" % (ad(k), ("[" + not_ + "] ") if not_ else "", st[:200]))
+        sonuc_kodu = 1 if kova and kova["GERİLEME"] else (3 if olculemedi else 0)
+    except StopIteration:
+        sonuc_kodu = 3
+    finally:
+        kalan = [y for y in (A, B) if not worktree_kaldir(ana, y)]
+        print("\nWORKTREE  %s" % ("ikisi de kaldırıldı" if not kalan else "KALDIRILAMADI: " + ", ".join(kalan)))
+
+    if olculemedi:
+        print("\nÖLÇÜLEMEDİ (%d):" % len(olculemedi))
+        for s in olculemedi:
+            print("  • " + s)
+    if ar.json:
+        io.open(ar.json, "w", encoding="utf-8").write(json.dumps({
+            "taban": taban, "diffler": diffler, "cikis": sonuc_kodu, "olculemedi": olculemedi,
+            "kovalar": {x: [ad(k) for _, k, _ in kova[x]] for x in KOVALAR} if kova else None},
+            ensure_ascii=False, indent=1))
+    print("\nÇIKIŞ: %d  (%s)" % (sonuc_kodu, {0: "rapor üretildi", 1: "GERİLEME VAR", 3: "ÖLÇÜLEMEDİ"}[sonuc_kodu]))
+    return sonuc_kodu
+
+
+if __name__ == "__main__":
+    try:
+        sys.exit(main(sys.argv[1:]))
+    except Kullanim as e:
+        print("KULLANIM HATASI: %s" % e, file=sys.stderr)
+        sys.exit(2)
