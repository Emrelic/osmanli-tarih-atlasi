+        yaz(d, yol, metin)
+    git(d, "init", "-q"); git(d, "add", "-A"); git(d, "commit", "-q", "-m", "taban")
+    return d
+
+
+def diff_yap(d, degisim, ad="mini.diff"):
+    """degisim: {yol: metin} — çalışma ağacına yazar, diff'i alır, geri alır."""
+    for yol, metin in degisim.items():
+        yaz(d, yol, metin)
