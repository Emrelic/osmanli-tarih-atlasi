+    sina("I12 I1'den sonra worktree kalmadı", artik_yok(d) and "ikisi de kaldırıldı" in out)
+
+    kod, out = kos(d, "--taban", "HEAD", "--diff", diff_tem, "--sinav", s, "--", "{KOK}")
+    sina("I2 gerilemesiz diff → çıkış 0, Q4 TESADÜF kovasında",
+         kod == 0 and kova(out, "GERİLEME") == [] and "Q4" in (kova(out, "TESADÜF-YA-DA-SORULMAMIŞ") or []),
+         "çıkış %d" % kod)
+
+    k1, o1 = kos(d, "--diff", diff_tem, "--sinav", s)
+    k2, _ = kos(d, "--taban", "HEAD", "--sinav", s)
+    k3, _ = kos(d, "--taban", "HEAD", "--diff", diff_tem)
+    sina("I3 --taban / --diff / --sinav eksik → 2, worktree açılmadı",
+         (k1, k2, k3) == (2, 2, 2) and "öntanımsız taban YOK" in o1 and artik_yok(d), "%s" % ((k1, k2, k3),))
+
+    s_bicimsiz = sinav_yol(d, 'print("tamam: 4 soru geçti")\nprint("SONUÇ: 4/4 geçti")\n')
+    kod, out = kos(d, "--taban", "HEAD", "--diff", diff_tem, "--sinav", s_bicimsiz)
+    sina("I4 biçimi tanınmayan sınav → 3, 'ayrıştırılamadı'", kod == 3 and "ayrıştırılamadı" in out, "çıkış %d" % kod)
+
+    s_yalan = sinav_yol(d, SINAV.replace('print("SONUÇ: %d/%d geçti" % (sum(S), len(S)))', 'print("SONUÇ: 9/9 geçti")'))
+    kod, out = kos(d, "--taban", "HEAD", "--diff", diff_tem, "--sinav", s_yalan, "--", "{KOK}")
+    sina("I5 SAYAN ≠ BASAN (özet 9/9) → 3", kod == 3 and "SAYAN ≠ BASAN" in out, "çıkış %d" % kod)
+
+    s_ozetsiz = sinav_yol(d, SINAV.replace('print("SONUÇ: %d/%d geçti" % (sum(S), len(S)))', ''))
+    kod, out = kos(d, "--taban", "HEAD", "--diff", diff_tem, "--sinav", s_ozetsiz, "--", "{KOK}")
+    kod2, out2 = kos(d, "--taban", "HEAD", "--diff", diff_tem, "--sinav", s_ozetsiz, "--ozetsiz", "--", "{KOK}")
