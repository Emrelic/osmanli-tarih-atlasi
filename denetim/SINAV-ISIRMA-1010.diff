+         and kova(out, "İKİSİNDE-KALAN") == ["U2"] and "SAYAN" not in out, "çıkış %d" % kod)
+
+    sina("I12 bütün sentetik koşulardan sonra worktree kalmadı", all(artik_yok(x) for x in DEPOLAR))
