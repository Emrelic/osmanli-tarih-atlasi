+            for satir in (r.stdout or "").splitlines():
+                alan = [x.strip('"') for x in satir.strip().split('","')]
+                if len(alan) >= 2 and alan[1] == str(pid):
+                    return True
+            return False
+        os.kill(pid, 0)
+        return True
+    except ProcessLookupError:
+        return False
+    except PermissionError:
+        return True
+    except Exception:
+        return None
+
