+def dem_izi(yol):
+    """Seçilen DEM'in künyesi — {"ad", "boyut", "sha256"}.
+
+    `uret_petek.py` bunu çıktının `URETIM_IZI.egim` alanına yazar
+    (TUZ-YUKSEKLIK-1010). Ad tek başına yetmez: aynı adla başka içerik
+    (yeniden indirme, başka ETOPO sürümü) sessizce başka bir eğim yüzeyi
+    verir. Yol yazılmaz — makineye özeldir, künyeyi makineden makineye
+    farklı gösterirdi. Bedel ölçüldü: 626 MB'lık dünya DEM'i ≈ 2,5 sn.
+    ⚠️ Bu dosya motor TUZUNDA DEĞİL ve olmamalı: buradaki bir değişiklik
+    önbelleği öldürmemeli; DEM'in etkisi anahtar içeriğinden geçer.
+    """
+    import hashlib
+    h = hashlib.sha256()
+    with open(yol, "rb") as f:
+        for parca in iter(lambda: f.read(1 << 24), b""):
+            h.update(parca)
+    return {"ad": os.path.basename(yol), "boyut": os.path.getsize(yol),
+            "sha256": h.hexdigest()}
+
+
