-{ t:"1700-07-14", k:"antlasma", etiket:["antlasma","toprak-kayip","diplomasi","konu-askeri","konu-diplomasi"], b:"İstanbul Antlaşması — Azak'ın Rusya'ya bırakılması", gun:"14 Temmuz 1700", ic_not_gun:"A2 §4b: TDV karlofca '27 Muharrem 1112 (14 Temmuz 1700)' · TDV rusya '13 Temmuz 1700' — §4⑥ iç ayrışma; hicrî karşılığı yazılı olan karlofca günü korundu. Kırım vergisi hükmü karlofca'da var", yer:"İstanbul", yer_id:"İstanbul", kisiler:"II. Mustafa, Rami Mehmed Efendi, I. Petro", d:"Karlofça'da Rusya ile yalnızca iki yıllık mütareke yapılabilmişti; kalıcı barış İstanbul'da bir buçuk yıl süren çetin pazarlıklardan sonra imzalandı. Osmanlı Devleti 1696'da kaybettiği Azak Kalesi'ni ve çevresindeki toprakları resmen Rusya'ya terk etti, Kırım hanının Moskova'dan aldığı yıllık vergiden vazgeçti. Buna karşılık Rusya İstanbul'da daimî elçi bulundurma hakkını elde etti; böylece Karadeniz'in kuzey kıyısında Rus varlığı hukuken tescillenmiş oldu.", ic_not_d:"eski kaynak: osmanlilar", kaynak:"karlofca · rusya · mustafa-ii", duygu:["🤝"] },
+{ t:"1700-07-14", k:"antlasma", etiket:["antlasma","toprak-kayip","diplomasi","konu-askeri","konu-diplomasi"], b:"İstanbul Antlaşması — Azak'ın Rusya'ya bırakılması", gun:"14 Temmuz 1700", ic_not_gun:"A2 §4b: TDV karlofca '27 Muharrem 1112 (14 Temmuz 1700)' · TDV rusya '13 Temmuz 1700' — §4⑥ iç ayrışma; hicrî karşılığı yazılı olan karlofca günü korundu. Kırım vergisi hükmü karlofca'da var", yer:"İstanbul", yer_id:"Azak", kisiler:"II. Mustafa, Rami Mehmed Efendi, I. Petro", d:"Karlofça'da Rusya ile yalnızca iki yıllık mütareke yapılabilmişti; kalıcı barış İstanbul'da bir buçuk yıl süren çetin pazarlıklardan sonra imzalandı. Osmanlı Devleti 1696'da kaybettiği Azak Kalesi'ni ve çevresindeki toprakları resmen Rusya'ya terk etti, Kırım hanının Moskova'dan aldığı yıllık vergiden vazgeçti. Buna karşılık Rusya İstanbul'da daimî elçi bulundurma hakkını elde etti; böylece Karadeniz'in kuzey kıyısında Rus varlığı hukuken tescillenmiş oldu.", ic_not_d:"eski kaynak: osmanlilar", kaynak:"karlofca · rusya · mustafa-ii", duygu:["🤝"] },
 { t:"1704-01-01", k:"siyaset", etiket:["siyaset","diger","konu-siyasi"], b:"Bağdat'ta Kölemen (Memlûk) idaresinin başlaması", gun:"1704", yer:"Bağdat", yer_id:"Bağdat", kisiler:"Hasan Paşa, III. Ahmed", d:"Gürcü asıllı Hasan Paşa'nın Bağdat valiliğine getirilmesiyle Irak'ta merkezden atanan valiler yerine kendi kölelerinden yetişen bir yönetici zümresinin hâkim olduğu dönem başladı. Süleyman Paşa'nın 1749'daki valiliğiyle sistem iyice yerleşti ve Bâbıâli artık istediği kişiyi değil, nüfuzu eline geçirmiş kölemenlerden birini tayin etmek zorunda kaldı. Bu yarı özerk yapı, İran sınırının savunulmasında işe yaradıysa da merkezî otoritenin Irak üzerindeki denetimini bir buçuk asır boyunca zayıflattı.", kaynak:"bagdat", duygu:["🏛"] },
 { t:"1705-07-17", k:"siyaset", etiket:["siyaset","diger","konu-siyasi","konu-hanedan"], b:"Tunus'ta Hüseynî hanedanının kurulması", gun:"17 Temmuz 1705", yer:"Tunus", yer_id:"Tunus", kisiler:"Hüseyin b. Ali Türkî, III. Ahmed", d:"Cezayir kuvvetlerinin Tunus'u istilâsı üzerine ortaya çıkan otorite boşluğunda, Türk asıllı sipahi ağası Hüseyin b. Ali beyliği ele geçirdi ve Osmanlı padişahına bağlılığını bildirerek meşruiyet kazandı. Kurduğu hanedan 1705-1735 ve 1756-1957 yılları arasında Tunus'u yönetti; ocak yönetiminin yerini babadan oğula geçen bir beylik düzeni aldı. Böylece Garp ocaklarında merkeze bağlı ama fiilen özerk hanedan yapılarının ilk örneği doğmuş oldu.", statu_vasal:["Tunus","Kayrevan","Gabes","Sfaks","Cerbe (Djerba)","Kerkene (Kerkennah)"], kaynak:"huseyniler", duygu:["🏛"] },
 { t:"1708-04-04", k:"fetih", etiket:["savas","toprak-kazanc","konu-askeri"], b:"Vahran (Oran) ve Mersalkebîr'in İspanyollardan alınışı", gun:"4 Nisan 1708", yer:"Vahran (Oran), Cezayir", kisiler:"Mustafa Bûşelâgim, III. Ahmed", d:"Cezayir Ocağı beylerbeyi kuvvetleri, iki asırdır İspanyol garnizonunun elinde bulunan Vahran'ı ve limanı Mersalkebîr'i uzun bir kuşatmanın ardından ele geçirdi. Batı Akdeniz'de Osmanlı himayesindeki Garp ocaklarının İspanya'ya karşı kazandığı en büyük başarıydı ve Cezayir'in batı kanadını güvence altına aldı. Şehir 1732'de yeniden İspanyol işgaline uğrayacak, ancak 1792'de kesin olarak geri alınacaktı.", kaynak:"osmanlilar", duygu:["🎉"], yer_id:"Oran" },
@@ -284,7 +284,7 @@ window.OLAYLAR_EK5 = [
 { t:"1737-08-04", k:"savas", etiket:["savas","konu-askeri"], b:"Banaluka Zaferi — Bosna'nın kurtarılması", gun:"4 Ağustos 1737", yer:"Banaluka, Bosna", kisiler:"Hekimoğlu Ali Paşa", d:"Avusturya kuvvetleri Bosna'ya girip Banaluka'yı kuşatınca, Bosna valisi Hekimoğlu Ali Paşa yerli halktan topladığı kuvvetlerle imdada yetişti ve sayıca üstün düşmanı ağır bir yenilgiye uğrattı. Bu zafer Avusturya'nın Bosna'yı işgal planını daha ilk hamlede çökertti ve eyaletin kuzeyi tamamen geri alındı. Banaluka, 1683 sonrası Avusturya karşısında sürekli geri çekilen Osmanlı ordusunun moralini düzelten dönüm noktalarından biri oldu.", kaynak:"banaluka", duygu:["⚔️"], yer_id:"Banaluka" },
 { t:"1738-08-01", k:"fetih", etiket:["savas","toprak-kazanc","konu-askeri"], b:"Özi'nin geri alınışı ve Kırım'ın Rus istilâsından kurtarılması", gun:"1738", yer:"Özi ve Kırım yarımadası", kisiler:"Yeğen Mehmed Paşa, Mengli Giray II", d:"Salgın hastalık ve ikmal sıkıntısıyla boğuşan Rus ordusu Özi'yi tahliye etmek zorunda kalınca kale yeniden Osmanlı denetimine girdi; aynı yıl Kırım yarımadasına giren Rus kolları da geri püskürtüldü. Bender ve Turla boylarında kazanılan başarılar Tuna cephesinde dengeyi Osmanlı lehine çevirdi. Bu toparlanma, ertesi yıl Belgrad'ın geri alınmasına giden zaferler dizisinin zeminini hazırladı.", kaynak:"kirim", duygu:["🎉","😔"], yer_id:"Özi" },
 { t:"1739-07-22", k:"savas", etiket:["savas","konu-askeri"], b:"Hisarcık (Grocka) Zaferi — Belgrad yolunun açılması", gun:"22 Temmuz 1739", yer:"Hisarcık (Grocka), Belgrad yakınları", kisiler:"İvaz Mehmed Paşa, Hacı Mehmed Paşa, Mareşal Wallis", d:"Belgrad'ı korumak üzere ilerleyen Avusturya ordusu, Tuna kıyısındaki dar boğazda pusuya düşürülerek gün boyu süren muharebede ağır kayıplar verdi. Mareşal Wallis'in kuvvetleri düzensiz biçimde Belgrad'a çekilirken Osmanlı ordusu kalenin önüne dayandı ve kuşatmayı başlattı. Hisarcık, Karlofça'dan beri Avusturya karşısında kazanılan en kesin meydan zaferiydi ve doğrudan Belgrad'ın geri alınmasını sağladı.", kaynak:"belgrad", duygu:["⚔️"], yer_kon:[44.6717,20.7264] },
-{ t:"1739-10-03", k:"antlasma", etiket:["antlasma","diplomasi","toprak-kazanc","konu-askeri","konu-diplomasi"], b:"Niş Antlaşması — Rusya ile barış, Azak'ın tarafsızlaştırılması ve Kırım akınlarının durdurulması", gun:"3 Ekim 1739", yer:"Niş", yer_id:"Niş", kisiler:"I. Mahmud, Marquis de Villeneuve, Çariçe Anna", d:"Avusturya'nın Belgrad'da barışa razı olmasıyla yalnız kalan Rusya, Fransız elçisi Villeneuve'ün arabuluculuğunda savaşı bitirmek zorunda kaldı. Azak Kalesi'nin istihkâmları yıkılarak bölge iki devlet arasında tarafsız arazi ilân edildi; Rusya Karadeniz'de savaş ve ticaret gemisi bulundurmama şartını kabul etti. Böylece Rusya'nın denize açılma hedefi bir kuşak daha ertelendi ve Osmanlı Devleti XVIII. yüzyılda son defa masadan kazançlı kalktı.", kaynak:"osmanlilar", duygu:["🤝"] },
+{ t:"1739-10-03", k:"antlasma", etiket:["antlasma","diplomasi","toprak-kazanc","konu-askeri","konu-diplomasi"], b:"Niş Antlaşması — Rusya ile barış, Azak'ın tarafsızlaştırılması ve Kırım akınlarının durdurulması", gun:"3 Ekim 1739", yer:"Niş", yer_id:"Azak", kisiler:"I. Mahmud, Marquis de Villeneuve, Çariçe Anna", d:"Avusturya'nın Belgrad'da barışa razı olmasıyla yalnız kalan Rusya, Fransız elçisi Villeneuve'ün arabuluculuğunda savaşı bitirmek zorunda kaldı. Azak Kalesi'nin istihkâmları yıkılarak bölge iki devlet arasında tarafsız arazi ilân edildi; Rusya Karadeniz'de savaş ve ticaret gemisi bulundurmama şartını kabul etti. Böylece Rusya'nın denize açılma hedefi bir kuşak daha ertelendi ve Osmanlı Devleti XVIII. yüzyılda son defa masadan kazançlı kalktı.", kaynak:"osmanlilar", duygu:["🤝"] },
 { t:"1743-10-23", k:"savas", etiket:["savas","konu-askeri"], b:"Musul Savunması — Nâdir Şah'ın püskürtülmesi", gun:"13 Eylül – 23 Ekim 1743", yer:"Musul", yer_id:"Musul", kisiler:"Hüseyin Paşa el-Celîlî, Nâdir Şah, I. Mahmud", d:"Kerkük ve Erbil'i alarak Musul önüne gelen Nâdir Şah, kırk gün boyunca şehri topa tuttu ve arka arkaya genel hücumlar düzenledi. Vali Hüseyin Paşa el-Celîlî'nin şehir halkını da silâhlandırarak yürüttüğü savunma, İran ordusunu ağır kayıplarla kuşatmayı kaldırmaya mecbur etti. Musul'un tutunması Irak'ın tamamının elden çıkmasını önledi ve Celîlî ailesinin şehirdeki nüfuzunu bir asır boyunca pekiştirdi.", kaynak:"osmanlilar", duygu:["⚔️"] },
 { t:"1744-01-01", k:"siyaset", etiket:["siyaset","diger","konu-siyasi"], b:"Dir'iye İttifakı — Necid'de ilk Suûdî Emirliği'nin kuruluşu", gun:"1744", yer:"Dir'iye, Necid", kisiler:"Muhammed b. Suûd, Muhammed b. Abdülvehhâb", d:"Uyeyne'den sürülen âlim Muhammed b. Abdülvehhâb'ı Dir'iye'de himayesine alan emîr Muhammed b. Suûd, onunla siyasî otoriteyi dinî davetin hizmetine sunan bir ittifak kurdu. Bu anlaşma Suûd ailesi için yeni bir tarih başlattı ve Necid'in dağınık vaha emirliklerini tek bir hareket etrafında birleştirdi. Yarım yüzyıl içinde Kerbelâ, Mekke ve Medine'ye uzanacak olan bu güç, Osmanlı Devleti'ni Hicaz'daki hâkimiyetini savunmak zorunda bırakacaktı.", kaynak:"suudiler", duygu:["🏛"], yer_id:"Dir'iye (Necid)" },
 { t:"1746-09-04", k:"antlasma", etiket:["antlasma","diplomasi","konu-diplomasi"], b:"Kerden Antlaşması — Osmanlı-İran savaşlarının sonu", gun:"4 Eylül 1746", yer:"Kerden, Kazvin yakınları", kisiler:"I. Mahmud, Nâdir Şah, Nazif Mustafa Efendi", d:"Dört yıl süren son savaşın ardından imzalanan antlaşmayla 1639 Kasr-ı Şîrin sınırı aynen yenilendi; iki taraf da toprak kazancı elde edemedi. Nâdir Şah'ın Ca'ferîliğin beşinci mezhep olarak tanınması yönündeki ısrarlı talebi karşılıksız kaldı, buna karşılık İran hacılarının serbestçe hac yapmasına ve karşılıklı elçi teatisine karar verildi. İki asrı aşan Osmanlı-İran savaşları böylece fiilen kapandı; bu sınır bugüne kadar büyük ölçüde korunmuştur.", kaynak:"osmanlilar", duygu:["🤝"], yer_kon:[36.2797,50.0049] },
@@ -304,7 +304,7 @@ window.OLAYLAR_EK5 = [
 { t:"1790-01-31", k:"antlasma", etiket:["ittifak","antlasma","diplomasi","konu-diplomasi"], b:"Osmanlı-Prusya İttifakı", gun:"31 Ocak 1790", yer:"İstanbul", yer_id:"İstanbul", kisiler:"III. Selim, Koca Yûsuf Paşa, Heinrich von Diez", d:"Tahta çıkar çıkmaz Avrupa'da müttefik arayan III. Selim, Prusya ile karşılıklı yardım öngören bir ittifak antlaşması imzaladı; Prusya Rusya ve Avusturya'ya savaş açmayı, Osmanlı Devleti de Kırım geri alınmadan barış yapmamayı taahhüt etti. Bu, Osmanlı tarihinde bir Avrupa devletiyle imzalanan ilk gerçek karşılıklı ittifak metniydi ve klasik 'küffârla ittifak olmaz' anlayışının terk edildiğini gösteriyordu. Prusya savaşa girmedi, ancak Avusturya'yı barışa zorlayarak Ziştovi Antlaşması'nın önünü açtı.", kaynak:"selim-iii", duygu:["🤝"] },
 { t:"1790-12-22", k:"kayip", etiket:["savas","toprak-kayip","konu-askeri"], b:"İsmail Kalesi'nin düşüşü ve katliamı", gun:"22 Aralık 1790", yer:"İsmail, Tuna deltası", kisiler:"Aydoslu Mehmed Paşa, General Suvorov", d:"Tuna deltasının en güçlü istihkâmı sayılan İsmail Kalesi, General Suvorov'un düzenlediği kanlı bir genel hücumla bir günde ele geçirildi; garnizon ve şehir halkı büyük ölçüde kılıçtan geçirildi. Avrupa'da geniş yankı uyandıran bu katliam, Osmanlı kamuoyunda derin bir şok yarattı ve Tuna savunma hattının bel kemiğini kırdı. Kale, bir yıl sonra Yaş Antlaşması'yla geri alınacak, ancak savaşın kaderi çoktan belirlenmiş olacaktı.", kaynak:"osmanlilar", duygu:["😢","😔","😠"], yer_id:"İsmail" },
 { t:"1791-08-04", k:"antlasma", etiket:["antlasma","diplomasi","konu-diplomasi"], b:"Ziştovi Antlaşması — Avusturya cephesinin kapanması", gun:"4 Ağustos 1791", yer:"Ziştovi, Tuna boyu", kisiler:"III. Selim, II. Leopold, Prusya arabuluculuğu", d:"Prusya'nın baskısı ve Fransız İhtilâli'nin Avusturya'yı batıda meşgul etmesi sayesinde, iki devlet savaş öncesi sınırlar esas alınarak barışa vardı. Avusturya işgal ettiği Belgrad dahil bütün yerleri geri verdi; Osmanlı Devleti yalnızca Hırvatistan sınırında küçük düzeltmeler kabul etti. Batı cephesinin bu şartlarla kapanması, Osmanlı Devleti'nin bütün gücünü Rusya'ya karşı toplamasını sağladı ve Yaş Antlaşması'ndaki kaybı sınırladı.", kaynak:"zistovi-antlasmasi", duygu:["🤝"], yer_kon:[43.617,25.35] },
-{ t:"1792-01-10", k:"antlasma", etiket:["antlasma","toprak-kayip","diplomasi","konu-askeri","konu-diplomasi"], b:"Yaş Antlaşması — Kırım'ın kesin kaybı ve Turla sınırı", gun:"10 Ocak 1792", yer:"Yaş (Iaşi), Boğdan", kisiler:"III. Selim, Prens Potemkin, Bezborodko", d:"Beş yıllık savaşın sonunda imzalanan antlaşmayla Turla (Dinyester) nehri sınır kabul edildi; nehrin sol yakası Rusya'ya, sağ yakası Osmanlı'ya kaldı ve Özi ile çevresi kesin olarak elden çıktı. Osmanlı Devleti Kırım'ı geri alma ümidini tamamen bıraktı ve 1783 ilhakını hukuken tanıdı; Eflak ile Boğdan iki yıllık vergi muafiyetiyle iade edildi. On iki milyon kuruşluk savaş tazminatı yükümlülüğü de kabul edilerek Karadeniz'in kuzeyi kalıcı biçimde Rusya'ya terk edilmiş oldu. Aynı tarihte katılan öteki yerler: İsmail.", ic_not_d:"eski ifade: Aynı tarihte haritaya katılan diğer yerleşimler:", kaynak:"yas-antlasmasi", duygu:["🤝","😔"], yer_id:"Yaş" },
+{ t:"1792-01-10", k:"antlasma", etiket:["antlasma","toprak-kayip","diplomasi","konu-askeri","konu-diplomasi"], b:"Yaş Antlaşması — Kırım'ın kesin kaybı ve Turla sınırı", gun:"10 Ocak 1792", yer:"Yaş (Iaşi), Boğdan", kisiler:"III. Selim, Prens Potemkin, Bezborodko", d:"Beş yıllık savaşın sonunda imzalanan antlaşmayla Turla (Dinyester) nehri sınır kabul edildi; nehrin sol yakası Rusya'ya, sağ yakası Osmanlı'ya kaldı ve Özi ile çevresi kesin olarak elden çıktı. Osmanlı Devleti Kırım'ı geri alma ümidini tamamen bıraktı ve 1783 ilhakını hukuken tanıdı; Eflak ile Boğdan iki yıllık vergi muafiyetiyle iade edildi. On iki milyon kuruşluk savaş tazminatı yükümlülüğü de kabul edilerek Karadeniz'in kuzeyi kalıcı biçimde Rusya'ya terk edilmiş oldu. Aynı tarihte katılan öteki yerler: İsmail.", ic_not_d:"eski ifade: Aynı tarihte haritaya katılan diğer yerleşimler:", kaynak:"yas-antlasmasi", duygu:["🤝","😔"], yer_id:"Hacıbey (Odessa)" },
 { t:"1795-03-01", k:"isyan", etiket:["isyan","siyaset","konu-siyasi","konu-isyan"], b:"Pazvandoğlu Osman'ın Vidin'de fiilî hükümdarlığı", gun:"1795", yer:"Vidin, Tuna boyu", kisiler:"Pazvandoğlu Osman, III. Selim, Küçük Hüseyin Paşa", d:"Nizâm-ı Cedîd düzenlemelerine karşı ayaklanan Pazvandoğlu Osman, Vidin valisini kaçırtarak şehri ele geçirdi ve Tuna boyunca derin hendeklerle tahkim etti. 1797'de gücünün zirvesinde seksen bine yakın kuvvet toplayarak Niğbolu, Ziştovi, Rusçuk, Sofya ve Niş'i denetimine aldı; kendisini âsi değil ıslahatçı olarak takdim etti. Bâbıâli'nin 1798-1799'da aylarca süren kuşatması sonuçsuz kaldı ve o 1807'deki ölümüne kadar Kuzey Bulgaristan'da yarı bağımsız hüküm sürdü.", kaynak:"pazvandoglu-osman", duygu:["✊"], yer_id:"Vidin" },
 { t:"1795-09-01", kesinlik:"ay", k:"bilim", etiket:["bilim","siyaset","konu-siyasi","konu-bilim"], b:"Mühendishâne-i Berrî-i Hümâyun'un açılışı", gun:"Safer 1210 / Eylül 1795", yer:"Hasköy, İstanbul", kisiler:"III. Selim, Hüseyin Rıfkı Tamânî, Mustafa Reşid", d:"Nizâm-ı Cedîd ordusuna topçu, istihkâm ve haritacı subay yetiştirmek üzere Hasköy'de kara mühendishânesi açıldı; 1773'te kurulan Bahriye Mühendishânesi'nin kara ordusundaki karşılığıydı. Programda cebir, hendese, mekanik, istihkâm ve balistik okutuldu, Avrupa dillerinden matematik ve topçuluk kitapları tercüme edildi. Türkiye'de modern mühendislik eğitiminin kökü sayılan bu okul, günümüz İstanbul Teknik Üniversitesi'nin başlangıcı kabul edilir.", kaynak:"muhendishane-i-berri-i-humayun — TDV gövdesi birebir: 'Mühendis yetiştirmek üzere 1795 yılında açılan mektep.' · '5 Zilhicce 1207'de (14 Temmuz 1793) başlanmış ve Safer 1210'da (Eylül 1795) tamamlanmıştır.' · '1210'da (1795) Hasköy'de açılmıştır.' ⇒ kaynak HAZİRAN DEMİYOR; eski t:\"1795-06-15\" kaynaksızdı (KRONO-EKSIK-0921, 21 Eylül 2026, 1.MURAT hükmü M-4911a)", ic_not_gun:"🔴 GÜN DÜZELTMESİ — 21 Eylül 2026, KRONO-EKSIK-0921, 1.MURAT hükmü M-4911(a). Eski kayıt t:\"1795-06-15\" (gün hassasiyeti) ama kendi gun: alanı yalnız \"1795\" diyordu — sahte kesinlik (D210). TDV muhendishane-i-berri-i-humayun gövdesi açılış için GÜN VERMEZ; verdiği en ince değer bina için Safer 1210 = Eylül 1795'tir. ⇒ t ayın 1'ine çekildi ve hassasiyet AÇIKLAYAN alandan okunsun diye kesinlik:\"ay\" yazıldı (D213: YYYY-MM-01 biçimi 'ayın 1'i' ile 'ay biliniyor'u kendi başına ayırt edemez). İnşaatın BAŞLANGICI ayrı maddedir (olaylar_ek14.js, t:\"1793-07-14\", 5 Zilhicce 1207). Taşımadan önce \"1795-06-15\" kalıbı bütün data/ · js/ · arac/ altında tarandı: 4 yer bulundu — bu kayıt, data/yer_yama.js anahtarı (birlikte güncellendi) ve iki YORUM satırı. EK OKUMA bağı YOKTU: ekokuma_kurum2.js kartları 1795-01-01'e bağlı, 1795-06-15'e değil.", duygu:["🔬"], yer_id:"İstanbul" },
 { t:"1798-09-09", kesinlik:"gun", k:"savas", etiket:["savas","ittifak","diplomasi","konu-askeri","konu-diplomasi"], b:"Fransa'ya savaş ilanı ve Rusya-İngiltere ile ittifak", gun:"9 Eylül 1798 (gün: Azmi Süslü, \"Osmanlı-Fransız Diplomatik İlişkileri, 1798-1807\", TTK Belleten XLVII/185, 1983)", ic_not_gun:"19 Eylül 2026 EKO-DENIZ-0069: eski t 1798-09-03, kaynak:'misir' — TDV misir gövdesinde bu gün BULUNAMADI. TDV yusuf-ziya-pasa: 'Fransa'nın Mısır'a saldırısı ve savaş ilânı üzerine (Eylül 1798)' (ay). Gün Belleten makalesinden: '9 Eylülde Fransa'ya resmen savaş ilân ederek, Fransız Maslahatgüzarı Rulfin'i Yedikule zindanlarına attırdı (12 Eylül)' — makale TDV fransa kaynakçasında. İttifaklar ayrı günlerdedir (TDV selim-iii/ingiltere/rusya: Ocak 1799); b/d ikisini birlikte anlatıyor.", yer:"İstanbul", yer_id:"İstanbul", kisiler:"III. Selim, Napolyon Bonapart, Rus ve İngiliz elçileri", d:"Napolyon'un Mısır'ı işgali üzerine Osmanlı Devleti, iki buçuk asırlık geleneksel Fransız dostluğunu bozarak Fransa'ya savaş ilân etti. Aynı süreçte tarihinde ilk defa Rusya ile ittifak yaptı ve Rus donanmasının Boğazlar'dan geçerek Akdeniz'e çıkmasına izin verdi; ardından İngiltere ile de ittifak imzalandı. Bu ittifaklar sayesinde İyon adaları Fransızlardan alındı, ancak Boğazlar'ın bir yabancı donanmaya açılması ileride ağır bedeli olan bir emsal oluşturdu.", kaynak:"yusuf-ziya-pasa", duygu:["⚔️"] },
@@ -377,7 +377,7 @@ window.OLAYLAR_EK5 = [
 { t:"1853-11-11", k:"savas", etiket:["savas","konu-askeri"], b:"Oltenitsa Zaferi: Tuna cephesinde ilk Osmanlı başarısı", gun:"11 Kasım 1853", yer:"Oltenitsa, Eflak (Tuna boyu)", kisiler:"Ömer Lütfi Paşa", d:"Kırım Savaşı'nın açılış safhasında Serdâr-ı Ekrem Ömer Lütfi Paşa, Tuna'yı geçerek Oltenitsa'da Rus kuvvetlerini ağır kayıplarla püskürttü. Zafer, savaşın hemen başında Rus ilerleyişini durdurarak Osmanlı ordusunun Tanzimat sonrası eğitimle kazandığı gücü Avrupa'ya gösterdi. Bu başarı İngiltere ve Fransa'nın Osmanlı yanında savaşa girme kararını kolaylaştıran psikolojik zemini hazırladı.", kaynak:"osmanlilar", duygu:["⚔️"], yer_kon:[44.09,26.64] },
 { t:"1854-03-12", k:"antlasma", etiket:["ittifak","diplomasi","savas","konu-askeri","konu-diplomasi"], b:"İstanbul'da İngiltere ve Fransa ile ittifak antlaşması", gun:"12 Mart 1854", yer:"İstanbul", yer_id:"İstanbul", kisiler:"Abdülmecid, Lord Stratford Canning, Baraguey d'Hilliers", d:"Kırım Savaşı'nda Rusya'ya karşı Osmanlı Devleti ile İngiltere ve Fransa arasında imzalanan ittifak antlaşması, üç devletin ortak harekât yürütmesini ve müttefiklerin savaş bitmeden ayrı barış yapmamasını hükme bağladı. Böylece Osmanlı Devleti tarihinde ilk kez büyük Avrupa devletleriyle eşit taraf sıfatıyla askerî bir ittifaka girdi. Bu antlaşma, iki yıl sonra Paris'te Osmanlı'nın Avrupa devletler sistemine resmen kabulünün de hukukî zeminini oluşturdu.", kaynak:"osmanlilar", duygu:["🤝"] },
 { t:"1855-08-16", k:"siyaset", etiket:["siyaset","diger","islahat","konu-siyasi","konu-islahat"], b:"İstanbul Şehremaneti'nin kurulması: ilk modern belediye teşkilatı", gun:"16 Ağustos 1855", yer:"İstanbul", yer_id:"İstanbul", kisiler:"Abdülmecid, Salih Paşa", d:"Kırım Savaşı sırasında İstanbul'a yığılan müttefik askerleri ve artan nüfusun doğurduğu altyapı krizi, kadılık merkezli klasik şehir idaresinin yetersizliğini açığa çıkardı. Avrupa örneklerine göre kurulan Şehremaneti ile temizlik, narh, çarşı denetimi ve imar işleri tek elde toplandı; ertesi yıl Beyoğlu-Galata'da Altıncı Daire-i Belediye pilot bölge olarak teşkil edildi. Bu adım Osmanlı'da modern belediyeciliğin başlangıcı kabul edilir.", kaynak:"sehremaneti", duygu:["🏛"] },
-{ t:"1856-03-30", k:"antlasma", etiket:["antlasma","diplomasi","konu-diplomasi"], b:"Paris Antlaşması: Kırım Savaşı'nın sonu ve Osmanlı'nın Avrupa devletler sistemine kabulü", gun:"30 Mart 1856", yer:"Paris, İsmail, Kahul, Bolgrad (Güney Besarabya)", yer_id:"Paris", kisiler:"Âlî Paşa, III. Napolyon, Lord Clarendon", d:"Kırım Savaşı'nı bitiren Paris Antlaşması ile Osmanlı Devleti Avrupa devletler hukukunun eşit üyesi ilan edildi ve toprak bütünlüğü büyük devletlerin ortak garantisine alındı. Karadeniz tarafsızlaştırıldı, Rusya'nın Küçük Kaynarca'dan beri elde ettiği Ortodoks tebaa üzerindeki himaye iddiası geçersiz kılındı, Besarabya'nın güneyi Boğdan'a verildi. Ancak aynı antlaşma Islahat Fermanı'nı uluslararası bir taahhüt hâline getirerek iç işlere müdahalenin de kapısını araladı.", kaynak:"paris-antlasmasi", duygu:["🤝"] },
+{ t:"1856-03-30", k:"antlasma", etiket:["antlasma","diplomasi","konu-diplomasi"], b:"Paris Antlaşması: Kırım Savaşı'nın sonu ve Osmanlı'nın Avrupa devletler sistemine kabulü", gun:"30 Mart 1856", yer:"Paris, İsmail, Kahul, Bolgrad (Güney Besarabya)", yer_id:"İsmail", kisiler:"Âlî Paşa, III. Napolyon, Lord Clarendon", d:"Kırım Savaşı'nı bitiren Paris Antlaşması ile Osmanlı Devleti Avrupa devletler hukukunun eşit üyesi ilan edildi ve toprak bütünlüğü büyük devletlerin ortak garantisine alındı. Karadeniz tarafsızlaştırıldı, Rusya'nın Küçük Kaynarca'dan beri elde ettiği Ortodoks tebaa üzerindeki himaye iddiası geçersiz kılındı, Besarabya'nın güneyi Boğdan'a verildi. Ancak aynı antlaşma Islahat Fermanı'nı uluslararası bir taahhüt hâline getirerek iç işlere müdahalenin de kapısını araladı.", kaynak:"paris-antlasmasi", duygu:["🤝"] },
 { t:"1856-06-07", k:"kultur", etiket:["kultur","siyaset","konu-siyasi","konu-kultur","konu-imar"], b:"Dolmabahçe Sarayı'nın açılışı: idare merkezinin Topkapı'dan taşınması", gun:"7 Haziran 1856", yer:"İstanbul, Dolmabahçe", kisiler:"Abdülmecid, Garabet Balyan, Nikoğos Balyan", d:"Abdülmecid'in 1842'de Balyan ailesine sipariş ettiği saray, on dört yıllık inşaatın ardından açıldı ve devletin idare merkezi dört asırlık Topkapı'dan Boğaz kıyısına taşındı. Avrupaî üslûbu, kristal merdiveni ve Muayede Salonu ile saray, Tanzimat'ın Batılılaşma iddiasının taştan ifadesi oldu. Muazzam maliyeti ise Osmanlı maliyesinin dış borçlanma sarmalına girdiği yılların en çok eleştirilen kalemlerinden biri hâline geldi.", kaynak:"dolmabahce-sarayi", duygu:["🎨"], yer_id:"İstanbul" },
 { t:"1859-01-24", k:"kayip", etiket:["toprak-kayip","siyaset","konu-askeri","konu-siyasi"], b:"Eflak ve Boğdan'ın Cuza yönetiminde birleşmesi: Romanya'nın doğuşu", gun:"24 Ocak 1859", yer:"Bükreş ve Yaş (Eflak-Boğdan)", kisiler:"Alexandru Ioan Cuza", d:"Paris Antlaşması sonrası düzenlenen seçimlerde iki prenslik de Albay Alexandru Ioan Cuza'yı voyvoda seçerek fiilî birleşmeyi gerçekleştirdi. Bâbıâli ve Avusturya buna karşı çıktıysa da Fransa'nın desteklediği oldubitti kabul edilmek zorunda kalındı. Kâğıt üzerinde Osmanlı'ya bağlı kalan bu birlik 1862'de Romanya adını alacak, 1877'de tek taraflı bağımsızlığını ilan edecekti; Tuna boyundaki Osmanlı hâkimiyetinin çözülüşünde dönüm noktasıdır.", kaynak:"eflak", duygu:["😔"], yer_id:"Bükreş" },
 { t:"1859-09-14", k:"isyan", etiket:["isyan","siyaset","darbe-askeri","konu-siyasi","konu-isyan","konu-darbe"], b:"Kuleli Vak'ası: İstanbul'da Abdülmecid'e karşı ilk darbe girişimi", gun:"14 Eylül 1859", yer:"İstanbul (Kılıç Ali Paşa Camii, Kuleli Kışlası)", kisiler:"Abdülmecid, Şeyh Ahmed, Hüseyin Dâim Paşa", d:"Tanzimat siyasetine ve Islahat Fermanı'nın gayrimüslimlere tanıdığı eşitliğe tepki duyan asker-sivil karışımı gizli bir cemiyet, padişahı tahttan indirmeyi planlarken Kılıç Ali Paşa Camii'ndeki toplantı hâlinde basıldı. Sanıklar Kuleli Kışlası'nda yargılandığı için olay bu adla anıldı; ölüm cezaları sürgüne çevrildi. Osmanlı tarihinde ideolojik gerekçeyle kurulmuş bir örgütün giriştiği ilk saray darbesi teşebbüsü olarak kabul edilir.", kaynak:"kuleli-vakasi", duygu:["✊"], yer_id:"İstanbul" },
@@ -408,7 +408,7 @@ window.OLAYLAR_EK5 = [
 { t:"1878-01-04", k:"kayip", etiket:["toprak-kayip","savas","konu-askeri"], b:"Sofya'nın Rus kuvvetlerince işgali", gun:"3 Ocak 1878", ic_not_gun:"eski gun: 3 Ocak 1878 (TDV) — kayıttaki tarih 4 Ocak, bir gün fark", yer:"Sofya", yer_id:"Sofya", kisiler:"General Gurko, II. Abdülhamid", d:"Plevne'nin düşüşünden sonra Balkanlar'ı aşan Rus ordusu, savunmasız kalan Sofya'ya girdi. Şehir bir daha Osmanlı idaresine dönmeyecek, 1878 sonunda özerk Bulgaristan Prensliği'nin, 1879'da fiilen başşehri olacaktı. Haritada Sofya bu tarihten itibaren Osmanlı doğrudan idaresinden çıkıp geçici Rus işgaline, ardından özerk Bulgar yönetimine geçer.", statu_vasal:["Sofya"], kaynak:"sofya", duygu:["😔"] },
 { t:"1878-01-31", k:"antlasma", etiket:["antlasma","savas","konu-askeri","konu-diplomasi"], b:"Edirne Mütarekesi: 93 Harbi'nde silahların susması", gun:"31 Ocak 1878", yer:"Edirne", yer_id:"Edirne", kisiler:"Namık Paşa, Server Paşa, Grandük Nikolay", d:"Sofya, Filibe ve Edirne'nin peş peşe düşmesi ve Rus ordusunun Marmara kıyılarına dayanması üzerine Bâbıâli mütareke istemek zorunda kaldı. Edirne'de imzalanan ateşkes, Bulgaristan'a özerklik, Karadağ-Sırbistan-Romanya'nın bağımsızlığı ve ağır savaş tazminatı gibi ön barış şartlarını Osmanlı'ya kabul ettirdi. Bu şartlar bir ay sonra Ayastefanos'ta antlaşma metnine dönüşecekti.", kaynak:"ayastefanos-antlasmasi", duygu:["🤝"] },
 { t:"1878-02-13", k:"siyaset", etiket:["siyaset","konu-siyasi"], b:"II. Abdülhamid'in Meclis-i Meb'ûsan'ı süresiz tatil etmesi", gun:"13 Şubat 1878", yer:"İstanbul", yer_id:"İstanbul", kisiler:"II. Abdülhamid, Astarcılar Kethüdâsı Ahmed Efendi", d:"Savaşın felaketle sonuçlanmasından hükümeti ve sarayı sorumlu tutan mebusların sert eleştirileri üzerine II. Abdülhamid, Kanûn-ı Esâsî'nin kendisine tanıdığı yetkiye dayanarak meclisi süresiz tatil etti. Yaklaşık on bir ay çalışan ilk Osmanlı parlamentosu böylece kapandı ve otuz yıl sürecek istibdat devri başladı. Meclis ancak 1908 İhtilâli'nden sonra yeniden toplanabilecekti.", kaynak:"meclis-i-mebusan", duygu:["🏛"] },
-{ t:"1878-03-03", k:"antlasma", etiket:["antlasma","konu-diplomasi"], b:"Ayastefanos Antlaşması: Büyük Bulgaristan tasarısı", gun:"3 Mart 1878", yer:"Ayastefanos (Yeşilköy), İstanbul", kisiler:"Safvet Paşa, Sadullah Bey, Kont İgnatyev", d:"93 Harbi'ni bitiren Ayastefanos Antlaşması, Ege'ye kadar uzanan ve Makedonya'yı içine alan devasa bir özerk Bulgaristan kuruyor; Sırbistan, Karadağ ve Romanya'nın bağımsızlığını tanıyor; Kars, Ardahan, Batum ve Doğubayazıt'ı Rusya'ya bırakıyor, ayrıca ödenmesi imkânsız bir savaş tazminatı yüklüyordu. Rusya'yı Akdeniz'e indiren bu metin İngiltere ve Avusturya'nın şiddetli tepkisini çekti. Uygulanmadan dört ay içinde Berlin Kongresi'yle yeniden düzenlendi; yine de Osmanlı Rumelisi'nin sonunu ilan eden belge olarak kaldı.", kaynak:"ayastefanos-antlasmasi", duygu:["🤝"], yer_id:"İstanbul" },
+{ t:"1878-03-03", k:"antlasma", etiket:["antlasma","konu-diplomasi"], b:"Ayastefanos Antlaşması: Büyük Bulgaristan tasarısı", gun:"3 Mart 1878", yer:"Ayastefanos (Yeşilköy), İstanbul", kisiler:"Safvet Paşa, Sadullah Bey, Kont İgnatyev", d:"93 Harbi'ni bitiren Ayastefanos Antlaşması, Ege'ye kadar uzanan ve Makedonya'yı içine alan devasa bir özerk Bulgaristan kuruyor; Sırbistan, Karadağ ve Romanya'nın bağımsızlığını tanıyor; Kars, Ardahan, Batum ve Doğubayazıt'ı Rusya'ya bırakıyor, ayrıca ödenmesi imkânsız bir savaş tazminatı yüklüyordu. Rusya'yı Akdeniz'e indiren bu metin İngiltere ve Avusturya'nın şiddetli tepkisini çekti. Uygulanmadan dört ay içinde Berlin Kongresi'yle yeniden düzenlendi; yine de Osmanlı Rumelisi'nin sonunu ilan eden belge olarak kaldı.", kaynak:"ayastefanos-antlasmasi", duygu:["🤝"], yer_id:"Kars" },
 { t:"1878-07-29", k:"kayip", etiket:["toprak-kayip","savas","konu-askeri"], b:"Bosna-Hersek ve Yenipazar'ın Avusturya-Macaristan tarafından işgali", gun:"29 Temmuz 1878", yer:"Saraybosna, Mostar, Yenipazar", kisiler:"Josip Filipović, Hacı Loyo, II. Abdülhamid", d:"Berlin Antlaşması'nın verdiği yetkiye dayanarak Avusturya-Macaristan orduları Bosna'ya girdi; Osmanlı hükümeti direnmemeyi kabul etmesine rağmen Saraybosna ve Mostar'daki yerli Müslüman-Ortodoks halk silaha sarılarak üç ay boyunca çetin bir mukavemet gösterdi. İşgal ancak 20 Ekim 1878'de tamamlanabildi. Padişahın hukukî hükümranlığı 1908'e kadar kâğıt üzerinde sürdü, ancak dört asırlık Osmanlı Bosnası fiilen elden çıktı ve büyük bir Müslüman göç dalgası başladı. Aynı tarihte elden çıkan diğer yerleşimler: Banaluka.", kaynak:"bosna-hersek", duygu:["😔"], yer_id:"Saraybosna" },
 { t:"1881-12-20", k:"siyaset", etiket:["ekonomi","siyaset","diplomasi","konu-siyasi","konu-diplomasi","konu-ekonomi"], b:"Muharrem Kararnâmesi ve Düyûn-ı Umûmiyye İdaresi'nin kuruluşu", gun:"20 Aralık 1881", yer:"İstanbul", yer_id:"İstanbul", kisiler:"II. Abdülhamid, Server Paşa", d:"1875 iflasından sonra alacaklı devletlerin temsilcileriyle yürütülen görüşmeler, 28 Muharrem 1299 (20 Aralık 1881) tarihli kararnâmeyle sonuçlandı: borç anaparası yarıdan fazla indirildi, buna karşılık tuz, tütün, ipek, damga ve balık resimleri gibi en verimli gelir kalemleri doğrudan alacaklıların yönettiği Düyûn-ı Umûmiyye İdaresi'ne devredildi. Binlerce memur çalıştıran bu idare, devlet içinde ayrı bir maliye teşkilatına dönüştü. Osmanlı malî bağımsızlığının fiilen sona erdiği tarih kabul edilir.", kaynak:"duyun-i-umumiyye", duygu:["🏛"] },
 { t:"1884-02-01", k:"diger", etiket:["savas","siyaset","konu-askeri","konu-siyasi"], b:"Sevâkin — Mehdî'ye düşmeyen tek liman", gun:"Şubat 1884", yer:"Sevâkin, Habeş kıyısı", kisiler:"Muhammed Ahmed el-Mehdî, General Gerald Graham", d:"1884 Şubatından itibaren Sevâkin dışındaki bütün doğu Sudan bölgeleri Muhammed Ahmed el-Mehdî'nin hâkimiyetine geçerken, liman General Graham kumandasındaki üç taburluk İngiliz kuvvetinin askerî korumasıyla ayakta kaldı. Bu, fiilî ile hukukî durumun ayrıştığı bir dönemin başlangıcıydı: kıyı fiilen İngiliz askerî denetiminde olsa da idarî bağı 1885'te Mısır'dan alınıp doğrudan Yemen vilâyetine, yani Bâbıâli'ye bağlanacaktı — o düzen 1888'de Fransa'nın Zeylâ'yı işgaliyle sona erene kadar sürdü.", kaynak:"muhammed-ahmed-el-mehdi", duygu:["📌"], yer_id:"Sevâkin" },
@@ -432,11 +432,11 @@ window.OLAYLAR_EK5 = [
 { t:"1908-12-17", k:"siyaset", etiket:["siyaset","konu-siyasi","konu-islahat"], b:"II. Meşrutiyet'in ilk Meclis-i Meb'ûsan'ının toplanması", gun:"17 Aralık 1908", yer:"İstanbul", yer_id:"İstanbul", kisiler:"II. Abdülhamid, Ahmed Rızâ Bey", d:"Otuz yıllık aradan sonra yapılan iki dereceli seçimlerle oluşan meclis, 17 Aralık 1908'de padişahın nutkuyla açıldı ve başkanlığına Jön Türk hareketinin lideri Ahmed Rızâ Bey seçildi. Türk, Arap, Arnavut, Rum, Ermeni ve Yahudi mebuslardan oluşan meclis Osmanlıcılık idealinin son büyük denemesiydi. Ancak Bulgaristan'ın bağımsızlığı, Bosna'nın ilhakı ve Girit'in Yunanistan'a katılma ilanı, meclis daha açılmadan bu iyimserliği gölgelemişti.", kaynak:"meclis-i-mebusan", duygu:["🏛"] },
 { t:"1909-04-27", k:"siyaset", etiket:["siyaset","isyan","darbe-askeri","konu-siyasi","konu-isyan","konu-darbe","konu-hanedan"], b:"Hareket Ordusu ve II. Abdülhamid'in hal'i: V. Mehmed Reşad'ın cülûsu", gun:"27 Nisan 1909", yer:"İstanbul (Yeşilköy, Yıldız Sarayı)", kisiler:"II. Abdülhamid, Mahmud Şevket Paşa, Hüseyin Hüsnü Paşa, V. Mehmed Reşad", d:"31 Mart Vak'ası üzerine Selanik'ten yola çıkan Hareket Ordusu 22-23 Nisan gecesi dört koldan İstanbul'a girdi ve 24 Nisan'da Yıldız Sarayı teslim oldu. Meclis-i Umûmî-i Millî 27 Nisan'da II. Abdülhamid'in hal'ine karar verdi; padişah Selanik'e gönderildi, yerine kardeşi V. Mehmed Reşad tahta çıkarıldı. Otuz üç yıllık şahsî idare böylece sona erdi, ancak yerini padişahın sembolleştiği ve İttihat ve Terakkî'nin ordu desteğiyle yönettiği yeni bir dönem aldı.", kaynak:"hareket-ordusu", duygu:["🏛"], yer_id:"İstanbul" },
 { t:"1910-04-01", k:"isyan", etiket:["isyan","savas","konu-askeri","konu-isyan"], b:"Arnavutluk İsyanı: Kosova ve İşkodra'da silahlı direniş", odak_yer:["İşkodra","Priştine","Üsküp"], gun:"1910", yer:"Kosova, İşkodra, Priştine, Üsküp", kisiler:"Mahmud Şevket Paşa, Turhan Paşa, İsmâil Kemal", d:"İttihatçı hükümetin merkeziyetçi vergi politikası, silah toplama kampanyası ve Latin alfabesi tartışması, o güne kadar devlete en sadık unsurlardan sayılan Arnavut aşiretlerini ayaklandırdı. Mahmud Şevket Paşa kumandasındaki ordu isyanı sert biçimde bastırdıysa da huzursuzluk 1911 ve 1912'de yeniden alevlendi. Bu isyanlar Osmanlı ordusunu Balkan Savaşı arifesinde yıprattığı gibi Arnavut millî hareketinin de doğuşunu hızlandırdı.", kaynak:"arnavutluk", duygu:["✊"], kapsam_genis:true },
-{ t:"1912-10-18", k:"kayip", etiket:["antlasma","toprak-kayip","konu-askeri","konu-diplomasi"], b:"Uşi Antlaşması: Trablusgarp ve Bingazi'nin İtalya'ya terki", gun:"18 Ekim 1912 (15 Ekim tarihli belge muhtariyet iradesidir — TDV trablusgarp-savasi)", yer:"Uşi (Ouchy), Lozan / Trablusgarp, Bingazi", kisiler:"Mehmed Nâbi Bey, Rumbeyoğlu Fahreddin Bey, Giuseppe Volpi", d:"Balkan devletlerinin savaş hazırlığı karşısında iki cepheli çatışmayı göze alamayan Bâbıâli, İsviçre'nin Uşi kasabasında İtalya ile gizli barış imzalayarak Trablusgarp ve Bingazi'yi terk etti. Osmanlı Devleti Afrika'daki son toprağını böylece kaybetti; buna karşılık İtalya'nın işgal ettiği Rodos ve On İki Ada'nın iadesi vaat edildiyse de bu vaat hiç yerine getirilmedi. Antlaşma imzalandığında Balkan Savaşı çoktan başlamıştı.", kaynak:"trablusgarp", duygu:["😔"], yer_id:"Lozan" },
+{ t:"1912-10-18", k:"kayip", etiket:["antlasma","toprak-kayip","konu-askeri","konu-diplomasi"], b:"Uşi Antlaşması: Trablusgarp ve Bingazi'nin İtalya'ya terki", gun:"18 Ekim 1912 (15 Ekim tarihli belge muhtariyet iradesidir — TDV trablusgarp-savasi)", yer:"Uşi (Ouchy), Lozan / Trablusgarp, Bingazi", kisiler:"Mehmed Nâbi Bey, Rumbeyoğlu Fahreddin Bey, Giuseppe Volpi", d:"Balkan devletlerinin savaş hazırlığı karşısında iki cepheli çatışmayı göze alamayan Bâbıâli, İsviçre'nin Uşi kasabasında İtalya ile gizli barış imzalayarak Trablusgarp ve Bingazi'yi terk etti. Osmanlı Devleti Afrika'daki son toprağını böylece kaybetti; buna karşılık İtalya'nın işgal ettiği Rodos ve On İki Ada'nın iadesi vaat edildiyse de bu vaat hiç yerine getirilmedi. Antlaşma imzalandığında Balkan Savaşı çoktan başlamıştı.", kaynak:"trablusgarp", duygu:["😔"], yer_id:"Trablus" },
 { t:"1913-06-11", k:"siyaset", etiket:["siyaset","suikast","konu-siyasi","konu-kisiler","konu-burokrasi"], b:"Sadrazam Mahmud Şevket Paşa'nın İstanbul'da suikastle öldürülmesi", gun:"11 Haziran 1913", yer:"İstanbul, Çarşıkapı", kisiler:"Mahmud Şevket Paşa, Talat Bey, Enver Bey", d:"Bâb-ı Âli Baskını'ndan sonra sadrazamlığa getirilen Mahmud Şevket Paşa, Harbiye Nezâreti'ne giderken Çarşıkapı yakınında arabasına açılan ateşle öldürüldü. İttihat ve Terakkî suikastı muhalefetin üzerine yıkarak geniş bir tevkif ve idam dalgası başlattı, Hürriyet ve İtilâf Fırkası fiilen tasfiye edildi. Bu olayla birlikte İttihatçıların Enver-Talat-Cemal üçlüsüne dayanan tek parti diktatörlüğü kesin biçimde kuruldu.", kaynak:"mahmud-sevket-pasa", duygu:["🏛"], yer_id:"İstanbul" },
 { t:"1913-06-29", k:"savas", etiket:["savas","toprak-kazanc","konu-askeri"], b:"II. Balkan Savaşı'nın başlaması: müttefiklerin paylaşım kavgası", odak_yer:["Edirne"], gun:"29 Haziran 1913", yer:"Makedonya, Trakya", kisiler:"Enver Bey, Çar Ferdinand", d:"Londra Antlaşması ile Osmanlı'dan aldıkları toprakları paylaşamayan Balkan müttefikleri birbirine düştü; Bulgaristan'ın Sırp ve Yunan mevzilerine saldırmasıyla ikinci savaş başladı. Romanya ve Karadağ da Bulgaristan'a karşı cepheye girince Bulgar ordusu çöktü. Osmanlı Devleti bu fırsatı değerlendirerek Londra Antlaşması'nın çizdiği Midye-Enez hattını aştı ve Doğu Trakya'yı Edirne ile birlikte geri aldı.", kaynak:"osmanlilar", duygu:["⚔️"], kapsam_genis:true, ic_not_gun:"KAYNAK ÇELİŞKİSİ BEYANI — 23 Eylül 2026. TDV `balkan-savasi` AYNEN: 'Bulgaristan 23 Haziran 1913'te Sırbistan, Karadağ ve Yunanistan'a karşı savaşa başladı.' Britannica 'Balkan Wars' ise savaşı 29-30 Haziran 1913 gecesine, Kral Ferdinand'ın saldırı emrine bağlar ve olay kutusunda 'June 29, 1913 - August 10, 1913' yazar. İki kaynak AYNI soruya (savaş hangi gün başladı) farklı gün veriyor; 23 Haziran'a karşılık gelen ayrı bir olay arandı, bulunamadı (TDV balkan-savasi tam gövde · TDV bulgaristan · TDV bukres-antlasmasi 302 · Britannica tam gövde). Gün 1913-06-29'da BIRAKILDI — mekanizmasıyla birlikte verilen tarih tercih edildi; TDV'nin günü SİLİNMEDİ, burada kayıtlıdır." },
-{ t:"1913-09-29", k:"antlasma", etiket:["antlasma","toprak-kazanc","konu-askeri","konu-diplomasi"], b:"İstanbul Antlaşması: Bulgaristan ile barış ve Edirne'nin tescili", gun:"29 Eylül 1913", yer:"İstanbul / Edirne, Kırklareli, Dimetoka", kisiler:"Talat Bey, Halil Bey, General Savov", d:"II. Balkan Savaşı'nın ardından Osmanlı Devleti ile Bulgaristan arasında imzalanan antlaşma, Meriç nehrini sınır kabul ederek Edirne, Kırklareli, Dimetoka ve Doğu Trakya'nın Osmanlı'da kalmasını hukuken tescil etti. Kavala ve Dedeağaç Bulgaristan'da bırakıldı, iki ülke arasında karşılıklı nüfus mübadelesi ve Bulgaristan'daki Müslümanların hakları düzenlendi. Balkan felaketinden geri alınabilen tek toprak parçasının garantisi bu metindir. Aynı tarihte katılan öteki yerler: Gümülcine.", ic_not_d:"eski ifade: Aynı tarihte haritaya katılan diğer yerleşimler:", kaynak:"bulgaristan", duygu:["🤝"], yer_id:"İstanbul" },
-{ t:"1913-11-14", k:"antlasma", etiket:["antlasma","toprak-kayip","konu-askeri","konu-diplomasi"], b:"Atina Antlaşması: Yunanistan ile barış ve Selanik-Yanya'nın devri", gun:"14 Kasım 1913", yer:"Atina / Selanik, Yanya, Girit, Ege adaları", kisiler:"Galib Kemâlî Bey, Elefterios Venizelos", d:"Osmanlı Devleti ile Yunanistan arasında imzalanan antlaşma, Balkan Savaşı'nda kaybedilen Selanik, Yanya ve Güney Makedonya'nın Yunanistan'a geçişini resmen tanıdı ve Girit üzerindeki Osmanlı haklarından vazgeçildi. Yunanistan'da kalan Müslümanların din ve mülkiyet hakları, vakıfların statüsü ve müftülerin tayini ayrıntılı biçimde düzenlendi. Ege adalarının statüsü ise çözümsüz bırakılarak iki devlet arasında sürekli gerilim kaynağı olarak kaldı.", kaynak:"yunanistan", duygu:["🤝"], yer_id:"Atina" },
