+    o = s.add_parser("olc")
+    o.add_argument("--dizin", required=True)
+    o.add_argument("--bas", default="1298-01-01")
+    o.add_argument("--son", default="1335-12-31")
+    o.add_argument("--json")
+    c = s.add_parser("kiyas")
+    c.add_argument("A")
+    c.add_argument("B")
+    h = s.add_parser("hukum")
+    h.add_argument("KAPALI")
+    h.add_argument("ACIK")
