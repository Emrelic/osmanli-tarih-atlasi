+            # (ölçüldü: Alp kutusu ikinci sürüm, kalan 6 birimin 4'ü).
+            _SOL, _SAG = Polygon(), Polygon()
+            for _w in [w for w in (2.0, 5.0, 10.0, 25.0, 50.0) if w < SINIR_KISIT_KM] + [SINIR_KISIT_KM]:
+                _l, _r = _sk_tampon(_w), _sk_tampon(-_w)
