+def _sk_tabi_mi(p, a):
+    return any(f <= a < t for f, t in _SK_TABI.get(p, ()))
+
+
+def _sk_aktif_hatlar(did, a):
+    """`a` günü geçerli ve iki tarafı da tâbi OLMAYAN kısıt hatları (did taraf)."""
