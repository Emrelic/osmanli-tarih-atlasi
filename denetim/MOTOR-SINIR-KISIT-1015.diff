+def _sk_pad(s):
+    """Tarih dizgisinin yılını 4 haneye tamamlar (denetle.py `pad` ile aynı)."""
+    if not isinstance(s, str) or not s or s[0] == "-":
+        return s
+    _y, _ayr, _kal = s.partition("-")
+    if _y.isdigit() and len(_y) < 4:
+        return _y.zfill(4) + _ayr + _kal
+    return s
