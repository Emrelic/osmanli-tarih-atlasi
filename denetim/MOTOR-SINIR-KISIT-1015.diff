+        if (_say["sg"] > _say["ss"] and _say["sg"] >= 3) or (_say["gs"] > _say["gg"] and _say["gs"] >= 3):
+            _sk_atla["TERS YAKA ŞÜPHESİ"] = _sk_atla.get("TERS YAKA ŞÜPHESİ", 0) + 1
