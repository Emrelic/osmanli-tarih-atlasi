+                and not _sk_tabi_mi(L["sag_ham"], a):
+            out.append(L)
+    return out
+
+
+def _sk_karsi(L, did):
+    return L["kg"] if L["ks"] == did else L["ks"]
+
+
+def _sk_sahipler(a):
+    v = _SK_SAHIP_EZBER.get(a)
+    if v is None:
+        v = frozenset(_gun_sahipleri(a).values())
+        _SK_SAHIP_EZBER[a] = v
+    return v
