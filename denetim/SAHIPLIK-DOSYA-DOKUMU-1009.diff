+def _dk_parcalar(a):
+    """`Cibri (Güçlü)` ⇒ {cibri (guclu), cibri, guclu} — ad değişikliği adayı için."""
+    p = {_dk_norm(a)}
+    m = re.match(r"^(.*?)\s*\((.*)\)\s*$", a or "")
+    if m:
+        p |= {_dk_norm(m.group(1)), _dk_norm(m.group(2))}
+    return {x for x in p if x}
+
