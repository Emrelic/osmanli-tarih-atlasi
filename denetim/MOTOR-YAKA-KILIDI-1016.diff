+#      ZATEN kuzey yakada (güneye 3 adım da Tuna'yı kesiyor) ⇒ #7'yi (A) değil
+#      (B) üretiyor. Kilit açıkken bölme HAM petek (nehir bedelli yürüyüş
+#      ızgarası) sınırlarıyla yapılır; tohumsuz alt yüz yetim kuralına (ham
+#      hücre örtüşmesi) düşer.
+YAKA_KILIDI = os.environ.get("MOTOR_YAKA_KILIDI") == "1"
