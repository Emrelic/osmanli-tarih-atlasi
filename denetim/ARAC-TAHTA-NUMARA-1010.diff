+        soru("[%s] birleşik tahtada `teyit M-0002` · `tamam M-0001` · `kapat M-0003` (ESKİ)"
+             % kol, r1[0] == 0 and r2[0] == 0 and r3[0] == 0
+             and "KOORD" in d["M-0002"][0]["teyit"] and d["M-0001"][0]["kapanis"]
+             and d["M-0003"][0]["hal"] == "KAPANDI")
+        if not beklenen_kusur:
+            hedef = yeniB[0]
+            r4 = tahta(k["M"], "yaz", "--kim", "KOORD", "--kime", "MAKINE-B",
+                       "--mesaj", "cevap yeni numaraya", "--yanit", hedef)
