@@ -0,0 +1,396 @@
+# -*- coding: utf-8 -*-
+"""ARAC-TAHTA-NUMARA-SINAV-1010 — tahta numarası dallar arası ÇAKIŞMAZ mı? İKİ YÖNDE.
+
+KUSUR (ölçüldü, 10 Ekim 2026): `M-5891`/`M-5892` iki dalda İKİ AYRI mesaja verildi
+(origin/makine/kasa'da KASA'nın A/B teslimi ↔ origin/main'de DENETIM-OLU-ETIKET-1009).
+Sebep: `yaz` numarayı `len(kayit)+1` ile YEREL dosyadan sayar; dal makinesi main'i görmez.
+
+DÜZEN (gerçek tahtaya DOKUNMAZ): geçici dizinde bare "origin" + üç klon
+    A  → dal makine/a   (önek DALDAN: "A")
+    B  → dal makine/b   (önek `git config atlas.makine KASA`dan)
+    M  → main           (koordinatör; birleştirir)
+Her klona sınanan `tahta.py` kopyalanır; `tahta.py` yolunu kendi konumundan
+türettiği için (`KOK = arac/..`) tahta dosyası o klonun `oturumlar/tahta.json`udur.
+
+İKİ KOL, AYNI SENARYO:
+    YAMALI  → depodaki `arac/tahta.py`
+    YAMASIZ → aynı dosya, tek satır geri alınmış (`len(kayit)+1`) — kusurun kanıtı
+Senaryo: tohum M-0001..M-0003 (eski biçim; M-0002 ↩ M-0001) → A ve B EŞZAMANLI
+yazar (A: 1 mesaj + `--yanit M-0002` · B: 2 mesaj + `teyit M-0001`) → M, a'yı ve
+b'yi birleştirir → çakışma, numara anahtarlı birleşim ölçülür → eski ve yeni
+numarayla `teyit`/`tamam`/`kapat`/`--yanit`.
+
+ÇIKIŞ 0 = bütün sorular beklendiği gibi · 1 = en az bir soru tutmadı · 2 = koşulamadı
+"""
+import io
+import json
+import os
+import re
+import shutil
+import socket
+import stat
+import subprocess
+import sys
+import tempfile
+import threading
+
+try:
+    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
+except Exception:
+    pass
+
+DEPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+TAHTA_PY = os.path.join(DEPO, "arac", "tahta.py")
+TAHTA_YENI_PY = os.path.join(DEPO, "arac", "tahta_yeni.py")
+YAMA_SATIRI = "        no = _yeni_no(kayit)\n"
+ESKI_SATIR = "        no = \"M-%04d\" % (len(kayit) + 1)\n"
+
+SONUC = []
+
+
+def soru(ad, kosul, ayrinti=""):
+    SONUC.append((ad, bool(kosul)))
+    print("  %s %s%s" % ("✓" if kosul else "✗", ad, ("  — " + ayrinti) if ayrinti else ""))
+
+
+def git(kok, *a, kontrol=True):
+    r = subprocess.run(["git", "-C", kok] + list(a), capture_output=True,
+                       text=True, encoding="utf-8", errors="replace")
+    if kontrol and r.returncode != 0:
+        raise RuntimeError("git %s: %s" % (" ".join(a), (r.stderr or r.stdout)[:300]))
+    return r
+
+
+def tahta(kok, *a, env_ek=None):
+    env = dict(os.environ)
+    env.pop("ATLAS_MAKINE", None)
+    env.update(env_ek or {})
+    r = subprocess.run([sys.executable, os.path.join(kok, "arac", "tahta.py")] + list(a),
+                       capture_output=True, text=True, encoding="utf-8",
+                       errors="replace", env=env, cwd=kok)
+    return r.returncode, (r.stdout or "") + (r.stderr or "")
+
+
+def oku(kok):
+    return json.load(io.open(os.path.join(kok, "oturumlar", "tahta.json"), encoding="utf-8"))
+
+
+def kimlik(m):
+    return (m.get("kimden"), m.get("zaman"), m.get("mesaj"))
+
+
+def tohum():
+    def k(no, kimden, mesaj, yanit=""):
+        return {"no": no, "zaman": "2026-10-01 10:0%s" % no[-1], "kimden": kimden,
+                "kime": "KOORD", "kimden_kimlik": "", "mesaj": mesaj,
+                "hal": "CEVAPLANDI" if no == "M-0001" else "ACIK",
+                "cevap": "→ M-0002" if no == "M-0001" else "GEREKMEZ", "vade": "",
+                "okuyan": {}, "yanit_no": yanit, "cins": "BILGI", "teyit": {},
+                "kapanis": "", "dayanak": "", "aciliyet": "NORMAL"}
+    return [k("M-0001", "ESKI-1", "eski mesaj bir"),
+            k("M-0002", "ESKI-2", "eski mesaj iki", "M-0001"),
+            k("M-0003", "ESKI-3", "eski mesaj uc")]
+
+
+def _sil(yol):
+    def hata(f, p, _e):
+        try:
+            os.chmod(p, stat.S_IWRITE)
+            f(p)
+        except Exception:
+            pass
+    shutil.rmtree(yol, onerror=hata)
+
+
+def kur(kok, tahta_metni):
+    bare = os.path.join(kok, "origin.git")
+    git(kok, "init", "-q", "--bare", "-b", "main", bare)
+    tohum_dir = os.path.join(kok, "tohum")
+    git(kok, "clone", "-q", "-c", "core.autocrlf=false", bare, tohum_dir)
+    for d in ("arac", "oturumlar"):
+        os.makedirs(os.path.join(tohum_dir, d), exist_ok=True)
+    io.open(os.path.join(tohum_dir, "arac", "tahta.py"), "w", encoding="utf-8",
+            newline="\n").write(tahta_metni)
+    shutil.copy(TAHTA_YENI_PY, os.path.join(tohum_dir, "arac", "tahta_yeni.py"))
+    io.open(os.path.join(tohum_dir, "oturumlar", "tahta.json"), "w", encoding="utf-8",
+            newline="\n").write(json.dumps(tohum(), ensure_ascii=False, indent=1))
+    io.open(os.path.join(tohum_dir, "oturumlar", "TAHTA.md"), "w", encoding="utf-8",
+            newline="\n").write("# tohum\n")
+    io.open(os.path.join(tohum_dir, ".gitignore"), "w").write("__pycache__/\n")
+    for c in (tohum_dir,):
+        git(c, "config", "user.name", "sinav"); git(c, "config", "user.email", "s@s")
+        git(c, "config", "core.autocrlf", "false")
+    git(tohum_dir, "symbolic-ref", "HEAD", "refs/heads/main")
+    git(tohum_dir, "add", "-A")
+    git(tohum_dir, "commit", "-q", "-m", "tohum")
+    git(tohum_dir, "push", "-q", "origin", "main", "main:makine/a", "main:makine/b")
+    klon = {}
+    for ad, dal in (("A", "makine/a"), ("B", "makine/b"), ("M", "main")):
+        y = os.path.join(kok, ad)
+        git(kok, "clone", "-q", "-c", "core.autocrlf=false", bare, y)
+        git(y, "config", "user.name", "sinav-" + ad); git(y, "config", "user.email", ad + "@s")
+        git(y, "config", "core.autocrlf", "false")
+        if dal != "main":
+            git(y, "checkout", "-q", "-b", dal, "--track", "origin/" + dal)
+        klon[ad] = y
+    git(klon["B"], "config", "atlas.makine", "KASA")     # ② kaynak: klon ayarı
+    git(klon["M"], "config", "atlas.makine", "KOORD")
+    return klon
+
+
+def birlesim_no(ours, theirs):
+    """Koordinatörün en doğal çözümü: `no` ANAHTARLI birleşim (ours önce).
+    Aynı `no` iki tarafta AYNI mesajsa alanları birleştirir (teyit/okuyan ∪,
+    hal ileri olan, cevap/yanit dolu olan). Aynı `no` FARKLI mesajsa ⇒ ours kalır,
+    theirs DÜŞER (anahtar başına tek kayıt) — kayıp burada doğar."""
+    sira = ["ACIK", "CEVAPLANDI", "KAPANDI"]
+    out, yer = [], {}
+    for m in ours:
+        yer[m["no"]] = len(out)
+        out.append(dict(m))
+    for m in theirs:
+        if m["no"] not in yer:
+            yer[m["no"]] = len(out)
+            out.append(dict(m))
+            continue
+        o = out[yer[m["no"]]]
+        if kimlik(o) != kimlik(m):
+            continue                                     # ÇAKIŞMA ⇒ theirs düşer
+        for f in ("teyit", "okuyan"):
+            d = dict(o.get(f) or {}); d.update(m.get(f) or {}); o[f] = d
+        if sira.index(m.get("hal", "ACIK")) > sira.index(o.get("hal", "ACIK")):
+            o["hal"] = m["hal"]
+        for f in ("cevap", "kapanis"):
+            if (o.get(f) in ("", "GEREKMEZ")) and m.get(f) not in ("", "GEREKMEZ", None):
+                o[f] = m[f]
+    return out
+
+
+def senaryo(kol, tahta_metni, beklenen_kusur):
+    print("\n" + "=" * 74)
+    print("KOL: %s" % kol)
+    print("=" * 74)
+    kok = tempfile.mkdtemp(prefix="tahta-no-%s-" % kol.lower())
+    try:
+        k = kur(kok, tahta_metni)
+        # ── ① EŞZAMANLI YAZIM — iki "makine" aynı anda, ikisi de M-0003'ü görüyor
+        sonuc = {}
+
+        def yaz(ad, mesaj):
+            sonuc[ad] = tahta(k[ad], "yaz", "--kim", "MAKINE-" + ad, "--kime", "KOORD",
+                              "--mesaj", mesaj)
+        t = [threading.Thread(target=yaz, args=("A", "A birinci teslim")),
+             threading.Thread(target=yaz, args=("B", "B birinci teslim"))]
+        [x.start() for x in t]; [x.join() for x in t]
+        soru("[%s] iki eşzamanlı yazım çıkış 0" % kol,
+             sonuc["A"][0] == 0 and sonuc["B"][0] == 0,
+             "A=%d B=%d" % (sonuc["A"][0], sonuc["B"][0]))
+        # A eski numaraya cevap verir · B ikinci mesaj + eski numarayı teyit eder
+        ra = tahta(k["A"], "yaz", "--kim", "MAKINE-A", "--kime", "ESKI-2",
+                   "--mesaj", "A cevap eskiye", "--yanit", "M-0002")
+        rb = tahta(k["B"], "yaz", "--kim", "MAKINE-B", "--kime", "KOORD", "--mesaj", "B ikinci")
+        rt = tahta(k["B"], "teyit", "M-0001", "--kim", "MAKINE-B")
+        soru("[%s] dalda `--yanit M-0002` (ESKİ numara) yazıldı" % kol, ra[0] == 0, ra[1][-120:].strip() if ra[0] else "")
+        soru("[%s] dalda `teyit M-0001` (ESKİ numara) çıkış 0" % kol, rt[0] == 0 and rb[0] == 0)
+        A, B = oku(k["A"]), oku(k["B"])
+        yeniA = [m["no"] for m in A[3:]]
+        yeniB = [m["no"] for m in B[3:]]
+        print("  A dalı yeni numaralar: %s" % yeniA)
+        print("  B dalı yeni numaralar: %s" % yeniB)
+        # ── ② ÇAKIŞMA ÖLÇÜMÜ — aynı numara, iki ayrı mesaj
+        harita = {}
+        for m in A[3:] + B[3:]:
+            harita.setdefault(m["no"], set()).add(kimlik(m))
+        cakisan = sorted(n for n, s in harita.items() if len(s) > 1)
+        # ── ③ BİRLEŞTİRME (git) — M: a, sonra b
+        git(k["M"], "fetch", "-q", "origin")
+        git(k["M"], "merge", "-q", "--no-ff", "-m", "a", "origin/makine/a")
+        mr = git(k["M"], "merge", "--no-ff", "-m", "b", "origin/makine/b", kontrol=False)
+        catisma_dosya = [s for s in git(k["M"], "diff", "--name-only",
+                                        "--diff-filter=U").stdout.split() if s]
+        blok = 0
+        if "oturumlar/tahta.json" in catisma_dosya:
+            blok = io.open(os.path.join(k["M"], "oturumlar", "tahta.json"),
+                           encoding="utf-8").read().count("\n<<<<<<< ")
+        print("  git merge b: kod %d · çakışan dosyalar %s · tahta.json blok %d"
+              % (mr.returncode, catisma_dosya, blok))
+        ours = json.loads(git(k["M"], "show", ":2:oturumlar/tahta.json").stdout) \
+            if catisma_dosya else oku(k["M"])
+        theirs = json.loads(git(k["M"], "show", ":3:oturumlar/tahta.json").stdout) \
+            if catisma_dosya else B
+        cozum = birlesim_no(ours, theirs)
+        tum = {kimlik(m) for m in A + B}
+        kalan = {kimlik(m) for m in cozum}
+        kayip = sorted(x[2] for x in tum - kalan)
+        nolar = [m["no"] for m in cozum]
+        print("  numara çakışması: %s · no-anahtarlı birleşimde KAYIP: %s" % (cakisan, kayip))
+        if beklenen_kusur:
+            soru("[%s] KUSUR GÖRÜNÜR: numara çakışması ≥1" % kol, len(cakisan) >= 1, str(cakisan))
+            soru("[%s] KUSUR GÖRÜNÜR: no-anahtarlı birleşimde mesaj KAYBI ≥1" % kol,
+                 len(kayip) >= 1, str(kayip))
+        else:
+            soru("[%s] numara çakışması 0" % kol, not cakisan, str(cakisan))
+            soru("[%s] birleşimde mesaj kaybı 0 (%d mesaj)" % (kol, len(cozum)),
+                 not kayip and len(cozum) == len(tum), str(kayip))
+            soru("[%s] birleşik tahtada numaralar TEKİL" % kol, len(nolar) == len(set(nolar)))
+            soru("[%s] önekler: A dalı 'M-A-', B klon ayarı 'M-KASA-'" % kol,
+                 all(n.startswith("M-A-") for n in yeniA)
+                 and all(n.startswith("M-KASA-") for n in yeniB), "%s %s" % (yeniA, yeniB))
+            eski = {m["no"]: m for m in cozum}
+            soru("[%s] eski numaralar DEĞİŞMEDİ, birleşimde M-0002 'CEVAPLANDI' + M-0001 teyitli"
+                 % kol, eski["M-0002"]["hal"] == "CEVAPLANDI"
+                 and "MAKINE-B" in (eski["M-0001"].get("teyit") or {}))
+        # çözümü yaz, görünümü tahta.py'nin kendisiyle üret, birleştirmeyi kapat
+        io.open(os.path.join(k["M"], "oturumlar", "tahta.json"), "w", encoding="utf-8",
+                newline="\n").write(json.dumps(cozum, ensure_ascii=False, indent=1))
+        subprocess.run([sys.executable, "-c",
+                        "import sys;sys.path.insert(0,'arac');import tahta as T;"
