+
+def _no_sira(no):
+    """Numaranın sayı kısmı — eski (`M-5892`) ve yeni (`M-UMIT-5893`) biçim."""
+    m = _NO_DESEN.match((no or "").strip().upper())
+    return int(m.group(2)) if m else 0
+
+
+def _makine_onek():
+    """Önek kaynağı, sırayla: ① `ATLAS_MAKINE` ortam değişkeni ② `git config
+    atlas.makine` (klona özel) ③ dal `makine/<ad>` ④ `socket.gethostname()`.
+    ⚠️ Aynı makinede İKİ klon ayrı dallara yazıyorsa ③/④ ikisine aynı öneki
+    verebilir — o klonda ② ile ayrı ad verilir (`git config atlas.makine X`)."""
+    ham = os.environ.get("ATLAS_MAKINE") or ""
+    _kod = {"capture_output": True, "text": True,
+            "encoding": "utf-8", "errors": "replace"}
+    try:
+        if not ham:
+            ham = (subprocess.run(["git", "-C", KOK, "config", "--get",
+                                   "atlas.makine"], **_kod).stdout or "").strip()
+        if not ham:
+            dal = (subprocess.run(["git", "-C", KOK, "symbolic-ref", "-q",
+                                   "--short", "HEAD"], **_kod).stdout or "").strip()
+            if dal.startswith("makine/"):
+                ham = dal[len("makine/"):]
+    except Exception:
+        pass
+    if not ham:
+        import socket
+        ham = socket.gethostname()
+    s = re.sub(r"[^A-Z0-9]", "", ham.upper())[:16]
+    return s if s[:1].isalpha() else "H" + (s or "0")
+
+
+def _yeni_no(kayit):
+    n = max([len(kayit)] + [_no_sira(x.get("no")) for x in kayit]) + 1
+    return "M-%s-%04d" % (_makine_onek(), n)
+
