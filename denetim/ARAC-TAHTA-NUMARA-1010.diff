+def union_olcumu(tahta_metni):
+    """BİLGİ: `.gitattributes merge=union` tahta.json'u kayıpsız birleştirir mi?
+    (kök .gitattributes koordinatörün — burada yalnız geçici depoda `.git/info/attributes`)"""
+    print("\n" + "=" * 74)
+    print("ÖLÇÜM: merge=union (yalnız geçici depo, .git/info/attributes)")
+    print("=" * 74)
+    kok = tempfile.mkdtemp(prefix="tahta-no-union-")
+    try:
+        k = kur(kok, tahta_metni)
+        tahta(k["A"], "yaz", "--kim", "MAKINE-A", "--kime", "KOORD", "--mesaj", "A tek")
+        tahta(k["B"], "yaz", "--kim", "MAKINE-B", "--kime", "KOORD", "--mesaj", "B tek")
+        os.makedirs(os.path.join(k["M"], ".git", "info"), exist_ok=True)
+        io.open(os.path.join(k["M"], ".git", "info", "attributes"), "w").write(
+            "oturumlar/tahta.json merge=union\noturumlar/TAHTA.md merge=union\n")
+        git(k["M"], "fetch", "-q", "origin")
+        git(k["M"], "merge", "-q", "--no-ff", "-m", "a", "origin/makine/a")
+        r = git(k["M"], "merge", "--no-ff", "-m", "b", "origin/makine/b", kontrol=False)
+        try:
+            j = oku(k["M"])
+            hal = "GEÇERLİ JSON · %d kayıt (beklenen 5) · mesajlar %s" % (
+                len(j), [m.get("mesaj") for m in j[3:]])
+            gecerli, tam = True, len(j) == 5
+        except ValueError as e:
+            hal = "GEÇERSİZ JSON — %s" % e
+            gecerli, tam = False, False
+        print("  merge kod %d · %s" % (r.returncode, hal))
+        soru("[UNION] merge=union pretty-JSON tahtayı KAYIPSIZ birleştiremez "
+             "(geçersiz JSON ya da eksik kayıt) — öneri dosyasının dayanağı",
+             not (gecerli and tam), hal)
+    except Exception as e:
+        soru("[UNION] ölçüm KOŞULDU", False, "%s: %s" % (type(e).__name__, e))
+    finally:
+        _sil(kok)
+
+
+def birim(tahta_metni):
+    print("\n" + "=" * 74)
+    print("BİRİM: önek kaynağı + sayı ayrıştırıcı")
+    print("=" * 74)
+    kok = tempfile.mkdtemp(prefix="tahta-no-birim-")
+    try:
+        os.makedirs(os.path.join(kok, "arac"))
+        io.open(os.path.join(kok, "arac", "tahta.py"), "w", encoding="utf-8",
+                newline="\n").write(tahta_metni)
+        kod = ("import sys,os,json;sys.path.insert(0,'arac');import tahta as T;"
+               "print(json.dumps([T._makine_onek(),T._no_sira('M-5892'),"
+               "T._no_sira('M-UMIT-5893'),T._no_sira('m-kasa-0007'),T._no_sira('bozuk'),"
+               "T._yeni_no([{'no':'M-0001'},{'no':'M-KASA-0009'},{'no':'M-0002'}])]))")
+        env = dict(os.environ); env.pop("ATLAS_MAKINE", None)
+        r = subprocess.run([sys.executable, "-c", kod], cwd=kok, capture_output=True,
+                           text=True, encoding="utf-8", env=env)
+        on, a, b, c, d, y = json.loads(r.stdout.strip().splitlines()[-1])
+        host = re.sub(r"[^A-Z0-9]", "", socket.gethostname().upper())[:16]
+        soru("[BİRİM] git'siz dizinde önek = hostname (%s)" % on, on == host or on == "H" + host)
+        soru("[BİRİM] sayı: M-5892→5892 · M-UMIT-5893→5893 · m-kasa-0007→7 · bozuk→0",
+             (a, b, c, d) == (5892, 5893, 7, 0))
+        soru("[BİRİM] yeni no = en büyük sayı + 1 (%s)" % y, y == "M-%s-0010" % on)
+        env["ATLAS_MAKINE"] = "lab-1"
+        r = subprocess.run([sys.executable, "-c", kod], cwd=kok, capture_output=True,
+                           text=True, encoding="utf-8", env=env)
+        soru("[BİRİM] ATLAS_MAKINE=lab-1 ⇒ önek LAB1",
+             json.loads(r.stdout.strip().splitlines()[-1])[0] == "LAB1")
+    finally:
+        _sil(kok)
+
+
+def main():
+    if not os.path.exists(TAHTA_PY):
+        print("🔴 KOŞULAMADI — %s yok" % TAHTA_PY)
+        return 2
+    yamali = io.open(TAHTA_PY, encoding="utf-8").read()
+    if yamali.count(YAMA_SATIRI) != 1:
+        print("🔴 KOŞULAMADI — tahta.py'de yama satırı bulunamadı (yama inmemiş?)")
+        return 2
+    yamasiz = yamali.replace(YAMA_SATIRI, ESKI_SATIR)
+    birim(yamali)
+    for kol, metin, kusur in (("YAMASIZ", yamasiz, True), ("YAMALI", yamali, False)):
+        _, kok = senaryo(kol, metin, kusur)
+        _sil(kok)
+    union_olcumu(yamali)
+    tut = sum(1 for _, ok in SONUC if ok)
+    print("\n" + "=" * 74)
+    print("SONUÇ: %d/%d soru tuttu" % (tut, len(SONUC)))
+    for ad, ok in SONUC:
+        if not ok:
+            print("  ✗ %s" % ad)
+    return 0 if tut == len(SONUC) else 1
+
