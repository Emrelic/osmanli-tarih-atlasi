+# -*- coding: utf-8 -*-
+"""SINAV — `renk_olc.py` ARDIL ENGELİ (RENK-ARDIL-1009), ÜÇ YÖNDE.
+
+Soru: aynı yerleşimde ARDIŞIK iki taban sahibi (eşzamanlı DEĞİL) renk
+çakışması adayı mı? Yamasız araç bunu SORMUYORDU (vaka resuli → tahiri,
+1454: `--oner` ΔE ≈ 1 önerdi). Tanım `renk_olc.py` ARDIL başlığında.
+
+  A  TANIM — saf işlevler (`zaman_cizgisi`, `ardil_ciftleri`), sentetik
+  B  YAKALAMALI — ardışık + YAKIN renk: denetle · engel · --dogrula · --oner
+  C  SUSMALI    — ardışık + UZAK renk · ardışık OLMAYAN aynı hex
+  D  GERİLEME YOK — eşzamanlı ölçütler yamasız araçla BİREBİR aynı
+B-D GERÇEK veride, iki araç yan yana:
+     yamasız = `git show 79115d23:arac/renk_olc.py` (yamadan önceki main)
+     yamalı  = `arac/renk_olc.py`
+`--hizli` `--oner` sorularını atlar (aday ızgarası ~10 sn/araç).
+Çıkış: 0 hepsi geçti · 1 en az biri kaldı.
+"""
+import contextlib, importlib.util, io, os, re, subprocess, sys, tempfile
+
+sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
+KOK = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+AR = os.path.join(KOK, "arac")
+sys.path.insert(0, AR)
+YAMASIZ_REV = "79115d23"
+
+_kalan = []
+
+
+def sor(ad, kosul, ayrinti=""):
+    print(("  ✓ " if kosul else "  🔴 ") + ad + (f"  — {ayrinti}" if ayrinti else ""))
+    if not kosul:
+        _kalan.append(ad.split()[0])
+
+
+def yukle(ad, kaynak):
+    """kaynağı `arac/renk_olc.py` yoluyla modül olarak yükler (KUTU ve
+    sys.path dosya yolundan türüyor; sahte yol ölçümü bozar)."""
+    spec = importlib.util.spec_from_loader(ad, loader=None)
+    m = importlib.util.module_from_spec(spec)
+    m.__file__ = os.path.join(AR, "renk_olc.py")
+    # modül import anında stdout'u YENİDEN sarıyor; iki kez yüklenince eski
+    # sarmalayıcı çöpe giderken ortak tamponu KAPATIYOR (ölçüldü) ⇒ o satır
+    # yalnız bu sınavın belleğindeki kopyadan çıkarılır, davranış aynı.
+    kaynak = re.sub(r"^sys\.stdout = io\.TextIOWrapper\(.*$", "pass", kaynak,
+                    count=1, flags=re.M)
+    exec(compile(kaynak, m.__file__, "exec"), m.__dict__)
+    return m
+
+
+def sessiz(f, *a, **kw):
+    tam = io.StringIO()
+    with contextlib.redirect_stdout(tam):
+        r = f(*a, **kw)
+    return r, tam.getvalue()
+
+
+import renkler                                            # noqa: E402
+R = yukle("renk_olc_yamali", io.open(os.path.join(AR, "renk_olc.py"),
+                                     encoding="utf-8").read())
+
+# ─────────────────────────── A — TANIM ───────────────────────────
+print("A — tanım (saf işlev, sentetik)")
+
+
+def Y(ad, **kw):
+    return dict(ad=ad, lat=0, lon=0, **kw)
+
+
+def C(*yy):
+    return R.ardil_ciftleri(list(yy))
+
+
+c = C(Y("x", s=[{"d": "a", "f": "1400-01-01", "t": "1454-01-01"},
+                {"d": "b", "f": "1454-01-01", "t": "1500-01-01"}]))
+sor("A1 boşluksuz el değiştirme ARDIL", ("a", "b") in c, str(dict(c)))
+c = C(Y("x", s=[{"d": "a", "f": "1400-01-01", "t": "1454-01-01"},
+                {"d": "b", "f": "1454-01-31", "t": "1500-01-01"}]))
+sor(f"A2 boşluk 30 gün (= tavan {R.ARDIL_BOSLUK_TAVANI}) ARDIL", ("a", "b") in c)
+c = C(Y("x", s=[{"d": "a", "f": "1400-01-01", "t": "1454-01-01"},
+                {"d": "b", "f": "1454-02-01", "t": "1500-01-01"}]))
+sor("A3 boşluk 31 gün (> tavan) ardıl DEĞİL", not c, str(dict(c)))
+c = C(Y("x", s=[{"d": "a", "f": "1400-01-01", "t": "1450-01-01"},
+                {"d": "__BOSLUK__", "f": "1450-01-01", "t": "1460-01-01"},
+                {"d": "b", "f": "1460-01-01", "t": "1500-01-01"}]))
+sor("A4 __BOSLUK__ araya girerse MUAF ve zinciri KIRAR", not c, str(dict(c)))
+c = C(Y("x", s=[{"d": "a", "f": "1400-01-01", "t": "1500-01-01"}],
+        isg=[{"d": "b", "f": "1450-01-01", "t": "1460-01-01"}]))
+sor("A5 isg: taban rengi DEĞİL — çift kurmaz", not c, str(dict(c)))
+c = C(Y("x", s=[{"d": "a", "f": "1400-01-01", "t": "1450-01-01"}],
+        v=[{"f": "1450-01-01", "t": "1500-01-01", "d": "a"}]))
+sor("A6 v: TÂBİLİK SAYILIR → OSMANLI tâbi (v:'nin d:'si okunmaz)",
+    tuple(sorted(("a", R.OSM_TABI))) in c, str(dict(c)))
+c = C(Y("x", d=[{"f": "1400-01-01", "t": "1450-01-01"}],
+        v=[{"f": "1450-01-01", "t": "1500-01-01", "himaye": True, "kid": "h"}]))
+sor("A7 v:{himaye,kid} → kid'in kendi rengi",
+    tuple(sorted((R.OSM_DOGRUDAN, "h"))) in c, str(dict(c)))
+c = C(Y("x", d=[{"f": "1400-01-01", "t": "1450-01-01"}],
+        v=[{"f": "1450-01-01", "t": "1500-01-01"}]))
+sor("A8 OSMANLI doğrudan↔tâbi palet sorusu DEĞİL", not c, str(dict(c)))
+c = C(Y("x", s=[{"d": "a", "f": "1400-01-01", "t": "1450-01-01"},
+                {"d": "b", "f": "1450-01-01", "t": "1460-01-01"},
+                {"d": "c", "f": "1460-01-01", "t": "1500-01-01"}]))
+sor("A9 a→b→c: a↔c ardıl DEĞİL", sorted(c) == [("a", "b"), ("b", "c")], str(sorted(c)))
+# Kütahya deseni: uzun d: içinde kısa v:, sonra yabancı — ilk sürümün hatası
+c = C(Y("Kütahya", d=[{"f": "1300-01-01", "t": "1920-04-23"}],
+        v=[{"f": "1832-06-15", "t": "1833-06-30"}],
+        s=[{"d": "t", "f": "1920-04-23", "t": "1923-10-29"}]))
+_k = sorted(c)
+sor("A10 iç içe dönem: 'o an kimdi' — doğrudan→t ardıl, tâbi→t DEĞİL",
+    tuple(sorted((R.OSM_DOGRUDAN, "t"))) in c and tuple(sorted((R.OSM_TABI, "t"))) not in c,
+    str(_k))
+zc = R.zaman_cizgisi(Y("x", d=[{"f": "1400-01-01", "t": "1500-01-01"}],
+                       v=[{"f": "1450-01-01", "t": "1460-01-01"}]))
+sor("A11 d: ile v: çakışırsa TÂBİ kazanır (motor sırası)",
+    [z[0] for z in zc] == [R.OSM_DOGRUDAN, R.OSM_TABI, R.OSM_DOGRUDAN], str(zc))
+
+# ─────────────────────────── gerçek veri hazırlığı ───────────────────────────
+print("\nhazırlık — gerçek veri (girdi.py'nin okuduğu dosyalar), iki araç")
+try:
+    _ks = subprocess.run(["git", "-C", KOK, "show", f"{YAMASIZ_REV}:arac/renk_olc.py"],
+                         capture_output=True, check=True).stdout.decode("utf-8")
+    U = yukle("renk_olc_yamasiz", _ks)
+except Exception as e:                                   # ölçülemedi ≠ geçti
+    U = None
+    sor(f"H0 yamasız kaynak okunabildi ({YAMASIZ_REV})", False, repr(e))
+
+B = renkler.BOYALAR                     # iki modülün de BOYALAR'ı BU nesne
+_yedek = {x: B.get(x) for x in ("resuli", "tahiri")}
+YAKIN, UZAK = "#72d824", "#9c24d8"      # resuli #6cd824 ile ΔE ≈ 1 · ≈ 92
+B["resuli"] = ("Resûlîler", "#6cd824")
+B["tahiri"] = ("Tâhirîler (Yemen)", YAKIN)
+
+(k, _), _ = sessiz(R.komsuluk)
+ak, kanit = R.ardil()
+sor("H1 veride resuli→tahiri ardıllığı VAR", ("resuli", "tahiri") in kanit,
+    str(kanit.get(("resuli", "tahiri"))))
+sor("H2 Voronoi komşusu DEĞİLLER (eşzamanlı değil — eski ölçüt göremez)",
+    "tahiri" not in k.get("resuli", ()))
+
+
+def dogrula_cikti(M, satirlar):
+    fd, yol = tempfile.mkstemp(suffix=".txt")
+    with os.fdopen(fd, "w", encoding="utf-8") as f:
+        f.write("".join(f"{a} {h}\n" for a, h in satirlar))
+    try:
+        _kod, out = sessiz(M.dogrula, yol)
+    finally:
+        os.remove(yol)
+    return out
+
+
+def oner_cikti(M):
+    """--oner resuli,tahiri — ikisi de paletten ÇIKARILIR ('yeni' kimlik)."""
+    eski = {x: B.pop(x, None) for x in ("resuli", "tahiri")}
+    _, out = sessiz(M.oner, ["resuli", "tahiri"])
+    for x, v in eski.items():
+        if v is not None:
+            B[x] = v
+    m = re.search(r"artefakt: (\S+)", out)
+    if m and os.path.exists(m.group(1)):
+        os.remove(m.group(1))          # sınav artefakt BIRAKMAZ
+    hx = dict(re.findall(r"^\s+(resuli|tahiri)\s+(#[0-9a-f]{6})", out, re.M))
+    if len(hx) < 2:
+        return None, hx
+    return R.dE(R.lab(R.bind(R.h2r(hx["resuli"]))),
+                R.lab(R.bind(R.h2r(hx["tahiri"])))), hx
+
+
+# ─────────────────────────── B — YAKALAMALI ───────────────────────────
+print("\nB — ardışık + YAKIN renk YAKALANMALI (resuli #6cd824 / tahiri #72d824)")
+_de = R.dE(R.gorunen("resuli"), R.gorunen("tahiri"))
+if U is not None:
+    sor("B1 YAMASIZ: tahiri resuli'nin engeli DEĞİL (kör nokta yeniden üretildi)",
+        "tahiri" not in U.engel_kumesi("resuli", k=k) and not hasattr(U, "ardil"),
+        f"ΔE {_de:.2f}")
+_hit = [x for x in R.ardil_denetle(k)[0] if (x[1], x[2]) == ("resuli", "tahiri")]
+sor("B2 YAMALI denetle: resuli↔tahiri ARDIL ÇAKIŞMASI",
+    bool(_hit) and _hit[0][0] < R.DE_KOMSU, f"ΔE {_hit[0][0]:.2f}" if _hit else "yok")
+sor("B3 YAMALI engel_kumesi: tahiri resuli'nin engeli", "tahiri" in R.engel_kumesi("resuli", k=k))
+_out = dogrula_cikti(R, [("resuli", "#6cd824"), ("tahiri", YAKIN)])
+sor("B4 YAMALI --dogrula: SON DOĞRULAMA tahiri'yi '(ardıl)' diye basar",
+    re.search(r"🟠 resuli\s.*tahiri [0-9.]+ \(ardıl\)", _out) is not None,
+    next((l.strip() for l in _out.splitlines() if "🟠 resuli" in l), "satır yok"))
+if U is not None:
+    _out = dogrula_cikti(U, [("resuli", "#6cd824"), ("tahiri", YAKIN)])
+    sor("B5 YAMASIZ --dogrula: aynı öneriyi GÖRMÜYOR (kör nokta)",
+        "🟠 resuli" not in _out and "🟠 tahiri" not in _out)
+if "--hizli" not in sys.argv:
+    if U is not None:
+        d, hx = oner_cikti(U)
+        sor("B6 YAMASIZ --oner: resuli/tahiri eşik ALTINDA (vaka yeniden üretildi)",
+            d is not None and d < R.DE_KOMSU, f"{hx} ΔE {d if d is None else round(d, 2)}")
+    d, hx = oner_cikti(R)
+    sor("B7 YAMALI --oner: resuli/tahiri ΔE ≥ 12", d is not None and d >= R.DE_KOMSU,
+        f"{hx} ΔE {d if d is None else round(d, 2)}")
+else:
+    print("  i B6/B7 atlandı (--hizli)")
+
+# ─────────────────────────── C — SUSMALI ───────────────────────────
+print(f"\nC — ardışık + UZAK renk SUSMALI (tahiri {UZAK})")
+B["tahiri"] = ("Tâhirîler (Yemen)", UZAK)
+_i, _s, _o, _b = R.ardil_denetle(k)
+sor("C1 denetle: resuli↔tahiri ne ihlal ne sınırda",
+    not [x for x in _i + _s if (x[1], x[2]) == ("resuli", "tahiri")],
+    f"ΔE {R.dE(R.gorunen('resuli'), R.gorunen('tahiri')):.1f}")
+_out = dogrula_cikti(R, [("resuli", "#6cd824"), ("tahiri", UZAK)])
+_sat = [l for l in _out.splitlines() if "🟠" in l and ("resuli" in l or "tahiri" in l)
+        and re.search(r"\b(resuli|tahiri) [0-9.]+", l.split("çift:")[-1])]
+sor("C2 --dogrula: resuli/tahiri birbirini eşik altı engel olarak BASMAZ", not _sat,
+    " | ".join(s.strip() for s in _sat))
+_uzak = next((x for x in ("joseon", "ming-hanedani", "ingiltere", "fransa")
+              if x in B and x not in ak.get("resuli", ()) and x not in k.get("resuli", ())),
+             None)
+if _uzak is None:
+    sor("C3 önkoşul: ardışık olmayan uzak aday bulundu", False)
+else:
+    _eski = B[_uzak]
+    B[_uzak] = (_eski[0], "#6cd824")
+    _i, _s, _o, _b = R.ardil_denetle(k)
+    sor(f"C3 ardışık OLMAYAN uzak devlet ({_uzak}, resuli ile AYNI hex) sayılmaz",
+        not [x for x in _i + _s if {"resuli", _uzak} == {x[1], x[2]}]
+        and _uzak not in ak.get("resuli", ()))
+    B[_uzak] = _eski
+
+# ─────────────────────────── D — GERİLEME YOK ───────────────────────────
+print("\nD — eşzamanlı ölçütler DEĞİŞMEMELİ (yamasız ↔ yamalı, aynı palet)")
+for x, v in _yedek.items():            # gerçek palete dön
+    if v is None:
+        B.pop(x, None)
+    else:
+        B[x] = v
+if U is None:
+    sor("D0 yamasız araç yok — gerileme ÖLÇÜLEMEDİ", False)
+else:
+    (ku, _), _ = sessiz(U.komsuluk)
+    sor("D1 komsuluk() birebir", {a: set(b) for a, b in ku.items()}
+        == {a: set(b) for a, b in k.items()})
+    sor("D2 yakin_renk() birebir (ihlal · sınırda · ölçülemedi · n)",
+        sessiz(U.yakin_renk, ku)[0] == sessiz(R.yakin_renk, k)[0])
+    sor("D3 ayni_hex() birebir", sessiz(U.ayni_hex)[0] == sessiz(R.ayni_hex)[0])
+    sor("D4 ayni_anahtar() birebir", sessiz(U.ayni_anahtar)[0] == sessiz(R.ayni_anahtar)[0])
+    _ru, ou = sessiz(U.denetle)
+    _rr, orr = sessiz(R.denetle)
+    sor("D5 denetle() dönüşü birebir (görünmez · çakışma · aynı-anahtar · aynı-hex · yakın)",
+        _ru == _rr, f"çakışma {len(_rr[1])} · yakın {len(_rr[4])}")
+    # çıktı: yamalının ARDIL bölümü ve özet kuyruğu çıkarılınca BİREBİR
+    _kes = re.sub(r"\n\n=+\nARDILIYLA ÇAKIŞAN.*?(?=\n\n=+\nAYNI ANAHTARI)", "", orr,
+                  flags=re.S)
+    _kes = _kes.replace(f" · {len(R.ardil_denetle(k)[0])} ardıl çakışması", "")
+    sor("D6 denetle() ÇIKTISI ardıl bölümü dışında birebir", _kes == ou,
+        f"{len(ou)} / {len(_kes)} karakter")
+    # engel_kumesi: yamalı ⊇ yamasız, fark YALNIZ ardıllar
+    _ornek = sorted(B)[::25]
+    _fark = []
+    for x in _ornek:
+        eu, er = U.engel_kumesi(x, k=k), R.engel_kumesi(x, k=k)
+        if not (eu <= er and (er - eu) <= ak.get(x, set())):
+            _fark.append((x, sorted(eu - er), sorted((er - eu) - ak.get(x, set()))))
+    sor(f"D7 engel_kumesi: yamalı ⊇ yamasız, fark yalnız ardıl ({len(_ornek)} kimlik)",
+        not _fark, str(_fark[:3]))
+
+print("\n" + ("✓ HEPSİ GEÇTİ" if not _kalan else f"🔴 {len(_kalan)} soru KALDI: "
+                                                  + " · ".join(_kalan)))
+sys.exit(1 if _kalan else 0)
