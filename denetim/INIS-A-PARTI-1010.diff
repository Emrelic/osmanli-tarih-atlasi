+  G1  D5-GUN-1010-v3.diff + ARAC-D5-GUN-SINAV-1010.py, taban origin/main:
+      yamalı 23/23 · yamasız 5/23 · TESADÜF kovası TAM {S2,S4,S12,V1,V8} · ISIRIYOR 18 · çıkış 0
+Çıkış: 0 hepsi geçti · 1 en az biri kaldı.
+"""
+import glob
+import io
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+
+if hasattr(sys.stdout, "reconfigure"):
+    sys.stdout.reconfigure(encoding="utf-8", errors="replace", line_buffering=True)
+
+KOK = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+ARAC = os.path.join(KOK, "arac", "sinav_isirma.py")
+GERCEK = "--gercek-yok" not in sys.argv
+D5_DIZIN = sys.argv[sys.argv.index("--d5-dizin") + 1] if "--d5-dizin" in sys.argv else r"C:\atlas-umit\denetim"
