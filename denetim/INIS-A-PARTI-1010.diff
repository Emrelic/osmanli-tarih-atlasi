+    ("R8", "DURDURUCU"), ("R9", "durdurucu"), ("R10", "🔴🔴 DURDURUCU"),
+]
+BILGI_VARYANT = [
+    ("B1", "NORMAL"), ("B2", ""), ("B3", "DÜŞÜK"), ("B4", "ACİLEN"),
+    ("B5", "aciliyet"),
+]
