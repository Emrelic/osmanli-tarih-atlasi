+//   E  ATAR: GUN yoksa ve bozuk tarihte sessiz kalmaz
+"use strict";
+const fs = require("fs"), path = require("path"), vm = require("vm"), cp = require("child_process");
+
+const arg = process.argv.slice(2);
+function argAl(ad, vars) { const i = arg.indexOf(ad); return i >= 0 ? arg[i + 1] : vars; }
+const KOK = path.resolve(argAl("--kok", path.join(__dirname, "..")));
+const ESKI_REF = argAl("--eski", "6cec6a9b");
+
+let gecen = 0, kalan = 0;
+const kotu = [];
+function soru(ad, kosul, ayrinti) {
+  if (kosul) gecen++; else { kalan++; kotu.push(ad + (ayrinti ? "  → " + ayrinti : "")); }
+  console.log((kosul ? "  ✓ " : "  ✗ ") + ad + (ayrinti && !kosul ? "  → " + ayrinti : ""));
+}
+function olculemedi(neden) { console.log("ÖLÇÜLEMEDİ: " + neden); process.exit(2); }
+
+// ---- modüller --------------------------------------------------------------
+const GUN_SRC = fs.readFileSync(path.join(KOK, "js", "gun.js"), "utf8");
+function gunYukle() { const m = { exports: {} }; vm.runInNewContext(GUN_SRC, { module: m }); return m.exports; }
+const GUN = gunYukle();
+function suzgecYukle(src, gunVar) {
+  const m = { exports: {} }, c = { module: m, console: console };
+  if (gunVar) c.GUN = GUN;
+  vm.runInNewContext(src, c, { filename: "suzgec.js" });
+  return m.exports;
+}
+const YENI_SRC = fs.readFileSync(path.join(KOK, "js", "suzgec.js"), "utf8");
+let ESKI_SRC;
+try { ESKI_SRC = cp.execFileSync("git", ["-C", KOK, "show", ESKI_REF + ":js/suzgec.js"], { encoding: "utf8", maxBuffer: 64 << 20 }); }
+catch (e) { olculemedi("eski suzgec.js git'ten okunamadı (" + ESKI_REF + "): " + e.message.split("\n")[0]); }
+if (/NEGATIF-YIL-1010-A2/.test(ESKI_SRC)) olculemedi("--eski " + ESKI_REF + " zaten A2'li — yamasız kol değil");
+if (!/NEGATIF-YIL-1010-A2/.test(YENI_SRC)) console.log("⚠️  çalışma ağacındaki suzgec.js A2'siz (yamasız ağaçta koşuyor: A-E'nin YENİ yönü düşmeli)");
+const YENI = suzgecYukle(YENI_SRC, true), ESKI = suzgecYukle(ESKI_SRC, false);
+console.log("kök " + KOK + " · eski kol " + ESKI_REF + ":js/suzgec.js");
+
+// ---- A · MÖ dönem içinde bir gün -----------------------------------------
+// Sentetik yerleşim (astronomik yıl: MÖ 550 = -0549, MÖ 330 = -0329).
+console.log("\nA · MÖ dönem içinde bir gün ⇒ doğru sahip");
+const PERS = { ad: "Persepolis(sentetik)", lat: 29.9, lon: 52.9,
+  s: [{ d: "ahameni", f: "-0549-01-01", t: "-0329-10-01" },
+      { d: "makedonya", f: "-0329-10-01", t: "-0311-01-01" },
+      { d: "selevkos", f: "-0311-01-01", t: "0001-01-01" }],
+  v: [{ kid: "medya", k: "Medya", f: "-0600-01-01", t: "-0549-01-01" }],
+  isg: [{ d: "iskit", f: "-0400-03-01", t: "-0399-03-01" }] };
+const SUS = { ad: "Sus(sentetik)", lat: 32.2, lon: 48.2,
+  d: [{ f: "-2999-01-01", t: "-2000-01-01" }],
+  s: [{ d: "elam", f: "-2000-01-01", t: "-0639-01-01" }] };
+[
+  [PERS, "-0400-06-15", "s:ahameni"], [PERS, "-0549-01-01", "s:ahameni"], [PERS, "-0330-12-31", "s:ahameni"],
+  [PERS, "-0320-01-01", "s:makedonya"], [PERS, "-0100-01-01", "s:selevkos"], [PERS, "-0580-01-01", "tabi:medya"],
+  [SUS, "-2500-07-01", "osmanli"], [SUS, "-1200-01-01", "s:elam"], [SUS, "-0639-01-01", ""], [SUS, "-3000-12-31", ""],
+].forEach(function (v) {
+  const yeni = YENI.sahipAnahtari(v[0], v[1]), eski = ESKI.sahipAnahtari(v[0], v[1]);
+  soru("yeni sahipAnahtari(" + v[0].ad + ", " + v[1] + ") = " + JSON.stringify(v[2]), yeni === v[2], JSON.stringify(yeni));
+  console.log("      (eski kol: " + JSON.stringify(eski) + (eski === v[2] ? "" : "  ← YAMASIZ KUSUR") + ")");
+});
+soru("yeni isgalAnahtari(PERS, -0400-12-01) = iskit", YENI.isgalAnahtari(PERS, "-0400-12-01") === "iskit");
+soru("yeni aktifVAdi(PERS, -0580-01-01) = Medya", YENI.aktifVAdi(PERS, "-0580-01-01") === "Medya");
