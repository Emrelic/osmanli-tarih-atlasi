+    fark_p += (a < b) != (str(a) < str(b)) or (a <= b) != (str(a) <= str(b))
+sor("200.000 rastgele çift: Tarih kıyası == GÜN kıyası (bütün veri) · == sözlük (negatif olmayan)",
+    fark == 0 and fark_p == 0, "gün %d fark · sözlük %d fark" % (fark, fark_p))
