+
+        print("\n(d) GERİLEME — bayraksız çıktı eskisiyle birebir")
+        soru("D1 çıkış kodu aynı", k_eski == k_yeni, "eski %d · yeni %d" % (k_eski, k_yeni))
+        soru("D2 çıktı bayt bayt aynı", c_eski == c_yeni,
