+    soru("K" + no[1:], kod == 0 and kayit is not None,
+         "dayanaklı HERKES aciliyet=%r ⇒ KABUL(0), alınan %s · kayıttaki "
+         "aciliyet %r" % (v, kod, kayit and kayit.get("aciliyet")))
+
+# T — tutarlılık: yazıcı dayanak İSTEDİ ⇔ bekçi UYANDIRDI.
