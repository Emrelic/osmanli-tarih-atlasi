+
+
+NEG = {x for x in tumu if str(x).startswith("-")}
+POZ = tumu - NEG
+print("      veride negatif (MÖ) tarih: %d · negatif olmayan: %d" % (len(NEG), len(POZ)))
+_s_gun = [str(x) for x in sorted(tumu)] == [str(x) for x in sorted(tumu, key=_gun_anahtari)]
+_s_poz = [str(x) for x in sorted(POZ)] == sorted(str(x) for x in POZ)
