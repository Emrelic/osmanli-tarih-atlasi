+            return s
+    return None
+
+
+def main():
+    W = os.path.join(tempfile.gettempdir(), "sahiplik-dokum-sinav-%d" % os.getpid())
+    print("geçici worktree: %s (HEAD)" % W)
+    git("worktree", "add", "--detach", W, "HEAD")
+    try:
+        shutil.copyfile(YAMALI_ARAC, os.path.join(W, "arac", "_sahiplik_uygula.py"))
+        eski = git("cat-file", "-p", ESKI) if ":" not in ESKI else git("show", ESKI)
+        io.open(os.path.join(W, "arac", "_sahiplik_eski_1009.py"), "wb").write(eski)
+
+        # ── faz 1: temiz korpus, üç koşu paralel (salt okunur, aynı ağaç)
+        print("faz 1: eski bayraksız · yeni bayraksız · yeni --dosya-dokumu --json - (paralel)…")
+        with ThreadPoolExecutor(3) as ex:
+            f_eski = ex.submit(kos, W, "_sahiplik_eski_1009.py")
+            f_yeni = ex.submit(kos, W, "_sahiplik_uygula.py")
+            f_dok = ex.submit(kos, W, "_sahiplik_uygula.py", ("--dosya-dokumu", "--json", "-"))
+            (k_eski, c_eski), (k_yeni, c_yeni), (k_dok, c_dok) = (
+                f_eski.result(), f_yeni.result(), f_dok.result())
+        # (v2) Kapılı sürüm (eski) docstring satır 13'te `\.` taşıyor ⇒ Python stderr'e bir
+        #   SyntaxWarning + kaynak satırını basar (uyarı DOSYA YOLUNU da içerir). v2 o satırı
+        #   `\\.` yaptı (koordinatör onayı) ⇒ yenide uyarı YOK. Uyarı bloğu davranış değil
+        #   derleyici gürültüsüdür; karşılaştırmadan ÖNCE iki çıktıdan da çıkarılır ve eskide
+        #   TAM BİR KEZ bulunduğu ayrıca sorulur (D0). Ölçüldü: bu ayıklama olmadan ilk v2
+        #   koşusu D2'de yalnız bu satırda (3 karakter = dosya adı farkı) KALDI.
+        def _uyarisiz(c):
+            sat, out, atla, n = c.split("\n"), [], False, 0
+            for ln in sat:
+                if atla:
+                    atla = False
+                    continue
+                if "SyntaxWarning: invalid escape sequence" in ln:
+                    atla, n = True, n + 1
+                    continue
+                out.append(ln)
+            return "\n".join(out), n
+        c_eski, _n_eski = _uyarisiz(c_eski)
+        c_yeni, _n_yeni = _uyarisiz(c_yeni)
+        c_dok, _n_dok = _uyarisiz(c_dok)
+        soru("D0 SyntaxWarning: eski (kapılı) 1 · yeni 0 · bayraklı 0",
