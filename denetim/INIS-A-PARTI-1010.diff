+print("SINAV — TAHTA-ACIL-I-1010 · kök %s" % KOK)
+print("  aciliyet.py: %s" % ("VAR (yamalı ağaç)"
+      if os.path.exists(os.path.join(ARAC, "aciliyet.py")) else "YOK (yamasız ağaç)"))
