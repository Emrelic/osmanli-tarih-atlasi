+        # döküm bloğu: [boş satır, ═, "DOSYA DÖKÜMÜ —…", ═, …, ═ (son)] — satır tabanlı çıkarılır
+        _sat = c_dok.splitlines()
+        _bas = next((i for i, l in enumerate(_sat) if l.startswith("DOSYA DÖKÜMÜ —")), None)
