+        if c_eski != c_yeni:
+            a, b = c_eski.splitlines(), c_yeni.splitlines()
+            for i, (x, y) in enumerate(zip(a, b)):
+                if x != y:
+                    print("     ilk fark satır %d:\n       eski: %s\n       yeni: %s" % (i + 1, x, y))
+                    break
+        soru("D3 bayraklı koşu aynı çıkış kodunu verir", k_dok == k_yeni,
