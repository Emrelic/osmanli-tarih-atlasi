+# Tırnaklı (JSON biçimli) anahtar karşılıkları — ESKİ regex bunları HİÇ görmez.
+JSON_RX = {
+    "madde": r'"t"\s*:\s*"\d{4}(?:-\d{2}){0,2}"', "duygu": r'"duygu"\s*:\s*\[',
+    "yer_id": r'"yer_id"\s*:', "vefat_id": r'"vefat_id"\s*:'}
