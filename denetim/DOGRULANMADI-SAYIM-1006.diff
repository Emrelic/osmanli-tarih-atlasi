+def dogrulanmadi_say(Y):
+    """`dogrulanmadi` işaretli yerleşim kaydı sayısı — {"alan_var","n","adlar"}.
+
+    🔴 5 Ekim 2026 (UMIT-W7-DALGA5-1006, genel koordinatör hükmü): alan
+    yerlesimler_ek29.js'te Deyrülkamer'e kasıtlı beyan olarak yazılmıştı
+    ("başkentti" iddiası yalnız Wikipedia'da) ama ONU OKUYAN KOD YOKTU —
+    beyan hiçbir yere ulaşmıyordu (D265 ailesi). Burada sayılır ve basılır.
+    Alan kaynak YOKLUĞUNU değil ÇELİŞKİSİNİ/ZAYIFLIĞINI işaretler
+    (`VERI-YAPISI.md`). Kayıt düzeyinde ya da herhangi bir `s/d/v/isg`
+    döneminde doğru (truthy) ise kayıt sayılır.
+    `alan_var` = evrende alanı TAŞIYAN (değeri ne olursa olsun) kayıt var mı;
+    yoksa tablo eskisi gibi basılır (ibare yok).
+    """
+    try:
+        n, var, adlar = 0, False, []
+        for y in Y:
+            donemler = [p for kat in ("s", "d", "v", "isg")
+                        for p in (y.get(kat) or []) if isinstance(p, dict)]
+            if "dogrulanmadi" in y or any("dogrulanmadi" in p for p in donemler):
+                var = True
+            if y.get("dogrulanmadi") or any(p.get("dogrulanmadi") for p in donemler):
+                n += 1
+                adlar.append("%s:%s" % (y.get("_kaynak", "?"), y.get("ad", "?")))
+        return {"alan_var": var, "n": n, "adlar": adlar}
+    except Exception as e:                       # ölçülemedi ≠ 0
+        return {"hata": "%s: %s" % (type(e).__name__, str(e)[:120])}
+
+
+def dogrulanmadi_eki(dg):
+    """Yerleşim hücresinin eki — ölçülemezse sayı DEĞİL, sebep."""
+    if "hata" in dg:
+        return " · doğrulanmadı işaretli kayıt: 🔴 ÖLÇÜLEMEDİ (%s)" % dg["hata"]
+    if not dg["alan_var"]:
+        return ""
+    return " · doğrulanmadı işaretli kayıt: %d" % dg["n"]
+
+
 def olc():
     o = {}
     Y = girdi.yukle(sessiz=True)
     o["yerlesim"] = len(Y)
     o["girdi_dosya"] = len(girdi.GIRDI_DOSYALARI)
+    o["dogrulanmadi"] = dogrulanmadi_say(Y)
 
     # 🔴 5 Ekim 2026 — dört sayı REGEX'ten NODE'a taşındı; regex İKİ YÖNLÜ
     #    yanlıştı (yorum/blok yorum/iç içe adım FAZLA · `{` ayrı satır/JSON
