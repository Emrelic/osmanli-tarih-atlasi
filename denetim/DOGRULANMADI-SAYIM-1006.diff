+# ARAC-DOGRULANMADI-SINAV-1006 — `durum_tablosu.dogrulanmadi_say/_eki` sınavı
+# (UMIT-W7-DALGA5-1006). Koşum: py denetim/ARAC-DOGRULANMADI-SINAV-1006.py
+#   ① N enjeksiyonu 0/1/3 → basılan 0/1/3 (sabit değil)
+#   ② alan evrende YOKKEN Yerleşim satırı ESKİ biçimiyle birebir
+#   ③ ölçülemeyen → ÖLÇÜLEMEDİ, sayı yok
+#   ④ gerçek veri: sayaç = bağımsız metin taraması = 1 (Deyrülkamer)
+import io, os, re, sys
+
+KOK = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, os.path.join(KOK, "arac"))
+import durum_tablosu as D          # stdout'u sarar, chdir(KOK)
+import girdi
+out = sys.stdout
+gecti = toplam = 0
+
+
+def sina(ad, kosul, ayrinti=""):
+    global gecti, toplam
+    toplam += 1
+    gecti += bool(kosul)
+    out.write("%s %s%s\n" % ("✓" if kosul else "✗", ad,
+                             ("  — " + ayrinti) if (ayrinti and not kosul) else ""))
+
+
+def kayit(ad, **ek):
+    y = {"ad": ad, "lat": 0.0, "lon": 0.0, "s": [{"f": "1500-01-01", "t": "1600-01-01", "d": "x"}]}
+    y.update(ek)
+    return y
+
+
+# ① N enjeksiyonu — alan TAŞIYAN ama false olanlar sayılmaz, 0 da basılır
+for n in (0, 1, 3):
+    Y = [kayit("a%d" % i, dogrulanmadi=True) for i in range(n)]
+    Y += [kayit("yanlis", dogrulanmadi=False), kayit("alansiz")]
+    dg = D.dogrulanmadi_say(Y)
+    ek = D.dogrulanmadi_eki(dg)
+    sina("① %d işaretli → ek '· doğrulanmadı işaretli kayıt: %d'" % (n, n),
+         dg.get("n") == n and ek == " · doğrulanmadı işaretli kayıt: %d" % n, repr(ek))
+
+# dönem düzeyinde işaret de kayıt sayar (kayıt başına BİR kez)
+Y = [kayit("donemli", s=[{"f": "1500-01-01", "t": "1600-01-01", "d": "x", "dogrulanmadi": True},
+                         {"f": "1600-01-01", "t": "1700-01-01", "d": "y", "dogrulanmadi": True}])]
+sina("① dönem düzeyi işaret → 1 kayıt", D.dogrulanmadi_say(Y).get("n") == 1)
+
+# ② alan evrende yok → ek boş, Yerleşim satırı ESKİ biçim, öteki satırlar aynı
+o = D.olc()
+gercek = D.tablo(o)
+o2 = dict(o)
+o2["dogrulanmadi"] = D.dogrulanmadi_say([kayit("a"), kayit("b")])
+alansiz = D.tablo(o2)
+eski_satir = ("| Yerleşim (motorun okuduğu) | **%d** nokta, %d girdi dosyası |"
+              % (o["yerlesim"], o["girdi_dosya"]))
+sina("② alan yokken ek boş", D.dogrulanmadi_eki(o2["dogrulanmadi"]) == "")
+sina("② alan yokken Yerleşim satırı eski biçimle BİREBİR", eski_satir in alansiz.split("\n"))
+fark = [(a, b) for a, b in zip(gercek.split("\n"), alansiz.split("\n")) if a != b]
+sina("② alan yokken yalnız Yerleşim satırı farklı (öteki %d satır aynı)"
+     % (len(gercek.split("\n")) - 1),
+     len(fark) == 1 and fark[0][0].startswith("| Yerleşim"), str(fark)[:200])
+
+# ③ ölçülemeyen → ÖLÇÜLEMEDİ, rakam yok
+for ad, Y in [("Y None", None), ("kayıt sözlük değil", [kayit("a"), "bozuk"]),
+              ("dönem listesi değil", [kayit("a", s=7)])]:
+    dg = D.dogrulanmadi_say(Y)
+    ek = D.dogrulanmadi_eki(dg)
+    sina("③ %s → ÖLÇÜLEMEDİ, sayı yok" % ad,
+         "hata" in dg and "ÖLÇÜLEMEDİ" in ek and not re.search(r"kayıt: \d", ek), repr(ek))
+
+# ④ gerçek veri — sayaç ile BAĞIMSIZ okuyucu (node, tarayıcı gibi yükler) uyuşur.
+# ⚠️ Metin taraması (`dogrulanmadi\s*:\s*true`) bugün 4 verir, gerçek 1:
+#    yerlesimler_ek29.js:256 ve :260 YORUM, :579 `kaynak:` dizgesi içinde —
+#    1006'da kapatılan "metinden sayma" kusurunun aynısı. Bu yüzden node.
+import subprocess
+JS = ("const fs=require('fs');let n=0;for(const f of process.argv.slice(1)){"
+      "const W={};new Function('window',fs.readFileSync(f,'utf8'))(W);"
+      "for(const k in W){if(!/^YERLESIMLER/.test(k)||!Array.isArray(W[k]))continue;"
+      "for(const y of W[k]){const ps=['s','d','v','isg'].flatMap(a=>Array.isArray(y[a])?y[a]:[]);"
+      "if(y.dogrulanmadi||ps.some(p=>p&&p.dogrulanmadi))n++}}}process.stdout.write(String(n))")
+c = subprocess.run(["node", "-e", JS] + [os.path.join("data", f) for f in girdi.GIRDI_DOSYALARI],
+                   capture_output=True)
+bagimsiz = int(c.stdout) if c.returncode == 0 and c.stdout.strip().isdigit() else None
+metin = sum(len(re.findall(r"dogrulanmadi\s*:\s*true", D._oku(os.path.join("data", f))))
+            for f in girdi.GIRDI_DOSYALARI)
+dg = o["dogrulanmadi"]
+sina("④ gerçek: sayaç %s = node okuyucusu %s" % (dg.get("n"), bagimsiz),
+     bagimsiz is not None and dg.get("n") == bagimsiz, c.stderr[-200:].decode("utf-8", "replace"))
+out.write("  (bilgi) metin taraması %d — yorum/dizge geçişleri dahil; ölçüt DEĞİL\n" % metin)
+sina("④ gerçek: Deyrülkamer listede",
+     any("Deyrülkamer" in a for a in dg.get("adlar", [])), str(dg.get("adlar")))
+sina("④ gerçek: tabloda ek basılı",
+     "· doğrulanmadı işaretli kayıt: %d |" % dg.get("n", -1) in gercek)
+
+out.write("SINAV %d/%d\n" % (gecti, toplam))
+raise SystemExit(0 if gecti == toplam else 1)
