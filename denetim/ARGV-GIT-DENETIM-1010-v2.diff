+# -*- coding: utf-8 -*-
+"""ARAC-ARGV-GIT-DENETIM-SINAV-1010 — `denetim/ARAC-ARGV-GIT-DENETIM-1010.py`nin sınavı, İKİ YÖNDE.
+
+    py denetim/ARAC-ARGV-GIT-DENETIM-SINAV-1010.py [--kok <ağaç kökü>]
+
+Her soru, geçici bir dizinde SENTETİK `arac/*.py` dosyalarıyla koşar (+ ağaçtaki
+`arac/kabuk_nobetci.py`nin kopyası — sınıf adları ondan okunur). Hiçbir git
+komutu ÇALIŞTIRILMAZ: araç statiktir, sentetik dosyalar yalnız AST olarak okunur.
+  A1  ADD-HEPSI: run(["git","add","-A"]) yakalanır, dosya:satır ve adıyla
+  A2  ADD-HEPSI: os.system("git add . && …") (kabuk metni)
+  A3  ADD-HEPSI: projenin kendi kos(ad, argv) sarmalayıcısıyla ["git","add","--all"]
+  A4  ADD-HEPSI: `for c in (["add","-A"],): run(["git"]+c)` (döngü bağı)
+  A5  ADD-HEPSI: `git -C kok add -A -- data` (kos_ve_yayinla'nın eski satırı)
+  C1  COMMIT-HEPSI: ["git","commit","-am","x"]
+  C2  COMMIT-PATHSPECSIZ: ["git","commit","-F",mesaj]  (mesaj değişken)
+  C3  COMMIT-PATHSPECSIZ: git(*a) sarmalayıcısıyla git("commit","-m","x")
+  S1  STASH: `import subprocess as sp; sp.check_output(["git","stash","push"])`
+  P1  PUSH-ZORLA: `from subprocess import run as R; R(["git","push","-f"])` ve "+main"
+  T1  TEMİZ: pathspec'li add/commit, `git -C`, stash list, push, döngülü pathspec'li
+      commit, -F değişkenli pathspec'li commit ⇒ 0 ihlal, 0 ölçülemedi, çıkış 0
+  T2  TEMİZ dosyada git çağrıları GERÇEKTEN çözüldü (sayı > 0 — "boş geçti" değil)
+  U1  çözülemeyen argv (sys.argv'den) ⇒ ÖLÇÜLEMEDİ adıyla, çıkış 2
+  U2  ayrıştırılamayan dosya ⇒ ÖLÇÜLEMEDİ "AYRIŞTIRILAMADI" adıyla, çıkış 2
+  U3  ihlal + ölçülemedi birlikte ⇒ çıkış 1, ölçülemedi YİNE basılı
+  U4  dosyalar arası sarmalayıcı (from a import g; g(<değişken>)) ⇒ ÖLÇÜLEMEDİ adıyla
+  U5  kabuk_nobetci DALLAR'ında ADD-HEPSI yoksa ⇒ çıkış 2 (sınıf adı OKUNUYOR, uydurulmuyor)
+  U6  `git commit -F m` + bilinmeyen dizi ⇒ ÖLÇÜLEMEDİ (`--` içinde olabilir), ihlal DEĞİL
+--cwd-sinifla (v2, ARGV-GIT-DENETIM-AYIR-1010) — İKİ YÖN:
+  H1  cwd = tempfile.mkdtemp()                         ⇒ GEÇİCİ
+  H2  `with tempfile.TemporaryDirectory() as t` + -C t ⇒ GEÇİCİ
+  H3  git(d, *a) sarmalayıcısı, d = kur() dönüşü, kur içinde mkdtemp ⇒ GEÇİCİ
+  H4  işlev parametresi, BÜTÜN çağıranlar mkdtemp ⇒ GEÇİCİ
+  H5  KOK = dirname(dirname(abspath(__file__))), -C KOK ⇒ GERÇEK
+  H6  cwd/-C YOK (süreç cwd'si) ⇒ GERÇEK
+  H7  işlev parametresi, bir çağıran geçici BİRİ gerçek ⇒ GERÇEK
+  H8  cwd = sys.argv[1] (izlenemez) ⇒ ÖLÇÜLEMEDİ, "riskli" listesinde, çıkış 1
+  H9  yalnız geçici hedefli ihlaller ⇒ çıkış 0 ("HEPSİ GEÇİCİ")
+Çıkış: 0 hepsi geçti · 1 en az biri kaldı.
+"""
+import io
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+if hasattr(sys.stdout, "reconfigure"):
+    sys.stdout.reconfigure(encoding="utf-8", errors="replace", line_buffering=True)
+
+KOK = (sys.argv[sys.argv.index("--kok") + 1] if "--kok" in sys.argv
+       else os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+ARAC = os.path.join(KOK, "denetim", "ARAC-ARGV-GIT-DENETIM-1010.py")
+SONUC = []
+
+
+def sina(ad, kosul, ayrinti=""):
+    SONUC.append((ad, bool(kosul)))
+    print("%s %s %s" % ("✓" if kosul else "✗ BAŞARISIZ", ad, ayrinti))
+
+
+def kos(dosyalar, kabuk=None, ek=()):
+    d = tempfile.mkdtemp(prefix="argvgit-sinav-")
+    try:
+        os.makedirs(os.path.join(d, "arac"))
+        kn = os.path.join(KOK, "arac", "kabuk_nobetci.py")
+        metin = io.open(kn, encoding="utf-8").read()
+        if kabuk:
+            metin = kabuk(metin)
+        io.open(os.path.join(d, "arac", "kabuk_nobetci.py"), "w", encoding="utf-8").write(metin)
+        for ad, m in dosyalar.items():
+            io.open(os.path.join(d, "arac", ad), "w", encoding="utf-8").write(m)
+        if not os.path.exists(ARAC):
+            return 99, "ARAÇ YOK: %s" % ARAC
+        p = subprocess.run([sys.executable, ARAC, "--kok", d, "--ayrinti"] + list(ek), capture_output=True,
+                           text=True, encoding="utf-8", errors="replace",
+                           env=dict(os.environ, PYTHONIOENCODING="utf-8"), timeout=120)
+        return p.returncode, p.stdout + p.stderr
+    finally:
+        shutil.rmtree(d, ignore_errors=True)
+
+
+def satir_var(out, sinif, yer):
+    """`  SINIF  n` başlığından sonra `🔴 arac/<yer>` satırı var mı."""
+    blok, icinde = [], False
+    for l in out.splitlines():
+        if l.startswith("  ") and not l.startswith("     "):
+            icinde = l.split()[0] == sinif
+            continue
+        if icinde:
+            blok.append(l)
+    return any(("🔴 arac/%s " % yer) in l for l in blok)
+
+
+IHLALLI = {
+    "a1.py": 'import subprocess\nsubprocess.run(["git", "add", "-A"])\n',
+    "a2.py": 'import os\nos.system("git add . && git status")\n',
+    "a3.py": ('import subprocess, sys\n'
+              'def kos(ad, argv, dk=10):\n'
+              '    p = subprocess.Popen(argv, cwd=".")\n'
+              '    return p.wait()\n'
+              'kos("ekle", ["git", "add", "--all"])\n'),
+    "a4.py": ('import subprocess\n'
+              'for c in (["add", "-A"],):\n'
+              '    subprocess.run(["git"] + c)\n'),
+    "a5.py": ('import subprocess, os\nKOK = os.getcwd()\n'
+              'subprocess.run(["git", "-C", KOK, "add", "-A", "--", "data", "index.html"])\n'),
+    "c1.py": 'import subprocess\nsubprocess.run(["git", "commit", "-am", "x"])\n',
+    "c2.py": ('import subprocess, os\nMESAJ = os.path.join("d", "m.txt")\n'
+              'subprocess.run(["git", "commit", "-F", MESAJ])\n'),
+    "c3.py": ('import subprocess\n'
+              'def git(*a):\n'
+              '    return subprocess.run(["git"] + list(a), capture_output=True)\n'
+              'git("commit", "-m", "x")\n'),
+    "s1.py": 'import subprocess as sp\nsp.check_output(["git", "stash", "push"])\n',
+    "p1.py": ('from subprocess import run as R\n'
+              'R(["git", "push", "-f"])\n'
+              'R(["git", "push", "origin", "+main"])\n'),
+}
+TEMIZ = {
+    "t1.py": ('import subprocess, os, sys\n'
+              'KOK = os.getcwd()\nm = os.path.join(KOK, "m.txt")\n'
+              'liste = ["data/a.js", "index.html"]\n'
+              'subprocess.run(["git", "-C", KOK, "add", "--"] + liste)\n'
+              'subprocess.run(["git", "-C", KOK, "commit", "-F", m, "--"] + liste)\n'
+              'subprocess.run(["git", "stash", "list"])\n'
+              'subprocess.run(["git", "push"])\n'
+              'subprocess.run([sys.executable, "arac/denetle.py"])\n'
+              'for c in (["add", "--", "x.js"], ["commit", "-F", m, "--", "x.js"]):\n'
+              '    subprocess.run(["git", "-C", KOK] + c)\n'
+              'def kos(ad, argv):\n'
+              '    return subprocess.run(argv)\n'
+              'kos("c", ["git", "commit", "-F", m, "--", "x.js"])\n'),
+}
+
+
+def main():
+    print("Araç:", ARAC)
+    rc, out = kos(IHLALLI)
+    for ad, sinif, yer in (("A1", "ADD-HEPSI", "a1.py:2"), ("A2", "ADD-HEPSI", "a2.py:2"),
+                           ("A3", "ADD-HEPSI", "a3.py:5"), ("A4", "ADD-HEPSI", "a4.py:3"),
+                           ("A5", "ADD-HEPSI", "a5.py:3"), ("C1", "COMMIT-HEPSI", "c1.py:2"),
+                           ("C2", "COMMIT-PATHSPECSIZ", "c2.py:3"),
+                           ("C3", "COMMIT-PATHSPECSIZ", "c3.py:4"), ("S1", "STASH", "s1.py:2")):
+        sina(ad, rc == 1 and satir_var(out, sinif, yer), "%s yakalandı: arac/%s (çıkış %s)" % (sinif, yer, rc))
+    sina("P1", rc == 1 and satir_var(out, "PUSH-ZORLA", "p1.py:2")
+         and satir_var(out, "PUSH-ZORLA", "p1.py:3"), "PUSH-ZORLA: -f ve +main (çıkış %s)" % rc)
+
+    rc, out = kos(TEMIZ)
+    ihlal_yok = all(("🔴 arac/t1.py" not in l) for l in out.splitlines())
+    sina("T1", rc == 0 and ihlal_yok and "ÖLÇÜLEMEDİ           0" in out,
+         "pathspec'li/temiz çağrılar ⇒ 0 ihlal, 0 ölçülemedi (çıkış %s)" % rc)
+    n = sum(1 for l in out.splitlines() if l.strip().startswith("· arac/t1.py"))
+    sina("T2", n >= 7, "temiz dosyada çözülen git çağrısı: %d (≥7 bekleniyor)" % n)
+
+    rc, out = kos({"u1.py": 'import subprocess, sys\nsubprocess.run(sys.argv[1:])\n'})
+    sina("U1", rc == 2 and "? arac/u1.py:2" in out and "program çözülemedi" in out,
+         "çözülemeyen argv ⇒ ÖLÇÜLEMEDİ adıyla (çıkış %s)" % rc)
+
+    rc, out = kos({"u2.py": 'import subprocess\ndef (:\n'})
+    sina("U2", rc == 2 and "? arac/u2.py" in out and "AYRIŞTIRILAMADI" in out,
+         "ayrıştırılamayan dosya ⇒ ÖLÇÜLEMEDİ adıyla (çıkış %s)" % rc)
+
+    rc, out = kos({"a1.py": IHLALLI["a1.py"],
+                   "u1.py": 'import subprocess, sys\nsubprocess.run(sys.argv[1:])\n'})
+    sina("U3", rc == 1 and "? arac/u1.py:2" in out and "ÖLÇÜLEMEDİ           1" in out,
+         "ihlal + ölçülemedi ⇒ çıkış 1, ölçülemedi YİNE basılı (çıkış %s)" % rc)
+
+    rc, out = kos({"yard.py": ('import subprocess\n'
+                               'def g(*a):\n'
+                               '    return subprocess.run(["git"] + list(a))\n'),
+                   "kul.py": 'import sys\nfrom yard import g\ng(*sys.argv[1:])\n'})
+    sina("U4", rc == 2 and "? arac/kul.py:3" in out and "DOSYALAR ARASI" in out,
+         "dosyalar arası sarmalayıcı ⇒ ÖLÇÜLEMEDİ adıyla (çıkış %s)" % rc)
+
+    rc, out = kos({"a1.py": IHLALLI["a1.py"]},
+                  kabuk=lambda m: m.replace('("ADD-HEPSI", _add_hepsi', '("ADD-TUMU", _add_hepsi'))
+    sina("U5", rc == 2 and "ADD-HEPSI yok" in out,
+         "DALLAR'da ADD-HEPSI yok ⇒ çıkış 2 (çıkış %s)" % rc)
+
+    rc, out = kos({"u6.py": ('import subprocess, os, sys\nm = os.path.join("a", "b")\n'
+                             'subprocess.run(["git", "commit", "-F", m] + sys.argv[1:])\n')})
+    sina("U6", rc == 2 and "? arac/u6.py:3" in out and "COMMIT-PATHSPECSIZ   0" in out,
+         "commit + bilinmeyen dizi ⇒ ÖLÇÜLEMEDİ, ihlal DEĞİL (çıkış %s)" % rc)
+
+    # ── --cwd-sinifla ──
+    HEDEF = {
+        "h1.py": ('import subprocess, tempfile\n'
+                  'd = tempfile.mkdtemp()\n'
+                  'subprocess.run(["git", "commit", "-m", "x"], cwd=d)\n'),
+        "h2.py": ('import subprocess, tempfile\n'
+                  'with tempfile.TemporaryDirectory() as t:\n'
+                  '    subprocess.run(["git", "-C", t, "add", "-A"])\n'),
+        "h3.py": ('import subprocess, tempfile, os\n'
+                  'def git(d, *a):\n'
+                  '    return subprocess.run(["git"] + list(a), cwd=d)\n'
+                  'def kur():\n'
+                  '    d = tempfile.mkdtemp()\n'
+                  '    return d\n'
+                  'k = kur()\n'
+                  'git(k, "commit", "-am", "x")\n'),
+        "h4.py": ('import subprocess, tempfile, os\n'
+                  'def yap(kok):\n'
+                  '    A = os.path.join(kok, "A")\n'
+                  '    subprocess.run(["git", "stash"], cwd=A)\n'
+                  'yap(tempfile.mkdtemp())\n'
+                  'g = tempfile.mkdtemp()\n'
+                  'yap(g)\n'),
+        "h5.py": ('import subprocess, os\n'
+                  'KOK = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n'
+                  'subprocess.run(["git", "-C", KOK, "commit", "-F", "m.txt"])\n'),
+        "h6.py": 'import subprocess\nsubprocess.run(["git", "add", "."])\n',
+        "h7.py": ('import subprocess, tempfile, os\n'
+                  'def yap(kok):\n'
+                  '    subprocess.run(["git", "push", "-f"], cwd=kok)\n'
+                  'yap(tempfile.mkdtemp())\n'
+                  'yap(os.path.dirname(os.path.abspath(__file__)))\n'),
+        "h8.py": 'import subprocess, sys\nsubprocess.run(["git", "commit", "-m", "x"], cwd=sys.argv[1])\n',
+    }
+    rc, out = kos(HEDEF, ek=["--cwd-sinifla"])
+
+    def hedef_sinifi(yer):
+        for l in out.splitlines():
+            if l.strip().startswith("arac/" + yer + " "):
+                return l.split()[2]
+        return None
+    for ad, yer, bek in (("H1", "h1.py:3", "GEÇİCİ"), ("H2", "h2.py:3", "GEÇİCİ"),
+                         ("H3", "h3.py:8", "GEÇİCİ"), ("H4", "h4.py:4", "GEÇİCİ"),
+                         ("H5", "h5.py:3", "GERÇEK"), ("H6", "h6.py:2", "GERÇEK"),
+                         ("H7", "h7.py:3", "GERÇEK"), ("H8", "h8.py:2", "ÖLÇÜLEMEDİ")):
+        sina(ad, hedef_sinifi(yer) == bek, "arac/%s hedef = %s (beklenen %s)" % (yer, hedef_sinifi(yer), bek))
+    riskli = out.split("koşturulursa ne yapar:")[-1] if "koşturulursa ne yapar:" in out else ""
+    sina("H8b", rc == 1 and "arac/h8.py:2" in riskli and "arac/h1.py:3" not in riskli,
+         "ÖLÇÜLEMEDİ riskli listesinde, GEÇİCİ değil; çıkış %s" % rc)
+    rc, out = kos({k: HEDEF[k] for k in ("h1.py", "h2.py", "h3.py", "h4.py")}, ek=["--cwd-sinifla"])
+    sina("H9", rc == 0 and "HEPSİ GEÇİCİ" in out, "yalnız geçici ihlaller ⇒ çıkış %s" % rc)
+
+    g = sum(1 for _, k in SONUC if k)
+    print("SONUÇ: %d/%d geçti" % (g, len(SONUC)))
+    return 0 if g == len(SONUC) else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
