+# -*- coding: utf-8 -*-
+"""ARAC-ARGV-GIT-DENETIM-1010 — araçların İÇİNDEKİ git çağrılarının STATİK denetimi.
+
+🔴 NİÇİN (KOS-VE-YAYINLA-ADD-1010): `kos_ve_yayinla.py` aylarca
+    kos("git add", ["git", "add", "-A", "--", "data", "index.html"])
+    kos("git commit", ["git", "commit", "-F", MESAJ])          ← pathspec YOK
+çalıştırdı. `arac/kabuk_nobetci.py`nin ADD-HEPSI dalı `git add -A`yı KABUK
+METNİNDE yakalar; bir aracın `subprocess` argv LİSTESİ onun evreninde değildi.
+Kanca da dört makinede kayıtlı değil (`.claude/settings.json` gitignore'da).
+⇒ Yasak, komutun METNİNE değil KOMUTUN KENDİSİNE yazılır: bu araç `arac/**/*.py`
+dosyalarını AST ile okur, git'e giden her argv'yi ÇÖZER ve sınıflar.
+Kapı ya da kanca DEĞİL; `denetle.py`ye bağlı DEĞİL (tek-sahip kuralı).
+
+ÇÖZÜLEN ÇAĞRILAR
+  • subprocess.run/call/Popen/check_output/check_call/getoutput/getstatusoutput
+    (`import subprocess as X` ve `from subprocess import run as Y` dahil)
+  • os.system / os.popen (kabuk metni)
+  • DOSYANIN KENDİ SARMALAYICILARI: bir işlevin parametresi (ya da *args'ı) bir
+    subprocess çağrısının argv'sine akıyorsa o işlev SARMALAYICIDIR (kos(),
+    _calistir(), git(*a) …). İç çağrı raporlanmaz; sarmalayıcıyı çağıran HER
+    satır, parametre bağlanarak çözülür. Sarmalayıcıyı çağıran sarmalayıcı
+    da (3 tura kadar) çözülür.
+  • Ad çözümü: aynı kapsamda çağrıdan ÖNCEKİ `X = [...]`, `X += [...]`,
+    `X.append(..)`, `X.extend(..)` (denetim akışı yok sayılır — yaklaşık).
+    `sys.executable` "python" sayılır.
+
+SINIFLAR (ilk ad `arac/kabuk_nobetci.py` DALLAR'ından OKUNUR, değiştirilmez)
+  ADD-HEPSI            git add -A / --all / .            (kabuk_nobetci adı)
+  COMMIT-HEPSI         git commit -a / --all / -am …
+  COMMIT-PATHSPECSIZ   git commit, `--` YOK              (YENİ: paylaşılan indeks)
+  STASH                git stash (list/show HARİÇ)       (proje yasağı)
+  PUSH-ZORLA           git push --force / -f / --force-with-lease / +refspec
+
+ÖLÇÜLEMEDİ (adıyla, sebebiyle): ayrıştırılamayan dosya · argv çözülemedi (program
+bilinmiyor) · git alt komutu çözülemedi · çözülemeyen parça kararı değiştirebilir
+(ör. `["git","commit","-F",m] + liste` ve liste bilinmiyor — `--` içinde olabilir).
+
+    py denetim/ARAC-ARGV-GIT-DENETIM-1010.py [--kok <ağaç>] [--dizin arac] [--ayrinti]
+                                            [--cwd-sinifla]
+
+--cwd-sinifla (v2, ARGV-GIT-DENETIM-AYIR-1010): her ihlalin HEDEF DEPOSU sınıflanır.
+  Hedef = argv'deki `-C <x>`, yoksa çağrının `cwd=`'si, yoksa SÜREÇ CWD'Sİ. İfade
+  geriye izlenir: atama · `with … as x` · sarmalayıcı parametresi (çağıranın
+  argümanı) · işlev parametresi (AYNI DOSYADAKİ bütün çağıranlar) · os.path.join/
+  abspath/realpath/normpath/dirname/str/Path/.replace (ilk argüman/alıcı) · `/` ve `+`.
+    GEÇİCİ      tempfile.mkdtemp/TemporaryDirectory/mkstemp/gettempdir · sabit yolda
+                Temp/tmp/scratchpad
+    GERÇEK      `__file__`'dan türeyen kök · os.getcwd() · süreç cwd'si (cwd/-C yok)
+                · başka sabit yol
+    ÖLÇÜLEMEDİ  izlenemeyen her şey — GÜVENLİ YÖN: "GERÇEK depoya dokunuyor" VARSAYILIR
+  Bu kipte çıkış: 0 bütün ihlaller GEÇİCİ (ve argv ölçülemedi yok) · 1 GERÇEK ya da
+  ÖLÇÜLEMEDİ hedefli ihlal var · 2 yalnız argv ölçülemedi.
+Çıkış: 0 temiz · 1 İHLAL · 2 ÖLÇÜLEMEDİ (ihlal yoksa). İhlal varsa ölçülemeyenler
+YİNE basılır.
+"""
+import ast
+import glob
+import io
+import os
+import re
+import shlex
+import sys
+import warnings
+
+warnings.simplefilter("ignore", SyntaxWarning)   # taranan dosyaların kaçış uyarıları
+
+if hasattr(sys.stdout, "reconfigure"):
+    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
+
+SP_FONK = {"run", "call", "Popen", "check_output", "check_call", "getoutput",
+           "getstatusoutput"}
+OS_FONK = {"system", "popen"}
+BILINMEZ = None                    # bilinmeyen TEK öğe
+DIZI = object()                    # bilinmeyen UZUNLUKTA dizi (Starred, çözülemeyen ad)
+
+
+class Cozulemedi(Exception):
+    pass
+
+
+# ── sınıf adları kabuk_nobetci'den ─────────────────────────────────────────
+def kabuk_siniflari(kok):
+    yol = os.path.join(kok, "arac", "kabuk_nobetci.py")
+    agac = ast.parse(io.open(yol, encoding="utf-8").read())
+    for n in agac.body:
+        if isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id == "DALLAR"
+                                             for t in n.targets):
+            return [e.elts[0].value for e in n.value.elts
+                    if isinstance(e, ast.Tuple) and isinstance(e.elts[0], ast.Constant)]
+    raise Cozulemedi("kabuk_nobetci.py DALLAR bulunamadı")
+
+
+# ── argv çözümü ────────────────────────────────────────────────────────────
+class Kapsam:
+    """Bir işlev (ya da modül) gövdesi: ad → [(satır, düğüm, tür)]."""
+
+    def __init__(self, govde):
+        self.olay = {}
+        self.ile = {}                  # with … as ad → (satır, bağlam ifadesi)
+        for n in ast.walk(ast.Module(body=govde, type_ignores=[])):
+            if isinstance(n, ast.Assign):
+                for t in n.targets:
+                    if isinstance(t, ast.Name):
+                        self.olay.setdefault(t.id, []).append((n.lineno, n.value, "="))
+            elif isinstance(n, (ast.With, ast.AsyncWith)):
+                for it in n.items:
+                    if isinstance(it.optional_vars, ast.Name):
+                        self.ile.setdefault(it.optional_vars.id, []).append(
+                            (n.lineno, it.context_expr))
+            elif isinstance(n, ast.AugAssign) and isinstance(n.target, ast.Name) \
+                    and isinstance(n.op, ast.Add):
+                self.olay.setdefault(n.target.id, []).append((n.lineno, n.value, "+="))
+            elif isinstance(n, ast.Call) and isinstance(n.func, ast.Attribute) \
+                    and isinstance(n.func.value, ast.Name) and n.args \
+                    and n.func.attr in ("append", "extend", "insert"):
+                self.olay.setdefault(n.func.value.id, []).append(
+                    (n.lineno, n.args[-1], n.func.attr))
+
+
+def coz(e, bag, kapsamlar, satir, derinlik=0):
+    """İfade → öğe listesi (str · BILINMEZ · DIZI). Yapı çözülemezse Cozulemedi."""
+    if derinlik > 12:
+        raise Cozulemedi("çözüm derinliği aşıldı")
+    d = derinlik + 1
+    if isinstance(e, (ast.List, ast.Tuple)):
+        out = []
+        for x in e.elts:
+            if isinstance(x, ast.Starred):
+                out += coz(x.value, bag, kapsamlar, satir, d)
+            else:
+                out.append(oge(x, bag, kapsamlar, satir, d))
+        return out
+    if isinstance(e, ast.BinOp) and isinstance(e.op, ast.Add):
+        return coz(e.left, bag, kapsamlar, satir, d) + coz(e.right, bag, kapsamlar, satir, d)
+    if isinstance(e, ast.Call) and isinstance(e.func, ast.Name) and e.func.id in ("list", "tuple") \
+            and len(e.args) == 1:
+        return coz(e.args[0], bag, kapsamlar, satir, d)
+    if isinstance(e, ast.Name):
+        if e.id in bag:
+            return list(bag[e.id])
+        for k in kapsamlar:
+            olay = [o for o in k.olay.get(e.id, []) if o[0] < satir]
+            if not olay:
+                continue
+            son_atama = max((i for i, o in enumerate(olay) if o[2] == "="), default=None)
+            if son_atama is None:
+                return [DIZI]
+            deger = coz(olay[son_atama][1], bag, kapsamlar, olay[son_atama][0], d)
+            for no, x, tur in olay[son_atama + 1:]:
+                if tur == "+=" or tur == "extend":
+                    deger += _guvenli_coz(x, bag, kapsamlar, no, d)
+                elif tur == "append":
+                    deger.append(oge(x, bag, kapsamlar, no, d))
+                else:
+                    deger.append(DIZI)
+            return deger
+        return [DIZI]
+    if isinstance(e, ast.Starred):
+        return coz(e.value, bag, kapsamlar, satir, d)
+    if isinstance(e, ast.Constant) and isinstance(e.value, str):
+        raise Cozulemedi("argv bir METİN (kabuk) — liste değil")
+    return [DIZI]
+
+
+def _guvenli_coz(x, bag, kapsamlar, satir, d):
+    try:
+        return coz(x, bag, kapsamlar, satir, d)
+    except Cozulemedi:
+        return [DIZI]
+
+
+def oge(x, bag, kapsamlar, satir, d):
+    if isinstance(x, ast.Constant) and isinstance(x.value, str):
+        return x.value
+    if isinstance(x, ast.Attribute) and isinstance(x.value, ast.Name) \
+            and x.value.id == "sys" and x.attr == "executable":
+        return "python"
+    if isinstance(x, ast.Name):
+        if x.id in bag:
+            v = bag[x.id]
+            return v[0] if len(v) == 1 and isinstance(v[0], str) else BILINMEZ
+        for k in kapsamlar:
+            olay = [o for o in k.olay.get(x.id, []) if o[0] < satir and o[2] == "="]
+            if olay and isinstance(olay[-1][1], ast.Constant) and isinstance(olay[-1][1].value, str):
+                return olay[-1][1].value
+    if isinstance(x, ast.IfExp):
+        a, b = oge(x.body, bag, kapsamlar, satir, d), oge(x.orelse, bag, kapsamlar, satir, d)
+        if a is BILINMEZ or b is BILINMEZ:
+            return BILINMEZ
+        if "git" in (os.path.basename(a).lower(), os.path.basename(b).lower()):
+            return "git"
+        return a if a == b else "%s|%s" % (a, b)
+    if isinstance(x, ast.JoinedStr):
+        parca = [v.value for v in x.values if isinstance(v, ast.Constant)]
+        return "".join(parca) if parca and len(parca) == len(x.values) else BILINMEZ
+    return BILINMEZ
+
+
+def metin(e, bag, kapsamlar, satir):
+    """Kabuk metni → str ({} = bilinmeyen parça) ya da Cozulemedi."""
+    if isinstance(e, ast.Constant) and isinstance(e.value, str):
+        return e.value
+    if isinstance(e, ast.JoinedStr):
+        return "".join(v.value if isinstance(v, ast.Constant) else "{}" for v in e.values)
+    if isinstance(e, ast.BinOp) and isinstance(e.op, (ast.Add, ast.Mod)):
+        sol = metin(e.left, bag, kapsamlar, satir)
+        if isinstance(e.op, ast.Mod):
+            return sol
+        return sol + metin(e.right, bag, kapsamlar, satir)
+    if isinstance(e, ast.Name):
+        for k in kapsamlar:
+            olay = [o for o in k.olay.get(e.id, []) if o[0] < satir and o[2] == "="]
+            if olay:
+                return metin(olay[-1][1], bag, kapsamlar, olay[-1][0])
+    raise Cozulemedi("kabuk metni çözülemedi")
+
+
+# ── sınıflama ──────────────────────────────────────────────────────────────
+GLOBAL_DEGERLI = {"-C", "-c", "--git-dir", "--work-tree", "--namespace", "--exec-path"}
+
+
+def sinifla(argv, add_adi):
+    """argv öğeleri → ([(sınıf, açıklama)], ölçülemedi_sebebi|None). git değilse ([], None)."""
+    if not argv:
+        return [], None
+    p = argv[0]
+    if p is DIZI:
+        return [], "program çözülemedi (argv bilinmeyen bir diziyle başlıyor)"
+    if p is BILINMEZ:
+        return [], "program çözülemedi (argv[0] bilinmiyor)"
+    if os.path.basename(p).lower() not in ("git", "git.exe"):
+        return [], None
+    i = 1
+    while i < len(argv):
+        t = argv[i]
+        if t is DIZI or t is BILINMEZ:
+            return [], "git alt komutu çözülemedi"
+        if t in GLOBAL_DEGERLI:
+            i += 2
+            continue
+        if t.startswith("-"):
+            i += 1
+            continue
+        break
+    if i >= len(argv):
+        return [], None
+    alt, arg = argv[i], argv[i + 1:]
+    bilinen = [a for a in arg if isinstance(a, str)]
+    # 📌 Yalnız DIZI (bilinmeyen UZUNLUKTA parça) `--`/-A taşıyabilir sayılır;
+    #    tek BILINMEZ öğe bir DEĞERDİR (yol değişkeni, -F dosyası) — "--" ya da
+    #    "-A" olduğunu varsaymak her yol değişkeninde yanlış "ölçülemedi" üretir.
+    belirsiz = any(a is DIZI for a in arg)
+    once = []                                   # `--`dan önceki seçenekler
+    for a in arg:
+        if a == "--":
+            break
+        once.append(a)
+    ihlal = []
+    if alt == "add":
+        if any(a in ("-A", "--all") for a in bilinen) or "." in bilinen:
+            ihlal.append((add_adi, "git add %s" % " ".join(_g(a) for a in arg)))
+        elif belirsiz and "--" not in bilinen:
+            return [], "git add argümanı çözülemedi (-A/. içerebilir, `--` yok)"
+    elif alt == "commit":
+        if any(a in ("-a", "--all") or (isinstance(a, str) and re.fullmatch(r"-[A-Za-z]*a[A-Za-z]*", a)
+                                         and not a.startswith("--"))
+               for a in once if isinstance(a, str)):
+            ihlal.append(("COMMIT-HEPSI", "git commit %s" % " ".join(_g(a) for a in arg)))
+        if "--" not in bilinen:
+            if belirsiz:
+                return ihlal, "git commit argümanı çözülemedi (`--` içinde olabilir)"
+            ihlal.append(("COMMIT-PATHSPECSIZ", "git commit %s" % " ".join(_g(a) for a in arg)))
+    elif alt == "stash":
+        ilk = arg[0] if arg else None
+        if ilk not in ("list", "show"):
+            ihlal.append(("STASH", "git stash %s" % " ".join(_g(a) for a in arg)))
+    elif alt == "push":
+        if any(a in ("--force", "-f", "--force-with-lease") or a.startswith("--force")
+               or (a.startswith("+") and len(a) > 1) for a in bilinen):
+            ihlal.append(("PUSH-ZORLA", "git push %s" % " ".join(_g(a) for a in arg)))
+    return ihlal, None
+
+
+def _g(a):
+    return "<?>" if a is BILINMEZ else ("<…>" if a is DIZI else a)
+
+
+def kabuk_sinifla(m, add_adi):
+    """Kabuk metninde git komut(lar)ı; kabuk_nobetci düzenleriyle."""
+    ihlal = []
+    for parca in re.split(r"&&|\|\||;|\|", m):
+        try:
+            argv = shlex.split(parca, posix=True)
+        except ValueError:
+            argv = parca.split()
+        argv = [BILINMEZ if a == "{}" else a for a in argv]
+        if argv and argv[0] in ("git", "git.exe"):
+            i, _ = sinifla(argv, add_adi)
+            ihlal += i
+    return ihlal
+
+
+# ── dosya taraması ─────────────────────────────────────────────────────────
+def _islevler(agac):
+    return [n for n in ast.walk(agac) if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))]
+
+
+def tara_dosya(yol, add_adi, goreli):
+    kaynak = io.open(yol, encoding="utf-8", errors="strict").read()
+    agac = ast.parse(kaynak, filename=yol)
+    sp_mod, sp_ad, os_mod = set(), {}, set()
+    for n in ast.walk(agac):
+        if isinstance(n, ast.Import):
+            for a in n.names:
+                if a.name == "subprocess":
+                    sp_mod.add(a.asname or "subprocess")
+                if a.name == "os":
+                    os_mod.add(a.asname or "os")
+        elif isinstance(n, ast.ImportFrom) and n.module == "subprocess":
+            for a in n.names:
+                if a.name in SP_FONK:
+                    sp_ad[a.asname or a.name] = a.name
+    if not sp_mod and not sp_ad and not os_mod:
+        return [], [], 0, [], [], {}
+
+    def tur(c):
+        f = c.func
+        if isinstance(f, ast.Attribute) and isinstance(f.value, ast.Name):
+            if f.value.id in sp_mod and f.attr in SP_FONK:
+                return "sp"
+            if f.value.id in os_mod and f.attr in OS_FONK:
+                return "os"
+        if isinstance(f, ast.Name) and f.id in sp_ad:
+            return "sp"
+        return None
+
+    # düğüm → en içteki işlev · düğüm → kapsayan For düğümleri (dıştan içe)
+    ebeveyn, donguler = {}, {}
+
+    def _in(n, fn, fors):
+        for c in ast.iter_child_nodes(n):
+            ebeveyn[c] = fn
+            donguler[c] = fors
+            if isinstance(c, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                _in(c, c, ())
+            elif isinstance(c, ast.For):
+                ebeveyn[c.iter] = fn
+                donguler[c.iter] = fors
+                _in(c, fn, fors + (c,))
+            else:
+                _in(c, fn, fors)
+    _in(agac, None, ())
+    modul_k = Kapsam(agac.body)
+    fk = {fn: Kapsam(fn.body) for fn in _islevler(agac)}
+
+    def kapsamlar(dugum):
+        fn = ebeveyn.get(dugum)
+        return ([fk[fn]] if fn else []) + [modul_k]
+
+    def argv_ifadesi(c):
+        e = c.args[0] if c.args else next((k.value for k in c.keywords if k.arg in ("args", "command", "cmd")), None)
+        kabuk = any(k.arg == "shell" and isinstance(k.value, ast.Constant) and k.value.value
+                    for k in c.keywords)
+        return e, kabuk
+
+    # sarmalayıcılar: işlev adı → (parametre adları, vararg adı, [(argv ifadesi, kabuk, çağrı)])
+    sarmal = {}
+    cagrilar = [n for n in ast.walk(agac) if isinstance(n, ast.Call)]
+    for _tur in range(3):
+        for c in cagrilar:
+            fn = ebeveyn.get(c)
+            if fn is None:
+                continue
+            params = [a.arg for a in fn.args.args + fn.args.kwonlyargs]
+            var = fn.args.vararg.arg if fn.args.vararg else None
+            if tur(c):
+                e, kabuk = argv_ifadesi(c)
+            elif isinstance(c.func, ast.Name) and c.func.id in sarmal and c.func.id != fn.name:
+                e, kabuk = c, False
+            else:
+                continue
+            if e is None:
+                continue
+            adlar = {x.id for x in ast.walk(e) if isinstance(x, ast.Name)}
+            if adlar & (set(params) | ({var} if var else set())):
+                kayit = sarmal.setdefault(fn.name, (params, var, []))
+                if (e, kabuk, c) not in kayit[2]:
+                    kayit[2].append((e, kabuk, c))
+
+    ihlal, olc, gitler = [], [], []
+    hedefler = {}
+    say = 0
+    islev_ad = {f.name: f for f in fk}
+    cagri_ad = {}
+    for _c in cagrilar:
+        if isinstance(_c.func, ast.Name):
+            cagri_ad.setdefault(_c.func.id, []).append(_c)
+
+    GECICI_FONK = {"mkdtemp", "TemporaryDirectory", "mkstemp", "gettempdir", "NamedTemporaryFile"}
+    SARMA_FONK = {"join", "abspath", "realpath", "normpath", "dirname", "expanduser", "str",
+                  "Path", "fspath", "replace", "resolve", "PurePath"}
+
+    def yol_sinifla(e, fn, satir, ib, d=0, ziyaret=None):
+        """Yol ifadesi → (GEÇİCİ|GERÇEK|ÖLÇÜLEMEDİ, açıklama zinciri)."""
+        ziyaret = ziyaret if ziyaret is not None else set()
+        if d > 10:
+            return "ÖLÇÜLEMEDİ", "iz 10 adımdan derin"
+        kaps = ([fk[fn]] if fn in fk else []) + [modul_k]
+        if e is None or (isinstance(e, ast.Constant) and e.value is None):
+            return "GERÇEK", "cwd/-C yok ⇒ süreç cwd'si"
+        if isinstance(e, ast.Constant) and isinstance(e.value, str):
+            if re.search(r"(?i)temp|tmp|scratchpad", e.value):
+                return "GEÇİCİ", "sabit %r" % e.value[:40]
+            return "GERÇEK", "sabit yol %r" % e.value[:40]
+        if isinstance(e, ast.Name):
+            if e.id == "__file__":
+                return "GERÇEK", "__file__"
+            if e.id in ib and ib[e.id][0] == "tek":
+                _t, x, fn2, l2, ib2 = ib[e.id]
+                s_, a_ = yol_sinifla(x, fn2, l2, ib2, d + 1, ziyaret)
+                return s_, "%s ← (çağıran:%d) %s" % (e.id, l2, a_)
+            # kapsam zinciri: en içteki işlev → kapsayan işlevler (kapanış) → modül
+            zincir, f_ = [], fn
+            while f_ is not None:
+                zincir.append(f_)
+                f_ = ebeveyn.get(f_)
+            for sira, fs in enumerate(zincir + [None]):
+                k = fk[fs] if fs is not None else modul_k
+                sinir = satir if sira == 0 else 10 ** 9      # kapanış: satır sınırı yok
+                w_ = [o for o in k.ile.get(e.id, []) if o[0] <= sinir]
+                a_ = [o for o in k.olay.get(e.id, []) if o[0] < sinir and o[2] == "="]
+                son = max(w_ + a_, key=lambda o: o[0], default=None)
+                if son is not None:
+                    s_, ac = yol_sinifla(son[1], fs, son[0], ib if sira == 0 else {}, d + 1, ziyaret)
+                    return s_, "%s ← :%d %s" % (e.id, son[0], ac)
+                if fs is None or e.id not in [a.arg for a in fs.args.args + fs.args.kwonlyargs]:
+                    continue
+                anahtar = (fs.name, e.id)
+                if anahtar in ziyaret:
+                    return "ÖLÇÜLEMEDİ", "özyineli parametre %s" % e.id
+                ziyaret = ziyaret | {anahtar}
+                konum = [a.arg for a in fs.args.args]
+                cagiran = cagri_ad.get(fs.name, [])
+                if not cagiran:
+                    return "ÖLÇÜLEMEDİ", "%s() parametresi %s, dosyada çağıran YOK" % (fs.name, e.id)
+                sonuc = []
+                for cc in cagiran:
+                    x = None
+                    if e.id in konum and konum.index(e.id) < len(cc.args):
+                        x = cc.args[konum.index(e.id)]
+                    for kw in cc.keywords:
+                        if kw.arg == e.id:
+                            x = kw.value
+                    if x is None:
+                        dfl = dict(zip(konum[len(konum) - len(fs.args.defaults):], fs.args.defaults))
+                        dfl.update({a.arg: v for a, v in zip(fs.args.kwonlyargs, fs.args.kw_defaults)
+                                    if v is not None})
+                        x = dfl.get(e.id)
+                    if x is None or isinstance(x, ast.Starred):
+                        sonuc.append(("ÖLÇÜLEMEDİ", ":%d argüman yok/yıldızlı" % cc.lineno))
+                        continue
+                    s_, ac = yol_sinifla(x, ebeveyn.get(cc), cc.lineno, {}, d + 1, ziyaret)
+                    sonuc.append((s_, ":%d %s" % (cc.lineno, ac)))
+                for kova in ("GERÇEK", "ÖLÇÜLEMEDİ"):
+                    if any(x[0] == kova for x in sonuc):
+                        return kova, "%s() parametresi %s ← %s" % (
+                            fs.name, e.id, next(x[1] for x in sonuc if x[0] == kova))
+                return "GEÇİCİ", "%s() parametresi %s ← %d çağıranın hepsi geçici (%s)" % (
+                    fs.name, e.id, len(sonuc), sonuc[0][1])
+            return "ÖLÇÜLEMEDİ", "%s izlenemedi" % e.id
+        if isinstance(e, ast.Call):
+            f = e.func
+            ad = f.attr if isinstance(f, ast.Attribute) else (f.id if isinstance(f, ast.Name) else "")
+            if ad in GECICI_FONK:
+                return "GEÇİCİ", "tempfile.%s" % ad
+            if isinstance(f, ast.Name) and f.id in islev_ad:
+                # AYNI DOSYADAKİ işlevin dönüş değeri: bütün `return`ler sınıflanır
+                fh = islev_ad[f.id]
+                anahtar = ("return", fh.name)
+                if anahtar in ziyaret:
+                    return "ÖLÇÜLEMEDİ", "özyineli dönüş %s()" % fh.name
+                donusler = [r for r in ast.walk(fh) if isinstance(r, ast.Return)
+                            and r.value is not None and ebeveyn.get(r) is fh]
+                if not donusler:
+                    return "ÖLÇÜLEMEDİ", "%s() değer döndürmüyor" % fh.name
+                sonuc = []
+                for r in donusler:
+                    v = r.value.elts[0] if isinstance(r.value, ast.Tuple) and r.value.elts else r.value
+                    s_, ac = yol_sinifla(v, fh, r.lineno, {}, d + 1, ziyaret | {anahtar})
+                    sonuc.append((s_, ":%d %s" % (r.lineno, ac)))
+                for kova in ("GERÇEK", "ÖLÇÜLEMEDİ"):
+                    if any(x[0] == kova for x in sonuc):
+                        return kova, "%s() dönüşü ← %s" % (fh.name, next(x[1] for x in sonuc if x[0] == kova))
+                return "GEÇİCİ", "%s() dönüşü ← %s" % (fh.name, sonuc[0][1])
+            if ad in ("getcwd", "getcwdb"):
+                return "GERÇEK", "os.getcwd()"
+            if ad in SARMA_FONK:
+                if ad == "replace" and isinstance(f, ast.Attribute):
+                    return yol_sinifla(f.value, fn, satir, ib, d + 1, ziyaret)
+                if ad == "resolve" and isinstance(f, ast.Attribute):
+                    return yol_sinifla(f.value, fn, satir, ib, d + 1, ziyaret)
+                if e.args:
+                    s_, ac = yol_sinifla(e.args[0], fn, satir, ib, d + 1, ziyaret)
+                    return s_, "%s(%s)" % (ad, ac)
+            return "ÖLÇÜLEMEDİ", "çağrı %s()" % (ad or "?")
+        if isinstance(e, ast.BinOp) and isinstance(e.op, (ast.Div, ast.Add)):
+            return yol_sinifla(e.left, fn, satir, ib, d + 1, ziyaret)
+        if isinstance(e, ast.JoinedStr) and e.values:
+            v0 = e.values[0]
+            return yol_sinifla(v0.value if isinstance(v0, ast.FormattedValue) else v0,
+                               fn, satir, ib, d + 1, ziyaret)
+        return "ÖLÇÜLEMEDİ", "ifade türü %s" % type(e).__name__
+
+    def C_ara(e, fn, satir, ib, d=0):
+        """argv ifadesinde `-C <x>` → (x, fn, satır, ib) ya da None."""
+        if d > 8 or e is None:
+            return None
+        elts = None
+        if isinstance(e, (ast.List, ast.Tuple)):
+            elts = [(x, fn, satir, ib) for x in e.elts]
+        elif isinstance(e, ast.BinOp) and isinstance(e.op, ast.Add):
+            return C_ara(e.left, fn, satir, ib, d + 1) or C_ara(e.right, fn, satir, ib, d + 1)
+        elif isinstance(e, ast.Call) and isinstance(e.func, ast.Name) and e.func.id in ("list", "tuple") \
+                and e.args:
+            return C_ara(e.args[0], fn, satir, ib, d + 1)
+        elif isinstance(e, ast.Starred):
+            return C_ara(e.value, fn, satir, ib, d + 1)
+        elif isinstance(e, ast.Name) and e.id in ib and ib[e.id][0] == "dizi":
+            elts = ib[e.id][1]
+        elif isinstance(e, ast.Name):
+            kaps = ([fk[fn]] if fn in fk else []) + [modul_k]
+            for k in kaps:
+                o = [x for x in k.olay.get(e.id, []) if x[0] < satir and x[2] == "="]
+                if o:
+                    return C_ara(o[-1][1], fn, o[-1][0], ib, d + 1)
+            return None
+        if elts is None:
+            return None
+        for i, (x, f2, l2, ib2) in enumerate(elts):
+            if isinstance(x, ast.Starred):
+                r = C_ara(x.value, f2, l2, ib2, d + 1)
+                if r:
+                    return r
+            elif isinstance(x, ast.Constant) and x.value == "-C" and i + 1 < len(elts):
+                return elts[i + 1]
+        return None
+
+    def hedef(argv_e, c, ib):
+        fn = ebeveyn.get(c)
+        r = C_ara(argv_e, fn, c.lineno, ib) if argv_e is not None else None
+        if r:
+            s_, ac = yol_sinifla(r[0], r[1], r[2], r[3])
+            return s_, "-C " + ac
+        for k in c.keywords:
+            if k.arg == "cwd":
+                s_, ac = yol_sinifla(k.value, fn, c.lineno, ib)
+                return s_, "cwd= " + ac
+        return "GERÇEK", "cwd/-C yok ⇒ süreç cwd'si"
+
+    def degerlendir(argv_e, kabuk, bag, kaps, satir, yer, c=None, ib=None):
+        nonlocal say
+        say += 1
+        try:
+            if kabuk or (isinstance(argv_e, (ast.Constant, ast.JoinedStr))):
+                m = metin(argv_e, bag, kaps, satir)
+                if re.search(r"\bgit\b", m):
+                    gitler.append((yer, "(kabuk) " + m[:90]))
+                for s, a in kabuk_sinifla(m, add_adi):
+                    ihlal.append((yer, s, a))
+                    if c is not None:
+                        hedefler[(yer, s, a)] = hedef(None, c, ib or {})
+                return
+            argv = coz(argv_e, bag, kaps, satir)
+        except Cozulemedi as ex:
+            olc.append((yer, str(ex)))
+            return
+        i, sebep = sinifla(argv, add_adi)
+        if argv and isinstance(argv[0], str) and os.path.basename(argv[0]).lower() in ("git", "git.exe"):
+            _k = (yer, " ".join(_g(a) for a in argv)[:110])
+            if _k not in gitler:
+                gitler.append(_k)
+        for s, a in i:
+            ihlal.append((yer, s, a))
+            if c is not None:
+                hedefler[(yer, s, a)] = hedef(argv_e, c, ib or {})
+        if sebep:
+            olc.append((yer, "%s: %s" % (sebep, " ".join(_g(a) for a in argv)[:90])))
+
+    def sarmal_coz(ad, c, kaps, yer, derinlik=0, dis_bag=None, tohum=None, dis_ib=None):
+        dis_bag = dis_bag or {}
+        dis_ib = dis_ib or {}
+        params, var, ic = sarmal[ad]
+        fn_d = next((f for f in fk if f.name == ad), None)
+        bag = {}
+        ib = {}
+        fn_c = ebeveyn.get(c)
+        if fn_d is not None:
+            _konum = [a.arg for a in fn_d.args.args]
+            for p_, dv in zip(_konum[len(_konum) - len(fn_d.args.defaults):], fn_d.args.defaults):
+                ib[p_] = ("tek", dv, None, fn_d.lineno, {})
+            for a_, dv in zip(fn_d.args.kwonlyargs, fn_d.args.kw_defaults):
+                if dv is not None:
+                    ib[a_.arg] = ("tek", dv, None, fn_d.lineno, {})
+            for i_, p_ in enumerate(_konum):
+                if i_ < len(c.args) and not isinstance(c.args[i_], ast.Starred):
+                    ib[p_] = ("tek", c.args[i_], fn_c, c.lineno, dis_ib)
+            for k_ in c.keywords:
+                if k_.arg:
+                    ib[k_.arg] = ("tek", k_.value, fn_c, c.lineno, dis_ib)
+            if fn_d.args.vararg:
+                ib[fn_d.args.vararg.arg] = ("dizi", [(x, fn_c, c.lineno, dis_ib)
+                                                    for x in c.args[len(_konum):]])
+        if fn_d is not None:
+            vars_ = fn_d.args.defaults
+            for p, dv in zip([a.arg for a in fn_d.args.args][-len(vars_):] if vars_ else [], vars_):
+                bag[p] = _bag_degeri(dv, kaps, c.lineno, dis_bag)
+        npos = len(fn_d.args.args) if fn_d is not None else len(params)
+        for i, p in enumerate(params[:npos]):
+            if i < len(c.args):
+                bag[p] = _bag_degeri(c.args[i], kaps, c.lineno, dis_bag)
+        for k in c.keywords:
+            if k.arg in params:
+                bag[k.arg] = _bag_degeri(k.value, kaps, c.lineno, dis_bag)
+        if tohum:
+            bag.update(tohum)                     # güvenlik ölçümü: her parametre DIZI
+        if var and not tohum:
+            bag[var] = []
+            for x in c.args[npos:]:
+                if isinstance(x, ast.Starred):
+                    bag[var] += _guvenli_coz(x.value, dis_bag, kaps, c.lineno, 0)
+                else:
+                    bag[var].append(oge(x, dis_bag, kaps, c.lineno, 0))
+        for e, kabuk, icc in ic:
+            fn = ebeveyn.get(icc)
+            kaps_ic = ([fk[fn]] if fn else []) + [modul_k]
+            for lb in dongu_baglari(icc, kaps_ic, bag):
+                mb = dict(bag)
+                mb.update(lb)
+                if e is icc:                       # sarmalayıcı → sarmalayıcı
+                    if derinlik < 3 and icc.func.id in sarmal:
+                        sarmal_coz(icc.func.id, icc, kaps_ic, yer, derinlik + 1, dis_bag=mb,
+                                   dis_ib=ib)
+                    elif derinlik >= 3:
+                        olc.append((yer, "sarmalayıcı zinciri 3 turdan derin"))
+                    continue
+                degerlendir(e, kabuk, mb, kaps_ic, icc.lineno, yer, c=icc, ib=ib)
+
+    def dongu_baglari(c, kaps, ilk=None):
+        """Çağrıyı kapsayan `for X in <sabit dizi>` döngüleri → bağ listesi (kartezyen)."""
+        baglar = [{}]
+        ilk = ilk or {}
+        for f in donguler.get(c, ()):
+            it = f.iter
+            if isinstance(it, ast.Name):
+                for k in kaps:
+                    o = [x for x in k.olay.get(it.id, []) if x[2] == "=" and x[0] <= f.lineno]
+                    if o:
+                        it = o[-1][1]
+                        break
+            if not isinstance(it, (ast.List, ast.Tuple)):
+                continue
+            yeni = []
+            for b in baglar:
+                for el in it.elts:
+                    nb = dict(b)
+                    hedefler = f.target.elts if isinstance(f.target, ast.Tuple) else [f.target]
+                    degerler = el.elts if isinstance(f.target, ast.Tuple) and isinstance(el, ast.Tuple) \
+                        and len(el.elts) == len(hedefler) else ([el] if not isinstance(f.target, ast.Tuple) else None)
+                    if degerler is None:
+                        continue
+                    for h, v in zip(hedefler, degerler):
+                        if isinstance(h, ast.Name):
+                            nb[h.id] = _bag_degeri(v, kaps, f.lineno, dict(ilk, **b))
+                    yeni.append(nb)
+            baglar = yeni or baglar
+        return baglar
+
+    ic_cagrilar = {id(c) for _p, _v, ic in sarmal.values() for _e, _k, c in ic}
+    for c in cagrilar:
+        yer = "%s:%d" % (goreli, c.lineno)
+        if tur(c) and id(c) not in ic_cagrilar:
+            e, kabuk = argv_ifadesi(c)
+            if e is None:
+                olc.append((yer, "argv argümanı yok"))
+                continue
+            for b in dongu_baglari(c, kapsamlar(c)):
+                degerlendir(e, kabuk, b, kapsamlar(c), c.lineno, yer, c=c, ib={})
+        elif isinstance(c.func, ast.Name) and c.func.id in sarmal and id(c) not in ic_cagrilar:
+            for b in dongu_baglari(c, kapsamlar(c)):
+                sarmal_coz(c.func.id, c, kapsamlar(c), yer, dis_bag=b)
+    # 📌 DOSYALAR ARASI GÜVENLİK: sarmalayıcı, parametrelerinin HER değeri (DIZI)
+    #    için ihlalsiz ve ölçülebilirse başka dosyadan çağrılması sorun değildir.
+    guvenli = []
+    _kayit = (list(ihlal), list(olc), list(gitler), say)
+    for ad, (params, var, _ic) in sarmal.items():
+        del ihlal[:], olc[:]
+        bos = {p_: [DIZI] for p_ in params}
+        if var:
+            bos[var] = [DIZI]
+        sahte = ast.Call(func=ast.Name(id=ad, ctx=ast.Load()), args=[], keywords=[])
+        ast.copy_location(sahte, agac.body[0] if agac.body else agac)
+        sarmal_coz(ad, sahte, [modul_k], "-", tohum=bos)
+        if not ihlal and not olc:
+            guvenli.append(ad)
+    _hed = dict(hedefler)
+    ihlal[:], olc[:], gitler[:] = _kayit[0], _kayit[1], _kayit[2]
+    return (ihlal, olc, _kayit[3], gitler, sorted(a for a in sarmal if a not in guvenli),
+            {k: v for k, v in _hed.items() if k in set(ihlal)})
+
+
+def _bag_degeri(x, kaps, satir, bag):
+    """Çağrı argümanı → bağ değeri (öğe listesi). Sabit metin TEK öğedir."""
+    if isinstance(x, ast.Constant) and isinstance(x.value, str):
+        return [x.value]
+    if isinstance(x, (ast.List, ast.Tuple, ast.BinOp, ast.Starred)) or \
+            (isinstance(x, ast.Call) and isinstance(x.func, ast.Name) and x.func.id in ("list", "tuple")):
+        return _guvenli_coz(x, bag, kaps, satir, 0)
+    if isinstance(x, ast.Name) and x.id in bag:
+        return list(bag[x.id])
+    v = oge(x, bag, kaps, satir, 0)
+    if v is BILINMEZ and isinstance(x, ast.Name):
+        r = _guvenli_coz(x, bag, kaps, satir, 0)
+        if r != [DIZI]:
+            return r
+    return [v]
+
+
+def main(argv):
+    kok = argv[argv.index("--kok") + 1] if "--kok" in argv else \
+        os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+    dizin = argv[argv.index("--dizin") + 1] if "--dizin" in argv else "arac"
+    try:
+        siniflar = kabuk_siniflari(kok)
+    except Exception as e:                                   # noqa: BLE001
+        print("🔴 ÖLÇÜLEMEDİ — kabuk_nobetci sınıf adları okunamadı: %s" % e)
+        return 2
+    add_adi = "ADD-HEPSI" if "ADD-HEPSI" in siniflar else None
+    if add_adi is None:
+        print("🔴 ÖLÇÜLEMEDİ — kabuk_nobetci DALLAR'da ADD-HEPSI yok: %s" % siniflar)
+        return 2
+    dosyalar = sorted(glob.glob(os.path.join(kok, dizin, "**", "*.py"), recursive=True))
+    ihlal, olc, say, tarandi, gitler, sarmallar, hedefler = [], [], 0, 0, [], {}, {}
+    for y in dosyalar:
+        g = os.path.relpath(y, kok).replace(os.sep, "/")
+        try:
+            i, o, s, gt, sr, hd = tara_dosya(y, add_adi, g)
+        except (SyntaxError, UnicodeDecodeError, ValueError) as e:
+            olc.append((g, "AYRIŞTIRILAMADI: %s" % str(e)[:100]))
+            continue
+        tarandi += 1
+        ihlal += i
+        olc += o
+        say += s
+        gitler += gt
+        hedefler.update(hd)
+        mod = os.path.splitext(os.path.basename(y))[0]
+        for ad in sr:
+            sarmallar[(mod, ad)] = g
+    # 🔴 DOSYALAR ARASI SARMALAYICI — bu araç onu ÇÖZMEZ; sessiz kalmasın diye
+    #    başka dosyadan İTHAL EDİLEN her sarmalayıcı çağrısı ÖLÇÜLEMEDİ'ye düşer.
+    for y in dosyalar:
+        g = os.path.relpath(y, kok).replace(os.sep, "/")
+        try:
+            agac = ast.parse(io.open(y, encoding="utf-8").read())
+        except Exception:                                    # noqa: BLE001
+            continue
+        ithal = {}
+        for n in ast.walk(agac):
+            if isinstance(n, ast.ImportFrom) and n.module:
+                for a in n.names:
+                    if (n.module.split(".")[-1], a.name) in sarmallar:
+                        ithal[a.asname or a.name] = (n.module, a.name)
+            elif isinstance(n, ast.Import):
+                for a in n.names:
+                    ithal.setdefault("__mod__" + (a.asname or a.name), (a.name, None))
+        for n in ast.walk(agac):
+            if not isinstance(n, ast.Call):
+                continue
+            hedef = None
+            if isinstance(n.func, ast.Name) and n.func.id in ithal and ithal[n.func.id][1]:
+                hedef = ithal[n.func.id]
+            elif isinstance(n.func, ast.Attribute) and isinstance(n.func.value, ast.Name) \
+                    and ("__mod__" + n.func.value.id) in ithal \
+                    and (ithal["__mod__" + n.func.value.id][0].split(".")[-1], n.func.attr) in sarmallar:
+                hedef = (ithal["__mod__" + n.func.value.id][0], n.func.attr)
+            if hedef:
+                olc.append(("%s:%d" % (g, n.lineno), "DOSYALAR ARASI sarmalayıcı %s.%s (%s) — "
+                            "çözülmedi" % (hedef[0], hedef[1], sarmallar[(hedef[0].split(".")[-1], hedef[1])])))
+    print("ARGV-GIT DENETİMİ · kök %s · %s/**/*.py: %d dosya, %d ayrıştırıldı · "
+          "%d çağrı çözüldü" % (kok, dizin, len(dosyalar), tarandi, say))
+    print("  sınıflar: %s (kabuk_nobetci DALLAR: %s) · COMMIT-HEPSI · COMMIT-PATHSPECSIZ · "
+          "STASH · PUSH-ZORLA" % (add_adi, ", ".join(siniflar)))
+    kovalar = {}
+    for yer, s, a in ihlal:
+        kovalar.setdefault(s, []).append((yer, a))
+    for s in (add_adi, "COMMIT-HEPSI", "COMMIT-PATHSPECSIZ", "STASH", "PUSH-ZORLA"):
+        k = kovalar.get(s, [])
+        print("  %-20s %d" % (s, len(k)))
+        for yer, a in k:
+            print("     🔴 %-40s %s" % (yer, a[:110]))
+    print("  git çağrısı çözüldü  %d%s" % (len(gitler), "" if "--ayrinti" in argv else "  (liste: --ayrinti)"))
+    if "--ayrinti" in argv:
+        for yer, a in gitler:
+            print("     · %-40s %s" % (yer, a))
+        print("  sarmalayıcılar       %d: %s" % (len(sarmallar), " ".join(
+            "%s:%s" % (v, k[1]) for k, v in sorted(sarmallar.items(), key=lambda kv: kv[1]))))
+    print("  ÖLÇÜLEMEDİ           %d" % len(olc))
+    for yer, sb in olc:
+        print("     ? %-40s %s" % (yer, sb[:120]))
+    if "--cwd-sinifla" in argv:
+        print("\nHEDEF DEPO SINIFLAMASI (--cwd-sinifla) — ÖLÇÜLEMEDİ ⇒ GERÇEK varsayılır")
+        print("  %-52s %-19s %-11s %s" % ("dosya:satır", "sınıf", "hedef", "çözüm"))
+        say_k = {"GEÇİCİ": 0, "GERÇEK": 0, "ÖLÇÜLEMEDİ": 0}
+        riskli = []
+        for yer, s, a in sorted(ihlal, key=lambda x: (x[0].split(":")[0], int(x[0].split(":")[-1])
+                                                    if x[0].split(":")[-1].isdigit() else 0)):
+            h, ac = hedefler.get((yer, s, a), ("ÖLÇÜLEMEDİ", "hedef hesaplanmadı"))
+            say_k[h] += 1
+            print("  %-52s %-19s %-11s %s" % (yer, s, h, ac[:150]))
+            if h != "GEÇİCİ":
+                riskli.append((yer, s, a, h, ac))
+        print("  TOPLAM: GEÇİCİ %d · GERÇEK %d · ÖLÇÜLEMEDİ %d" % (
+            say_k["GEÇİCİ"], say_k["GERÇEK"], say_k["ÖLÇÜLEMEDİ"]))
+        if riskli:
+            print("\n  🔴 GERÇEK depoya dokunan (ya da öyle varsayılan) — koşturulursa ne yapar:")
+            for yer, s, a, h, ac in riskli:
+                print("     %-50s %-11s %s" % (yer, h, a[:110]))
+            print("SONUÇ: GERÇEK/ÖLÇÜLEMEDİ hedefli ihlal %d — çıkış 1" % len(riskli))
+            return 1
+        if olc:
+            print("SONUÇ: ihlallerin hepsi GEÇİCİ depoda; argv ÖLÇÜLEMEDİ %d — çıkış 2" % len(olc))
+            return 2
+        print("SONUÇ: %d ihlalin HEPSİ GEÇİCİ depoda — çıkış 0" % len(ihlal))
+        return 0
+    if ihlal:
+        print("SONUÇ: İHLAL %d — çıkış 1" % len(ihlal))
+        return 1
+    if olc:
+        print("SONUÇ: ÖLÇÜLEMEDİ %d — çıkış 2" % len(olc))
+        return 2
+    print("SONUÇ: temiz")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
