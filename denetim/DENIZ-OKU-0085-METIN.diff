 { t:"1423-05-01", k:"savas", etiket:["savas","antlasma","konu-askeri","konu-diplomasi"], b:"Turahan Bey'in Mora seferi ve Hexamilion Suru'nun yıkılışı", gun:"1423", yer:"Mora yarımadası – Korint Berzahı", yer_id:"Mora (Tripoliçe)", kisiler:"II. Murad, Turahan Bey", d:"Bizans'ın rakip taht iddiacısı Mustafa Çelebi'yi desteklemesi üzerine II. Murad, Turahan Bey'i Mora üzerine gönderdi. Turahan Bey, Korint Berzahı'nı baştan başa kapatan Hexamilion duvarını yıkıp yarımadaya girdi ve büyük tahribata yol açtı. Barış, surun bir daha inşa edilmemesi ve yıllık vergi ödenmesi şartıyla sağlandı; Mora despotluğu böylece askerî olarak savunmasız bırakılarak 1460'taki nihaî fethin zemini otuz yedi yıl önceden hazırlandı.", kaynak:"mora", duygu:["⚔️","😔"] },
 { t:"1446-05-05", k:"isyan", etiket:["isyan","siyaset","darbe-askeri","konu-siyasi","konu-isyan","konu-darbe"], b:"Buçuktepe Vak'ası — ilk yeniçeri ayaklanması ve II. Murad'ın tahta dönüşü", gun:"5 Mayıs 1446", yer:"Edirne", yer_id:"Edirne", kisiler:"II. Murad, II. Mehmed, Çandarlı Halil Paşa", d:"Edirne'de patlak veren ve tarihin bildiği ilk yeniçeri ayaklanması olan Buçuktepe Vak'ası, ulûfelerinin yarım akçe artırılması talebiyle başladı ve genç II. Mehmed'in tahttan indirilmesiyle sonuçlandı. II. Murad 8 Safer 850'de Manisa'dan acele yola çıkarak ikinci saltanatına başladı. Olay, kapıkulu ocağının artık taht üzerinde söz sahibi bir güç hâline geldiğini gösteren ilk işaret oldu ve Fatih'in yeniçeriye karşı ömür boyu sürecek temkinini şekillendirdi.", kaynak:"bucuktepe-vakasi", duygu:["✊"] },
 { t:"1451-02-18", k:"siyaset", etiket:["siyaset","konu-siyasi","konu-kisiler","konu-hanedan"], b:"II. Murad'ın vefatı ve II. Mehmed'in ikinci cülûsu", gun:"3 Şubat 1451 (vefat) – 18 Şubat 1451 (cülûs)", yer:"Edirne", yer_id:"Edirne", kisiler:"II. Murad, II. Mehmed (Fatih), Çandarlı Halil Paşa", d:"Oğlunun düğününün ardından hastalanan II. Murad, 1 Muharrem 855'te (3 Şubat 1451) Edirne'de vefat etti. On dokuz yaşındaki II. Mehmed, 16 Muharrem 855'te (18 Şubat 1451) ikinci defa Osmanlı tahtına çıktı — bu kez kalıcı olarak. Beş yıl önce Buçuktepe'de tahtından indirilen genç hükümdarın dönüşü, iki yıl sonra İstanbul'un fethiyle taçlanacak ve Osmanlı Beyliği'ni bir dünya imparatorluğuna dönüştürecek saltanatın başlangıcıdır.", kaynak:"mehmed-ii", duygu:["🏛","😔"], vefat_id:"murad2" },
-{ t:"1454-07-14", k:"savas", etiket:["savas","konu-askeri"], b:"Osmanlı-Kırım müşterek kuvvetlerinin ilk Kefe muhasarası", gun:"14 Temmuz 1454", yer:"Kefe (Feodosya), Kırım", yer_id:"Kefe", kisiler:"Hacı Giray, Fâtih Sultan Mehmed", d:"Haziran 1454'te Fâtih Sultan Mehmed ile anlaşan Kırım Hanı Hacı Giray, 7000 atlısıyla Kefe'yi karadan kuşattı; kırk-elli parçalık bir Osmanlı donanması da açıklarda mevzilendi. Cenevizli Kefe, kuşatmayı haraç ödeyerek kaldırttı ve kesin fetih yirmi bir yıl sonraya, 1475'e kaldı. Bu ilk ortak harekât, Osmanlı-Kırım askerî iş birliğinin ileride Kefe'nin kesin fethinde tekrarlanacak ilk örneğiydi.", kaynak:"haci-giray-i", duygu:["⚔️"] },
+{ t:"1454-07-14", k:"savas", etiket:["savas","konu-askeri"], b:"Osmanlı-Kırım müşterek kuvvetlerinin ilk Kefe muhasarası", gun:"14 Temmuz 1454", yer:"Kefe (Feodosya), Kırım", yer_id:"Kefe", kisiler:"Hacı Giray, Fâtih Sultan Mehmed", d:"Haziran 1454'te Fâtih Sultan Mehmed ile anlaşan Kırım Hanı Hacı Giray, 7000 atlısıyla Kefe'yi karadan kuşattı; elli-altmış kadırgalık bir Osmanlı donanması da açıklarda mevzilendi. Cenevizli Kefe, kuşatmayı haraç ödeyerek kaldırttı ve kesin fetih yirmi bir yıl sonraya, 1475'e kaldı. Bu ilk ortak harekât, Osmanlı-Kırım askerî iş birliğinin ileride Kefe'nin kesin fethinde tekrarlanacak ilk örneğiydi.", kaynak:"haci-giray-i", duygu:["⚔️"] },
 { t:"1455-01-01", k:"fetih", etiket:["toprak-kazanc","konu-askeri"], b:"Kuzey Ege adalarının alınışı: Bozcaada, İmroz ve Taşoz", gun:"1455", yer:"Bozcaada, İmroz (Gökçeada), Taşoz", yer_id:"Bozcaada", kisiler:"Fatih Sultan Mehmed, Gattilusio ailesi", d:"İstanbul'un fethinden hemen sonra Fatih Sultan Mehmed, yeni başkentin deniz yolunu güvenceye almak için Çanakkale Boğazı'nın Ege ağzındaki adalara yöneldi; Bozcaada ile İmroz Bizans'tan, Taşoz ise Ceneviz asıllı Gattilusio ailesinden alındı. Boğazın iki yakasını kilitleyen bu adalar, bundan sonra İstanbul'un iaşe ve savunma hattının ilk halkası oldu. Papalık ve Venedik donanmalarının müdahaleleriyle hâkimiyet bir süre gidip geldi ve ancak 1459'da kesinleşti.", kaynak:"mehmed-ii", duygu:["🎉"] },
 { t:"1455-06-01", k:"fetih", etiket:["toprak-kazanc","savas","konu-askeri"], b:"Kosova'nın fethi: Priştine ve Yenipazar'ın alınması", gun:"1455", yer:"Priştine, Yenipazar (Novi Pazar), Kosova", yer_id:"Priştine", kisiler:"Fatih Sultan Mehmed, Brankoviç hânedanı", d:"Sırp Despotluğu üzerine yürüyen Osmanlı ordusu, Kosova ovasındaki Priştine ile Raşka bölgesinin merkezi Yenipazar'ı ele geçirdi; aynı harekâtta gümüş madenleriyle ünlü Novoberda da alındı. Böylece Sırbistan'ın güney yarısı doğrudan Osmanlı idaresine bağlandı ve Semendire'deki despotluk merkezî topraklarından koparıldı. Bu fetih, dört yıl sonra Sırbistan'ın tamamen ilhakına giden yolun belirleyici adımıydı.", kaynak:"sirbistan", duygu:["🎉"] },
 { t:"1456-01-24", k:"fetih", etiket:["toprak-kazanc","konu-askeri"], b:"Enez'in ve Semadirek'in fethi — Batı Trakya kıyısının tamamlanması", gun:"Ocak 1456", yer:"Enez (Meriç ağzı), Semadirek", yer_id:"Enez", kisiler:"Fatih Sultan Mehmed, Dorino Gattilusio", d:"Meriç nehrinin denize döküldüğü yerdeki Enez, seksen yıldır burayı elinde tutan Ceneviz asıllı Gattilusio ailesinden alındı; buraya bağlı Semadirek adası da aynı harekâtta ele geçirildi. Enez'in düşmesiyle Batı Trakya kıyı şeridi Selanik'ten Gelibolu'ya kadar kesintisiz Osmanlı toprağı hâline geldi. Gattilusio ailesinin elinde yalnız Midilli kaldı; o da altı yıl sonra alınacaktı.", kaynak:"mehmed-ii", duygu:["🎉"] },
